<idea-plugin>
    <id>dev.grav.lang</id>
    <name>Grav</name>
    <vendor email="" url="https://github.com/venomous-maker">Grav</vendor>

    <description><![CDATA[
        Language support for <b>Grav</b> (.grav) — a statically typed,
        TypeScript-inspired language that compiles to C.
        Syntax highlighting, and through the bundled Grav language server (needs
        Node.js): go to definition, find usages, rename, hover, completion,
        parameter info, inlay hints, the file structure and compiler diagnostics.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
            name="Grav file"
            implementationClass="dev.grav.GravFileType"
            fieldName="INSTANCE"
            language="Grav"
            extensions="grav"/>
        <lang.syntaxHighlighterFactory
            language="Grav"
            implementationClass="dev.grav.GravSyntaxHighlighterFactory"/>
        <lang.commenter
            language="Grav"
            implementationClass="dev.grav.GravCommenter"/>
        <!-- Navigation / refactoring via the bundled Grav language server (IDEs with
             the LSP API; needs Node.js). -->
        <platform.lsp.serverSupportProvider
            implementation="dev.grav.GravLspServerSupportProvider"/>
        <notificationGroup id="Grav" displayType="BALLOON"/>
    </extensions>
</idea-plugin>
