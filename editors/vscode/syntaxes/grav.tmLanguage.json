            "2": {
              "name": "string.quoted.double.import.grav"
            },
            "3": {
              "name": "keyword.control.as.grav"
            },
            "4": {
              "name": "entity.name.namespace.grav"
            }
          }
        },
        {
          "comment": "use a.b.*, use a::b::C as D, use a.b as x",
          "begin": "^\\s*(use)\\b",
          "end": "$|;",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.import.use.grav"
            }
          },
          "patterns": [
            {
              "match": "\\bas\\b\\s*([A-Za-z_][A-Za-z0-9_]*)",
