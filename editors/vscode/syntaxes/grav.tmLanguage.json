{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Grav",
  "scopeName": "source.grav",
  "fileTypes": [
    "grav"
  ],
  "comment": "Generated by editors/grammar/build.py \u2014 edit that file, not this one.",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#inline-c"
    },
    {
      "include": "#imports"
    },
    {
      "include": "#decorators"
    },
    {
      "include": "#expression"
    }
