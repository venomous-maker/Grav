                "0": {
                  "name": "keyword.control.as.grav"
                },
                "1": {
                  "name": "entity.name.type.alias.grav"
                }
              }
            },
            {
              "match": "\\*",
              "name": "keyword.operator.wildcard.grav"
            },
            {
              "match": "::|\\.",
              "name": "punctuation.separator.namespace.grav"
            },
            {
              "match": "[A-Za-z_][A-Za-z0-9_]*(?=\\s*(?:\\.|::))",
              "name": "entity.name.namespace.grav"
            },
            {
              "match": "[A-Za-z_][A-Za-z0-9_]*",
              "name": "entity.name.type.grav"
            }
          ]
        }
      ]
    },
    "labels": {
