  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.grav",
          "begin": "//",
          "end": "$",
          "patterns": [
            {
              "match": "\\b(TODO|FIXME|NOTE|XXX|HACK)\\b",
              "name": "keyword.other.todo.grav"
            }
          ]
        },
        {
          "name": "comment.block.grav",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "inline-c": {
      "comment": "Inline C escape hatch %{ ... %}, highlighted with the C grammar.",
      "name": "meta.embedded.block.c.grav",
      "begin": "%\\{",
      "end": "%\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.grav"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.grav"
        }
      },
      "patterns": [
        {
          "include": "source.c"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "comment": "r\"\"\"...\"\"\"  and r\"...\": raw, nothing inside is special",
          "name": "string.quoted.raw.triple.grav",
          "begin": "\\br\"\"\"",
          "end": "\"\"\""
        },
        {
          "name": "string.quoted.raw.grav",
          "begin": "\\br\"",
          "end": "\""
        },
        {
          "comment": "\"\"\"...\"\"\": multi-line, with escapes and ${...}",
          "name": "string.quoted.triple.grav",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "include": "#string-content"
            }
          ]
        },
        {
          "name": "string.quoted.double.grav",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "include": "#string-content"
            }
          ]
        },
        {
          "comment": "'a', '\\n', '\\u{1F600}': a character's code point",
          "name": "constant.character.grav",
          "match": "'(?:\\\\(?:[ntr0\\\\\\\"'$e]|x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\})|[^'\\\\])'"
        }
      ]
    },
    "string-content": {
      "patterns": [
        {
          "match": "\\\\(?:[ntr0\\\\\\\"'$e]|x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\})",
          "name": "constant.character.escape.grav"
        },
        {
          "name": "meta.interpolation.grav",
          "begin": "\\$\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.begin.grav"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.end.grav"
            }
          },
          "contentName": "source.grav.embedded",
          "patterns": [
            {
              "comment": "${x:.2f} \u2014 a format spec after the last ':'",
              "match": "(?<!:)(:)([<>^]?\\+?0?\\d*(?:\\.\\d+)?[dfexXobs%]?)(?=\\})",
              "captures": {
                "1": {
                  "name": "punctuation.separator.format.grav"
                },
                "2": {
                  "name": "constant.other.format-spec.grav"
                }
              }
            },
            {
              "include": "#expression"
            }
          ]
        }
      ]
    },
    "imports": {
