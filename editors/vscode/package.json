{
  "name": "grav-lang",
  "displayName": "Grav Language",
  "description": "Grav language support: syntax highlighting (format specs, labels, named arguments), go to definition across imports, the standard library and packages, completion with snippets and keyword docs, signature help, hover explanations for keywords and types, the types of local variables (hover and inlay hints), outline, rename, grav fmt formatting, grav check diagnostics, and run/test/package commands.",
  "version": "1.10.0",
  "publisher": "grav",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Formatters",
    "Linters"
  ],
  "keywords": [
    "grav",
    "gravc"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/venomous-maker/grav"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:grav",
    "workspaceContains:**/grav.toml"
  ],
  "contributes": {
    "languages": [
      {
        "id": "grav",
        "aliases": [
          "Grav",
          "grav"
        ],
        "extensions": [
          ".grav"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "grav",
        "scopeName": "source.grav",
        "path": "./syntaxes/grav.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.c.grav": "c"
        }
      }
    ],
    "commands": [
      {
        "command": "grav.run",
        "title": "Grav: Run Current File",
        "category": "Grav"
      },
      {
        "command": "grav.build",
        "title": "Grav: Build Current File",
        "category": "Grav"
      },
      {
        "command": "grav.test",
        "title": "Grav: Run Tests in Current File",
        "category": "Grav"
      },
      {
        "command": "grav.check",
        "title": "Grav: Check Current File",
        "category": "Grav"
      },
      {
        "command": "grav.fmt",
        "title": "Grav: Format Current File",
        "category": "Grav"
      },
      {
        "command": "grav.emitC",
        "title": "Grav: Show Generated C for Current File",
        "category": "Grav"
      },
      {
        "command": "grav.runProject",
        "title": "Grav: Run Project (grav.toml)",
        "category": "Grav"
      },
      {
        "command": "grav.testProject",
        "title": "Grav: Test Project (grav.toml)",
        "category": "Grav"
      },
      {
        "command": "grav.newProject",
        "title": "Grav: New Project",
        "category": "Grav"
      },
      {
        "command": "grav.addPackage",
        "title": "Grav: Add Package",
        "category": "Grav"
      },
      {
        "command": "grav.installPackages",
        "title": "Grav: Install Packages",
        "category": "Grav"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "grav.run",
          "when": "resourceLangId == grav",
          "group": "navigation@1"
        },
        {
          "command": "grav.test",
          "when": "resourceLangId == grav",
          "group": "navigation@2"
        },
        {
          "command": "grav.check",
          "when": "resourceLangId == grav",
          "group": "navigation@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "grav.run",
        "key": "ctrl+alt+r",
        "when": "resourceLangId == grav"
      },
      {
        "command": "grav.test",
        "key": "ctrl+alt+t",
        "when": "resourceLangId == grav"
      }
    ],
    "configuration": {
      "title": "Grav",
      "properties": {
        "grav.compilerPath": {
          "type": "string",
          "default": "grav",
          "description": "Path to the grav compiler binary."
        },
        "grav.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Run `grav check` when a file is opened or saved and show its diagnostics."
        }
      }
    },
    "configurationDefaults": {
      "[grav]": {
        "editor.defaultFormatter": "grav.grav-lang",
        "editor.formatOnSave": false,
        "editor.tabSize": 4,
        "editor.insertSpaces": true
      }
    }
  }
}
