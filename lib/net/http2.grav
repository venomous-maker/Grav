// lib/net/http2.grav — an HTTP/2 client (RFC 9113): one connection, many
// requests at once over it, headers compressed with HPACK (RFC 7541).
//
//   let h2 = Http2Client.open("https://example.com")       // TLS, agreeing on "h2" by ALPN
//   let res = h2.get("/api/items")
//   print("${res.status} ${res.header("content-type")} ${res.text()}")
//   let all = h2.requestAll([Http2Request.get("/a"), Http2Request.get("/b")])   // multiplexed
//   h2.close()
//
// "http://" speaks HTTP/2 in the clear with prior knowledge (h2c). Flow
// control is kept both ways, PINGs are answered, a server's GOAWAY or
// RST_STREAM fails what it covers with a NetError. A client is for one thread.
import "../core/exception.grav"
import "../text/string.grav"
import "../text/strbuf.grav"
import "../text/convert.grav"
import "../collections/array.grav"
import "../collections/hashmap.grav"
import "../data/bytes.grav"
import "tcp.grav"
import "tls.grav"

namespace std.net {

    %{
    #include <stdint.h>
    #include <stdlib.h>
    #include <string.h>
    #include <pthread.h>
    // HPACK-DATA BEGIN
    /* HPACK (RFC 7541): the static table and the Huffman code (tools/gen-hpack.py). */
