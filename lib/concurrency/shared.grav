// lib/concurrency/shared.grav — state shared between threads without one big
// lock: ThreadLocal<T> (each thread its own value, no locking to read or
// write it) and ConcurrentMap<K, V> (a map split into shards, each with its
// own lock, so threads working on different keys seldom wait for each other)
// and LruCache<K, V> (a bounded cache that forgets the least recently used
// entry first, optionally after a time to live).
//
//   let buffers = new ThreadLocal<StringBuilder>(fn() -> StringBuilder { return new StringBuilder() })
//   buffers.get().append("only this thread's")
//
//   let hits = new ConcurrentMap<string, long>()
//   hits.merge("/home", 1, fn(a: long, b: long) -> long { return a + b })
//
//   let tokens = new LruCache<long, Token>(10000, 60000)     // 10,000 entries, 60 s each
//   tokens.put(id, t); let hit = tokens.getOr(id, null)
import "../core/exception.grav"
import "../collections/array.grav"
import "../collections/hashmap.grav"
import "../sys/time.grav"
import "async.grav"

namespace std.concurrency {

    %{
    #include <pthread.h>
    #include <stdint.h>
    #include <stdlib.h>
    #include <string.h>
    /* Each thread's values, one slot per ThreadLocal (by its id), in that
       thread's own memory: reading or writing one is an array access, with
       no lock. A thread's slots are given back when it exits. */
    static __thread GravAny* grav_tl_vals = 0;
    static __thread int grav_tl_cap = 0;
    static long long grav_tl_ids = 0;
    static pthread_key_t grav_tl_key;
    static pthread_once_t grav_tl_once = PTHREAD_ONCE_INIT;
    static void grav_tl_exit(void* p) {
        GravAny* v = (GravAny*)p;
        int n = grav_tl_cap;
        for (int i = 0; i < n; i++) grav_any_release(v[i]);
        free(v);
        grav_tl_vals = 0;
        grav_tl_cap = 0;
    }
    static void grav_tl_setup(void) { pthread_key_create(&grav_tl_key, grav_tl_exit); }
    static int grav_tl_new_id(void) { return (int)__atomic_fetch_add(&grav_tl_ids, 1, __ATOMIC_SEQ_CST); }
    /* This thread's value for ThreadLocal `id` (borrowed; tag 0, null, when unset). */
    static GravAny grav_tl_get(int id) {
        if (id < grav_tl_cap) return grav_tl_vals[id];
        GravAny none; memset(&none, 0, sizeof none);
        return none;
    }
    static void grav_tl_put(int id, GravAny v) {
        if (id >= grav_tl_cap) {
            int cap = grav_tl_cap ? grav_tl_cap : 8;
            while (cap <= id) cap *= 2;
            GravAny* nv = (GravAny*)realloc(grav_tl_vals, sizeof(GravAny) * (size_t)cap);
            if (!nv) abort();
            memset(nv + grav_tl_cap, 0, sizeof(GravAny) * (size_t)(cap - grav_tl_cap));
            if (!grav_tl_vals) { pthread_once(&grav_tl_once, grav_tl_setup); }
            grav_tl_vals = nv;
            grav_tl_cap = cap;
            pthread_setspecific(grav_tl_key, nv);
        }
        GravAny old = grav_tl_vals[id];
        grav_tl_vals[id] = grav_any_retain(v);
        grav_any_release(old);
    }
    %}

    // A value per thread: the first get() on a thread makes it with `init`.
    // Each thread keeps its values in its own memory, so get and set take no
    // lock; a thread's values are let go when it exits.
    class ThreadLocal<T> {
        private init: fn() -> T
        private id: int
        constructor(init: fn() -> T) { self.init = init; self.id = %{ grav_tl_new_id() %} as int; }
        // This thread's value (made by `init` the first time).
        fn get() -> T {
            let id = self.id;
            let a = %{ grav_tl_get(id) %} as any;
            if (a != null) { return a as T; }
            let v = self.init();
            self.set(v);
            return v;
        }
        // Sets this thread's value.
        fn set(v: T) {
            let id = self.id;
            let a: any = v;
            %{ grav_tl_put(id, a); %};
        }
        // Whether this thread has a value yet.
        fn has() -> bool { let id = self.id; let a = %{ grav_tl_get(id) %} as any; return a != null; }
        // Forgets this thread's value (the next get() makes a new one).
        fn remove() {
            let id = self.id;
            let none: any = null;
            %{ grav_tl_put(id, none); %};
        }
    }

    // A thread-safe map in 16 shards, each a HashMap with its own lock: threads
    // on different keys seldom wait for each other, and nothing ever locks the
    // whole map but size(), keys() and clear().
    class ConcurrentMap<K, V> {
        private maps: Array<HashMap<K, V>> = new Array<HashMap<K, V>>()
        private locks: Array<Mutex> = new Array<Mutex>()
        constructor() {
            for (i in 0..16) { self.maps.push(new HashMap<K, V>()); self.locks.push(new Mutex()); }
        }
        private fn shard(key: K) -> int { let h = hashOf(key); return ((h ^ (h >> 17)) & 15) as int; }
        fn get(key: K) -> V {
            let s = self.shard(key);
            self.locks[s].lock();
            let v = self.maps[s].get(key);
            self.locks[s].unlock();
            return v;
        }
        // The value for `key`, or `fallback`.
        fn getOr(key: K, fallback: V) -> V {
            let s = self.shard(key);
            self.locks[s].lock();
            let v = self.maps[s].getOr(key, fallback);
            self.locks[s].unlock();
            return v;
        }
        fn put(key: K, value: V) {
            let s = self.shard(key);
            self.locks[s].lock();
            self.maps[s].put(key, value);
            self.locks[s].unlock();
        }
        fn containsKey(key: K) -> bool {
            let s = self.shard(key);
            self.locks[s].lock();
            let has = self.maps[s].containsKey(key);
            self.locks[s].unlock();
            return has;
        }
        // Removes `key`; whether it was there.
        fn remove(key: K) -> bool {
            let s = self.shard(key);
            self.locks[s].lock();
            let had = self.maps[s].containsKey(key);
            if (had) { self.maps[s].remove(key); }
            self.locks[s].unlock();
            return had;
        }
        // The value for `key`, made by `make` (once, under the key's lock) when missing.
        fn computeIfAbsent(key: K, make: fn(K) -> V) -> V {
            let s = self.shard(key);
            self.locks[s].lock();
            let m = self.maps[s];
            if (!m.containsKey(key)) { m.put(key, make(key)); }
            let v = m.get(key);
            self.locks[s].unlock();
            return v;
        }
        // Puts `value`, or combines it with the value there (`combine(old, value)`); the result.
        fn merge(key: K, value: V, combine: fn(V, V) -> V) -> V {
            let s = self.shard(key);
            self.locks[s].lock();
            let m = self.maps[s];
            let v = m.containsKey(key) ? combine(m.get(key), value) : value;
            m.put(key, v);
            self.locks[s].unlock();
            return v;
        }
        fn size() -> int {
            let n = 0;
            for (i in 0..16) { self.locks[i].lock(); n += self.maps[i].size(); self.locks[i].unlock(); }
            return n;
        }
        fn isEmpty() -> bool { return self.size() == 0; }
        // The keys at this moment (a copy).
        fn keys() -> Array<K> {
            let out = new Array<K>();
            for (i in 0..16) { self.locks[i].lock(); for (k in self.maps[i].keys()) { out.push(k); } self.locks[i].unlock(); }
            return out;
        }
        fn clear() { for (i in 0..16) { self.locks[i].lock(); self.maps[i].clear(); self.locks[i].unlock(); } }
    }

    %{
    #include <stdlib.h>
    #include <string.h>
    /* An LruCache shard's bookkeeping: entry i's neighbours in recency order
       (most recent first) and its expiry, in arrays that grow by doubling. */
    typedef struct { int* prev; int* next; long long* exp; int cap, head, tail; } GravLru;
    static GravLru* grav_lru_new(void) {
        GravLru* l = (GravLru*)calloc(1, sizeof(GravLru));
        if (!l) abort();
        l->head = l->tail = -1;
        return l;
    }
    static void grav_lru_free(GravLru* l) { if (l) { free(l->prev); free(l->next); free(l->exp); free(l); } }
    static void grav_lru_ensure(GravLru* l, int n) {
        if (n <= l->cap) return;
        int c = l->cap < 16 ? 16 : l->cap * 2;
        while (c < n) c *= 2;
        l->prev = (int*)realloc(l->prev, sizeof(int) * (size_t)c);
        l->next = (int*)realloc(l->next, sizeof(int) * (size_t)c);
        l->exp = (long long*)realloc(l->exp, sizeof(long long) * (size_t)c);
        if (!l->prev || !l->next || !l->exp) abort();
        l->cap = c;
    }
    static void grav_lru_unlink(GravLru* l, int i) {
        int p = l->prev[i], n = l->next[i];
        if (p >= 0) l->next[p] = n; else l->head = n;
        if (n >= 0) l->prev[n] = p; else l->tail = p;
    }
    static void grav_lru_front(GravLru* l, int i) {
        l->prev[i] = -1; l->next[i] = l->head;
        if (l->head >= 0) l->prev[l->head] = i;
        l->head = i;
        if (l->tail < 0) l->tail = i;
    }
    static void grav_lru_touch(GravLru* l, int i) { if (l->head != i) { grav_lru_unlink(l, i); grav_lru_front(l, i); } }
    /* Entry `last` moves into place i (i was unlinked already). */
    static void grav_lru_move(GravLru* l, int last, int i) {
        int p = l->prev[last], n = l->next[last];
        l->prev[i] = p; l->next[i] = n; l->exp[i] = l->exp[last];
        if (p >= 0) l->next[p] = i; else l->head = i;
        if (n >= 0) l->prev[n] = i; else l->tail = i;
    }
    %}

    // One shard of an LruCache: keys and values in parallel arrays, kept dense
    // (a removed entry's place is taken by the last one, so nothing removed
    // stays referenced); the recency links and expiry times in C (GravLru). Not
    // thread-safe on its own: LruCache holds its lock.
    class LruShard<K, V> {
        private index: HashMap<K, int> = new HashMap<K, int>()
        private ks: Array<K> = new Array<K>()
        private vs: Array<V> = new Array<V>()
        private lru: byte*
        public capacity: int
        public hits: long = 0
        public misses: long = 0
        public evictions: long = 0
        constructor(capacity: int) { self.capacity = capacity; self.lru = %{ (unsigned char*)grav_lru_new() %} as byte*; }
        destructor() { %{ grav_lru_free((GravLru*)self->lru); self->lru = 0; %}; }
        fn size() -> int { return self.ks.size(); }
        // The entry's place, or -1 (expired ones are dropped; `now` 0: no times kept).
        fn find(key: K, now: long) -> int {
            let i = self.index.getOr(key, -1);
            if (i < 0) { return -1; }
            if (now > 0 && %{ ({ long long grav_e = ((GravLru*)self->lru)->exp[i]; grav_e > 0 && grav_e <= now; }) %} as bool) { self.removeAt(i); return -1; }
            return i;
        }
        fn valueAt(i: int) -> V { %{ grav_lru_touch((GravLru*)self->lru, i); %}; return self.vs[i]; }
        // The value for `key` (now the most recent), or `fallback`; counts the hit or miss.
        fn getOr(key: K, now: long, fallback: V) -> V {
            let i = self.index.getOr(key, -1);
            if (i >= 0 && now > 0 && %{ ({ long long grav_e = ((GravLru*)self->lru)->exp[i]; grav_e > 0 && grav_e <= now; }) %} as bool) {
                self.removeAt(i);
                i = -1;
            }
            if (i < 0) { self.misses += 1; return fallback; }
            self.hits += 1;
            %{ grav_lru_touch((GravLru*)self->lru, i); %};
            return self.vs[i];
        }
        fn put(key: K, value: V, expiresAt: long) {
            let i = self.index.getOr(key, -1);
            if (i >= 0) {
                self.vs.set(i, value);
                %{ ((GravLru*)self->lru)->exp[i] = expiresAt; grav_lru_touch((GravLru*)self->lru, i); %};
                return;
            }
            if (self.ks.size() >= self.capacity) {
                let t = %{ ((GravLru*)self->lru)->tail %} as int;
                if (t >= 0) { self.removeAt(t); self.evictions += 1; }
            }
            let n = self.ks.size();
            self.ks.push(key);
            self.vs.push(value);
            %{ GravLru* grav_l = (GravLru*)self->lru; grav_lru_ensure(grav_l, n + 1); grav_l->exp[n] = expiresAt; grav_lru_front(grav_l, n); %};
            self.index.put(key, n);
        }
        fn remove(key: K) -> bool {
            let i = self.index.getOr(key, -1);
            if (i < 0) { return false; }
            self.removeAt(i);
            return true;
        }
        private fn removeAt(i: int) {
            %{ grav_lru_unlink((GravLru*)self->lru, i); %};
            self.index.remove(self.ks[i]);
            let last = self.ks.size() - 1;
            if (i != last) {
                // (the last entry moves into i's place)
                self.ks.set(i, self.ks[last]);
                self.vs.set(i, self.vs[last]);
                %{ grav_lru_move((GravLru*)self->lru, last, i); %};
                self.index.put(self.ks[i], i);
            }
            self.ks.pop();
            self.vs.pop();
        }
        fn clear() {
            self.index.clear();
            self.ks.clear();
            self.vs.clear();
            %{ ((GravLru*)self->lru)->head = ((GravLru*)self->lru)->tail = -1; %};
        }
        fn keys(out: Array<K>) {
            let i = %{ ((GravLru*)self->lru)->head %} as int;
            while (i >= 0) {
                out.push(self.ks[i]);
                i = %{ ((GravLru*)self->lru)->next[i] %} as int;
            }
        }
    }

    // A cache of at most `capacity` entries that forgets the least recently used
    // one first; with `ttlMs`, entries also expire that many milliseconds after
    // they were put. Thread-safe: a large cache (1024 entries or more) is split
    // into 16 shards, each with its own lock and an equal share of the room, so
    // threads seldom wait for each other (the order forgotten is then per shard).
    class LruCache<K, V> {
        private shards: Array<LruShard<K, V>> = new Array<LruShard<K, V>>()
        private locks: Array<Mutex> = new Array<Mutex>()
        private mask: int
        public capacity: int
        public ttlMs: long
        constructor(capacity: int, ttlMs: long = 0) {
            if (capacity < 1) { throw new ValueError("an LruCache holds at least one entry"); }
            self.capacity = capacity;
            self.ttlMs = ttlMs;
            let n = capacity >= 1024 ? 16 : 1;
            self.mask = n - 1;
            for (i in 0..n) { self.shards.push(new LruShard<K, V>((capacity + n - 1) / n)); self.locks.push(new Mutex()); }
        }
        private fn shard(key: K) -> int {
            if (self.mask == 0) { return 0; }
            let h = hashOf(key);
            return ((h ^ (h >> 17)) & self.mask) as int;
        }
        private fn now() -> long { return self.ttlMs > 0 ? Time.monotonicMs() : 0; }
        // The value for `key` (now the most recently used), or `fallback`.
        fn getOr(key: K, fallback: V) -> V {
            let s = self.shard(key);
            let now = self.now();
            self.locks[s].lock();
            let v = self.shards[s].getOr(key, now, fallback);
            self.locks[s].unlock();
            return v;
        }
        // Whether `key` is cached (and not expired); does not count as a use.
        fn containsKey(key: K) -> bool {
            let s = self.shard(key);
            let now = self.now();
            self.locks[s].lock();
            let has = self.shards[s].find(key, now) >= 0;
            self.locks[s].unlock();
            return has;
        }
        fn put(key: K, value: V) { self.putFor(key, value, self.ttlMs); }
        // Puts with its own time to live (0: none).
        fn putFor(key: K, value: V, ttlMs: long) {
            let s = self.shard(key);
            let exp = ttlMs > 0 ? Time.monotonicMs() + ttlMs : 0 as long;
            self.locks[s].lock();
            self.shards[s].put(key, value, exp);
            self.locks[s].unlock();
        }
        // The value for `key`, made by `make` when missing or expired (under the
        // key's lock: `make` must not use this cache).
        fn getOrPut(key: K, make: fn(K) -> V) -> V {
            let s = self.shard(key);
            let now = self.now();
            self.locks[s].lock();
            try {
                let sh = self.shards[s];
                let i = sh.find(key, now);
                if (i >= 0) {
                    sh.hits += 1;
                    return sh.valueAt(i);
                }
                sh.misses += 1;
                let v = make(key);
                sh.put(key, v, self.ttlMs > 0 ? Time.monotonicMs() + self.ttlMs : 0 as long);
                return v;
            } finally {
                self.locks[s].unlock();
            }
        }
        // Removes `key`; whether it was there.
        fn remove(key: K) -> bool {
            let s = self.shard(key);
            self.locks[s].lock();
            let had = self.shards[s].remove(key);
            self.locks[s].unlock();
            return had;
        }
        fn size() -> int {
            let n = 0;
            for (i in 0..self.shards.size()) { self.locks[i].lock(); n += self.shards[i].size(); self.locks[i].unlock(); }
            return n;
        }
        fn isEmpty() -> bool { return self.size() == 0; }
        fn clear() { for (i in 0..self.shards.size()) { self.locks[i].lock(); self.shards[i].clear(); self.locks[i].unlock(); } }
        // The keys, most recently used first (per shard).
        fn keys() -> Array<K> {
            let out = new Array<K>();
            for (i in 0..self.shards.size()) { self.locks[i].lock(); self.shards[i].keys(out); self.locks[i].unlock(); }
            return out;
        }
        // Lookups that found an entry, ones that did not, and entries forgotten for room.
        fn hits() -> long { return self.sum(0); }
        fn misses() -> long { return self.sum(1); }
        fn evictions() -> long { return self.sum(2); }
        private fn sum(which: int) -> long {
            let n: long = 0;
            for (i in 0..self.shards.size()) {
                self.locks[i].lock();
                let sh = self.shards[i];
                n += which == 0 ? sh.hits : (which == 1 ? sh.misses : sh.evictions);
                self.locks[i].unlock();
            }
            return n;
        }
    }
}
