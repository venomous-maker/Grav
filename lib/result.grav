// lib/result.grav — Result<T, E> and Option<T> as data enums: match on them, or
// use the helper methods.
//
//   fn parsePort(s: string) -> Result<int, string> {
//       let n = Convert.toInt(s)
//       if (n <= 0 || n > 65535) { return Result.Err("bad port: " + s) }
//       return Result.Ok(n)
//   }
//   match (parsePort("8080")) {
//       case Ok(port): print("listening on ${port}")
//       case Err(msg): print(msg)
//   }
//
// Option<T> is the enum form of lib/optional.grav's Optional<T>.
//
// Inside generic code, write a variant's type arguments explicitly
// (`Result.Ok::<U, E>(x)`, `Option.None::<T>()`): the inferred ones are
// recorded per source location, and generic code is instantiated many times.

// The outcome of an operation that can fail: a value, or an error.
enum Result<T, E> {
    Ok(T),
    Err(E),

    fn isOk() -> bool {
        match (self) {
            case Ok(_): return true
            default: return false
        }
    }
    fn isErr() -> bool { return !self.isOk() }
    // The value; panics with the error when this is an Err.
    fn unwrap() -> T {
        match (self) {
            case Ok(v): return v
            case Err(e): panic("called unwrap() on Err(" + __show(e) + ")")
        }
    }
    // The value, or panics with `message` when this is an Err.
    fn expect(message: string) -> T {
        match (self) {
            case Ok(v): return v
            case Err(e): panic(message + ": " + __show(e))
        }
    }
    fn unwrapOr(fallback: T) -> T {
        match (self) {
            case Ok(v): return v
            default: return fallback
        }
    }
    fn unwrapOrElse(f: fn(E) -> T) -> T {
        match (self) {
            case Ok(v): return v
            case Err(e): return f(e)
        }
    }
    // The error; panics when this is an Ok.
    fn unwrapErr() -> E {
        match (self) {
            case Err(e): return e
            case Ok(v): panic("called unwrapErr() on Ok(" + __show(v) + ")")
        }
    }
    // Ok(f(value)); errors pass through unchanged.
    fn map<U>(f: fn(T) -> U) -> Result<U, E> {
        match (self) {
            case Ok(v): return Result.Ok::<U, E>(f(v))
            case Err(e): return Result.Err::<U, E>(e)
        }
    }
    // Err(f(error)); values pass through unchanged.
    fn mapErr<F>(f: fn(E) -> F) -> Result<T, F> {
        match (self) {
            case Ok(v): return Result.Ok::<T, F>(v)
            case Err(e): return Result.Err::<T, F>(f(e))
        }
    }
    // Chains a step that can itself fail.
    fn andThen<U>(f: fn(T) -> Result<U, E>) -> Result<U, E> {
        match (self) {
            case Ok(v): return f(v)
            case Err(e): return Result.Err::<U, E>(e)
        }
    }
    fn ok() -> Option<T> {
        match (self) {
            case Ok(v): return Option.Some::<T>(v)
            default: return Option.None::<T>()
        }
    }
}

// A value that may be absent.
enum Option<T> {
    Some(T),
    None,

    fn isSome() -> bool {
        match (self) {
            case Some(_): return true
            default: return false
        }
    }
    fn isNone() -> bool { return !self.isSome() }
    // The value; panics when this is None.
    fn unwrap() -> T {
        match (self) {
            case Some(v): return v
            case None: panic("called unwrap() on None")
        }
    }
    fn expect(message: string) -> T {
        match (self) {
            case Some(v): return v
            case None: panic(message)
        }
    }
    fn unwrapOr(fallback: T) -> T {
        match (self) {
            case Some(v): return v
            default: return fallback
        }
    }
    fn unwrapOrElse(f: fn() -> T) -> T {
        match (self) {
            case Some(v): return v
            default: return f()
        }
    }
    fn map<U>(f: fn(T) -> U) -> Option<U> {
        match (self) {
            case Some(v): return Option.Some::<U>(f(v))
            default: return Option.None::<U>()
        }
    }
    fn andThen<U>(f: fn(T) -> Option<U>) -> Option<U> {
        match (self) {
            case Some(v): return f(v)
            default: return Option.None::<U>()
        }
    }
    fn filter(keep: fn(T) -> bool) -> Option<T> {
        match (self) {
            case Some(v): if (keep(v)) { return self } else { return Option.None::<T>() }
            default: return Option.None::<T>()
        }
    }
    fn ifSome(f: fn(T)) {
        match (self) {
            case Some(v): f(v)
            default: {}
        }
    }
    // Ok(value), or Err(error) when None.
    fn okOr<E>(error: E) -> Result<T, E> {
        match (self) {
            case Some(v): return Result.Ok::<T, E>(v)
            default: return Result.Err::<T, E>(error)
        }
    }
}
