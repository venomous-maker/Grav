// lib/sys/process.grav — running commands and process information.
//
//   let r = Process.run("ls /tmp")
//   if (r.code == 0) { print(r.output) }
import "../core/exception.grav"
import "../collections/array.grav"
import "../collections/hashmap.grav"
import "../concurrency/async.grav"
import "../concurrency/thread.grav"

namespace std.sys {

    %{
    #include <stdlib.h>
    #include <unistd.h>
    #include <stdio.h>
    #include <sys/wait.h>
    static int grav_exit_code(int status) {
        if (status == -1) return -1;
        if (WIFEXITED(status)) return WEXITSTATUS(status);
        if (WIFSIGNALED(status)) return 128 + WTERMSIG(status);
        return status;
    }
    static const char* grav_exec_capture(const char* cmd, int* code) {
        FILE* p = popen(cmd, "r"); if (!p) { *code = -1; return ""; }
        size_t cap = 4096, n = 0; char* b = grav_str_alloc(cap); int c;
        while ((c = fgetc(p)) != EOF) {
            if (n + 1 >= cap) { cap *= 2; b = grav_str_grow(b, cap); }
            b[n++] = (char)c;
        }
        b[n] = 0; *code = grav_exit_code(pclose(p)); return b;
    }
    #include <signal.h>
    #include <string.h>
    #include <sys/resource.h>
    /* The last trapped signal, until signalReceived() takes it (async-signal-safe: one store). */
    static volatile sig_atomic_t grav_pending_signal = 0;
    static void grav_on_signal(int sig) { grav_pending_signal = sig; }
    /* onSignal: the handler only writes the signal's number to a pipe (all a
       handler may safely do); a Grav thread reads it and runs the callbacks. A
       second SIGINT or SIGTERM ends the program at once (a stuck shutdown). */
    #include <errno.h>
    #include <fcntl.h>
    #include <limits.h>
    #if defined(__APPLE__)
    extern int _NSGetExecutablePath(char* buf, unsigned int* size);
    #endif
    /* The running program's absolute path: /proc/self/exe (Linux), the loader's
       record (macOS), else argv[0] made absolute; "" when none can be found. */
    static const char* grav_proc_executable(void) {
        char buf[PATH_MAX + 1];
        long n = -1;
    #if defined(__APPLE__)
        unsigned int size = sizeof buf;
        char raw[PATH_MAX + 1];
        if (_NSGetExecutablePath(raw, &size) == 0 && realpath(raw, buf)) n = (long)strlen(buf);
    #else
        n = (long)readlink("/proc/self/exe", buf, PATH_MAX);
        if (n < 0) n = (long)readlink("/proc/curproc/file", buf, PATH_MAX);   /* (FreeBSD) */
        if (n >= 0) buf[n] = 0;
    #endif
        if (n < 0) {
            const char* a0 = grav_argv_at(0);
            if (!a0[0] || !realpath(a0, buf)) return grav_strdup("");
        }
        return grav_strdup(buf);
    }
    static int grav_sig_pipe[2] = { -1, -1 };
    static volatile sig_atomic_t grav_sig_seen[65];
    static void grav_sig_forward(int sig) {
        int saved = errno;
        if ((sig == SIGINT || sig == SIGTERM) && sig < 65 && grav_sig_seen[sig]++ > 0) _exit(128 + sig);
        unsigned char b = (unsigned char)sig;
        ssize_t w = write(grav_sig_pipe[1], &b, 1);
        (void)w;
        errno = saved;
    }
    static int grav_sig_listen(int sig) {
        if (grav_sig_pipe[0] < 0) {
            if (pipe(grav_sig_pipe) != 0) return 0;
            fcntl(grav_sig_pipe[0], F_SETFD, FD_CLOEXEC);
            fcntl(grav_sig_pipe[1], F_SETFD, FD_CLOEXEC);
        }
        struct sigaction sa; memset(&sa, 0, sizeof sa);
        sa.sa_handler = grav_sig_forward; sigemptyset(&sa.sa_mask);
        sa.sa_flags = SA_RESTART;
        return sigaction(sig, &sa, 0) == 0;
    }
    /* The next signal onSignal listens for (blocks); -1 when the pipe fails. */
    static int grav_sig_next(void) {
        unsigned char b;
        for (;;) {
            ssize_t r = read(grav_sig_pipe[0], &b, 1);
            if (r == 1) return b;
            if (r < 0 && errno == EINTR) continue;
            return -1;
        }
    }
    static void grav_trap_signal(int sig) {
        struct sigaction sa; memset(&sa, 0, sizeof sa);
        sa.sa_handler = grav_on_signal; sigemptyset(&sa.sa_mask);
        sa.sa_flags = SA_RESTART;
        sigaction(sig, &sa, 0);
    }
    /* Resident memory in bytes (Linux /proc/self/statm), else the peak from getrusage. */
    static long long grav_memory_rss(void) {
        FILE* f = fopen("/proc/self/statm", "r");
        if (f) {
            long long size = 0, resident = 0;
            int ok = fscanf(f, "%lld %lld", &size, &resident) == 2;
            fclose(f);
            if (ok) return resident * (long long)sysconf(_SC_PAGESIZE);
        }
        struct rusage u; getrusage(RUSAGE_SELF, &u);
        return (long long)u.ru_maxrss * 1024LL;
    }
    static long long grav_memory_peak(void) {
        struct rusage u; getrusage(RUSAGE_SELF, &u);
    #ifdef __APPLE__
        return (long long)u.ru_maxrss;
    #else
        return (long long)u.ru_maxrss * 1024LL;
    #endif
    }
    %}

    // The result of Process.run: the exit code and everything the command printed.
    class ProcessResult {
        readonly code: int
        readonly output: string
        constructor(code: int, output: string) { self.code = code; self.output = output; }
        // Whether the command exited with status 0.
        public fn ok() -> bool { return self.code == 0; }
    }

    class Process {
        // Runs a shell command; returns its exit code (output goes to the terminal).
        static fn exec(cmd: string) -> int { return %{ grav_exit_code(system(cmd)) %} as int; }
        // Runs a shell command and captures its standard output.
        static fn execOutput(cmd: string) -> string { let c = 0; return %{ grav_exec_capture(cmd, &c) %} as string; }
        // Runs a shell command, capturing its output and exit status.
        static fn run(cmd: string) -> ProcessResult {
            let c = 0;
            let out = %{ grav_exec_capture(cmd, &c) %} as string;
            return new ProcessResult(c, out);
        }
        // This process's id.
        static fn pid() -> int { return %{ (int)getpid() %} as int; }
        // The running program's absolute path ("/home/ada/app/server"): to start
        // more copies of itself (workers), or find files installed beside it.
        static fn executable() -> string { return %{ grav_proc_executable() %} as string; }
        // The program's command-line arguments (without the program name).
        static fn args() -> Array<string> {
            let out = new Array<string>();
            for (i in 1..argc()) { out.push(argv(i)); }
            return out;
        }
        // Pauses for `ms` milliseconds.
        static fn sleepMs(ms: int) { %{ if (ms > 0) { struct timespec grav_t; grav_t.tv_sec = (time_t)(ms / 1000); grav_t.tv_nsec = (long)(ms % 1000) * 1000000L; while (nanosleep(&grav_t, &grav_t) != 0) {} } %}; }
        // Ends the program with an exit status.
        static fn exit(code: int) { exit(code); }

        // ── signals and memory (for long-running workers) ───────────────────────
        // The usual signal numbers.
        static fn SIGHUP() -> int { return 1; }
        static fn SIGINT() -> int { return 2; }
        static fn SIGQUIT() -> int { return 3; }
        static fn SIGUSR1() -> int { return %{ SIGUSR1 %} as int; }
        static fn SIGUSR2() -> int { return %{ SIGUSR2 %} as int; }
        static fn SIGTERM() -> int { return 15; }
        // Catches these signals instead of letting them end the program: the
        // program asks signalReceived() between units of work (a queue worker
        // finishing its job before stopping on SIGTERM, say).
        static fn trapSignals(signals: Array<int>) { for (s in signals) { %{ grav_trap_signal(s); %}; } }
        // Lets a signal do what it does by default again.
        static fn untrapSignal(sig: int) { %{ signal(sig, SIG_DFL); %}; }
        // The last trapped signal received since the previous call (0: none); taking it clears it.
        static fn signalReceived() -> int {
            let s = %{ (int)grav_pending_signal %} as int;
            %{ grav_pending_signal = 0; %};
            return s;
        }
        // Runs `handler` (on a thread of its own, as ordinary code) each time
        // `sig` arrives, instead of the signal's default action. A second SIGINT
        // or SIGTERM while the first is being handled ends the program at once.
        static fn onSignal(sig: int, handler: fn()) {
            Process.sigLock.lock();
            let list = Process.sigHandlers.getOr(sig, null);
            let first = list == null;
            if (first) { list = new Array<fn()>(); Process.sigHandlers.put(sig, list); }
            list.push(handler);
            let start = !Process.sigWatching;
            Process.sigWatching = true;
            Process.sigLock.unlock();
            if (first && !(%{ grav_sig_listen(sig) %} as bool)) { throw new StateError("cannot listen for signal ${sig}"); }
            if (start) {
                Thread.spawn("signals", fn() {
                    while (true) {
                        let s = %{ grav_sig_next() %} as int;
                        if (s < 0) { break; }
                        Process.sigLock.lock();
                        let hs = Process.sigHandlers.getOr(s, null);
                        let run = hs == null ? new Array<fn()>() : hs.copy();
                        Process.sigLock.unlock();
                        for (h in run) { try { h(); } catch (e: Exception) {} }
                    }
                });
            }
        }
        // Runs `handler` when the program is asked to stop (SIGTERM, as from a
        // process manager or `kill`, or SIGINT, Ctrl+C): finish the work in hand
        // and exit. A second request ends the program at once.
        static fn onShutdown(handler: fn()) {
            Process.onSignal(Process.SIGTERM(), handler);
            Process.onSignal(Process.SIGINT(), handler);
        }
        private static sigHandlers: HashMap<int, Array<fn()>> = new HashMap<int, Array<fn()>>()
        private static sigLock: Mutex = new Mutex()
        private static sigWatching: bool = false
        // Sends `sig` to process `pid` (to itself: Process.pid()); whether it went.
        static fn kill(pid: int, sig: int) -> bool { return %{ kill(pid, sig) == 0 %} as bool; }
        // The memory this process holds now (resident set), in bytes.
        static fn memoryUsage() -> long { return %{ grav_memory_rss() %} as long; }
        // The most it has held at once, in bytes.
        static fn peakMemoryUsage() -> long { return %{ grav_memory_peak() %} as long; }
    }

}
