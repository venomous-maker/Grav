    // UNICODE-DATA END

    /* The tables, unpacked once. */
    static uint32_t *grav_uni_dcp, *grav_uni_doff, *grav_uni_pool, *grav_uni_ccp, *grav_uni_cpk;
    static uint8_t *grav_uni_dlen, *grav_uni_dcompat, *grav_uni_cval;
    static uint64_t *grav_uni_pairs;
    static int grav_uni_nd, grav_uni_nc, grav_uni_np;
    static pthread_once_t grav_uni_once = PTHREAD_ONCE_INIT;
    static int grav_uni_b64(int c) {
        if (c >= 'A' && c <= 'Z') return c - 'A';
        if (c >= 'a' && c <= 'z') return c - 'a' + 26;
        if (c >= '0' && c <= '9') return c - '0' + 52;
        return c == '+' ? 62 : c == '/' ? 63 : -1;
    }
    static uint32_t grav_uni_var(const unsigned char* p, size_t* at) {
        uint32_t v = 0; int shift = 0;
        for (;;) { unsigned char b = p[(*at)++]; v |= (uint32_t)(b & 0x7f) << shift; if (!(b & 0x80)) return v; shift += 7; }
    }
    static uint32_t grav_uni_dfind(uint32_t cp) {   /* index + 1, or 0 */
        int lo = 0, hi = grav_uni_nd - 1;
        while (lo <= hi) { int m = (lo + hi) / 2; if (grav_uni_dcp[m] == cp) return (uint32_t)m + 1; if (grav_uni_dcp[m] < cp) lo = m + 1; else hi = m - 1; }
        return 0;
    }
    static int grav_uni_pcmp(const void* a, const void* b) {
        uint64_t x = *(const uint64_t*)a >> 21, y = *(const uint64_t*)b >> 21;   /* (by the pair; the composite rides below) */
        return x < y ? -1 : x > y;
    }
    static void grav_uni_load(void) {
        const char* s = grav_uni_packed();
        size_t n = strlen(s), m = 0;
        unsigned char* raw = (unsigned char*)malloc(n * 3 / 4 + 4);
        if (!raw) abort();
        uint32_t acc = 0; int bits = 0;
        for (size_t i = 0; i < n; i++) {
            int v = grav_uni_b64((unsigned char)s[i]);
            if (v < 0) continue;
            acc = (acc << 6) | (uint32_t)v; bits += 6;
            if (bits >= 8) { raw[m++] = (unsigned char)(acc >> (bits - 8)); bits -= 8; }
        }
        size_t at = 0;
        grav_uni_nd = (int)grav_uni_var(raw, &at);
        grav_uni_dcp = (uint32_t*)malloc(sizeof(uint32_t) * (size_t)grav_uni_nd);
        grav_uni_doff = (uint32_t*)malloc(sizeof(uint32_t) * (size_t)grav_uni_nd);
        grav_uni_dlen = (uint8_t*)malloc((size_t)grav_uni_nd);
        grav_uni_dcompat = (uint8_t*)malloc((size_t)grav_uni_nd);
        grav_uni_pool = (uint32_t*)malloc(sizeof(uint32_t) * (size_t)grav_uni_nd * 18);
        uint32_t last = 0, pn = 0;
        for (int i = 0; i < grav_uni_nd; i++) {
            last += grav_uni_var(raw, &at);
            uint32_t lc = grav_uni_var(raw, &at);
            grav_uni_dcp[i] = last; grav_uni_dlen[i] = (uint8_t)(lc >> 1); grav_uni_dcompat[i] = (uint8_t)(lc & 1); grav_uni_doff[i] = pn;
            for (uint32_t k = 0; k < (lc >> 1); k++) grav_uni_pool[pn++] = grav_uni_var(raw, &at);
        }
        grav_uni_nc = (int)grav_uni_var(raw, &at);
        grav_uni_ccp = (uint32_t*)malloc(sizeof(uint32_t) * (size_t)grav_uni_nc);
        grav_uni_cval = (uint8_t*)malloc((size_t)grav_uni_nc);
        last = 0;
        for (int i = 0; i < grav_uni_nc; i++) { last += grav_uni_var(raw, &at); grav_uni_ccp[i] = last; grav_uni_cval[i] = (uint8_t)grav_uni_var(raw, &at); }
        grav_uni_np = (int)grav_uni_var(raw, &at);
        grav_uni_cpk = (uint32_t*)malloc(sizeof(uint32_t) * (size_t)grav_uni_np);
        grav_uni_pairs = (uint64_t*)malloc(sizeof(uint64_t) * (size_t)grav_uni_np);
        last = 0;
        for (int i = 0; i < grav_uni_np; i++) {
            last += grav_uni_var(raw, &at);
            uint32_t e = grav_uni_dfind(last) - 1;
            uint64_t a = grav_uni_pool[grav_uni_doff[e]], b = grav_uni_pool[grav_uni_doff[e] + 1];
            grav_uni_pairs[i] = (((a << 21) | b) << 21) | last;          /* pair, then the composite */
        }
        qsort(grav_uni_pairs, (size_t)grav_uni_np, sizeof(uint64_t), grav_uni_pcmp);
        free(raw);
    }
    static int grav_uni_ccc(uint32_t cp) {
        if (cp < 0x300) return 0;
        int lo = 0, hi = grav_uni_nc - 1;
        while (lo <= hi) { int m = (lo + hi) / 2; if (grav_uni_ccp[m] == cp) return grav_uni_cval[m]; if (grav_uni_ccp[m] < cp) lo = m + 1; else hi = m - 1; }
        return 0;
    }
    enum { GRAV_SB = 0xAC00, GRAV_LB = 0x1100, GRAV_VB = 0x1161, GRAV_TB = 0x11A7, GRAV_LC = 19, GRAV_VC = 21, GRAV_TC = 28, GRAV_NC = 588, GRAV_SC = 11172 };
    typedef struct { uint32_t* v; size_t n, cap; } GravUniBuf;
    static void grav_uni_push(GravUniBuf* b, uint32_t c) {
        if (b->n == b->cap) { b->cap = b->cap ? b->cap * 2 : 64; b->v = (uint32_t*)realloc(b->v, b->cap * sizeof(uint32_t)); if (!b->v) abort(); }
        b->v[b->n++] = c;
    }
    static void grav_uni_decomp(GravUniBuf* b, uint32_t cp, int compat) {
        if (cp >= GRAV_SB && cp < GRAV_SB + GRAV_SC) {
            uint32_t si = cp - GRAV_SB;
            grav_uni_push(b, GRAV_LB + si / GRAV_NC);
            grav_uni_push(b, GRAV_VB + (si % GRAV_NC) / GRAV_TC);
            if (si % GRAV_TC) grav_uni_push(b, GRAV_TB + si % GRAV_TC);
            return;
        }
        uint32_t e = cp < 0xA0 ? 0 : grav_uni_dfind(cp);
        if (e && (compat || !grav_uni_dcompat[e - 1])) {
            for (int k = 0; k < grav_uni_dlen[e - 1]; k++) grav_uni_decomp(b, grav_uni_pool[grav_uni_doff[e - 1] + k], compat);
            return;
        }
        grav_uni_push(b, cp);
    }
    static uint32_t grav_uni_compose(uint32_t a, uint32_t b) {
        if (a >= GRAV_LB && a < GRAV_LB + GRAV_LC && b >= GRAV_VB && b < GRAV_VB + GRAV_VC)
            return GRAV_SB + ((a - GRAV_LB) * GRAV_VC + (b - GRAV_VB)) * GRAV_TC;
        if (a >= GRAV_SB && a < GRAV_SB + GRAV_SC && (a - GRAV_SB) % GRAV_TC == 0 && b > GRAV_TB && b < GRAV_TB + GRAV_TC)
            return a + (b - GRAV_TB);
        uint64_t key = ((uint64_t)a << 21) | b;
        int lo = 0, hi = grav_uni_np - 1;
        while (lo <= hi) {
            int m = (lo + hi) / 2;
            uint64_t k = grav_uni_pairs[m] >> 21;
            if (k == key) return (uint32_t)(grav_uni_pairs[m] & 0x1FFFFF);
            if (k < key) lo = m + 1; else hi = m - 1;
        }
        return 0;
    }
    static size_t grav_uni_utf8(char* o, uint32_t c) {
        if (c < 0x80) { o[0] = (char)c; return 1; }
        if (c < 0x800) { o[0] = (char)(0xC0 | (c >> 6)); o[1] = (char)(0x80 | (c & 0x3F)); return 2; }
        if (c < 0x10000) { o[0] = (char)(0xE0 | (c >> 12)); o[1] = (char)(0x80 | ((c >> 6) & 0x3F)); o[2] = (char)(0x80 | (c & 0x3F)); return 3; }
        o[0] = (char)(0xF0 | (c >> 18)); o[1] = (char)(0x80 | ((c >> 12) & 0x3F)); o[2] = (char)(0x80 | ((c >> 6) & 0x3F)); o[3] = (char)(0x80 | (c & 0x3F)); return 4;
    }
    /* form: bit 0 compatibility (K), bit 1 compose (C), bit 2 drop combining marks. */
    static const char* grav_uni_normalize(const char* s, int form) {
        const unsigned char* p = (const unsigned char*)s;
        size_t len = strlen(s), i = 0;
        while (i < len && p[i] < 0x80) i++;
        if (i == len) return grav_str_retain(s);                       /* ASCII: already normal */
        pthread_once(&grav_uni_once, grav_uni_load);
        GravUniBuf b = {0, 0, 0};
        for (i = 0; i < len;) {
            uint32_t c; unsigned char x = p[i];
            int need = x < 0x80 ? 0 : (x & 0xE0) == 0xC0 ? 1 : (x & 0xF0) == 0xE0 ? 2 : (x & 0xF8) == 0xF0 ? 3 : -1;
            if (need < 0 || i + (size_t)need >= len + (need == 0)) { c = 0xFFFD; i++; }
            else {
                c = need == 0 ? x : need == 1 ? (x & 0x1F) : need == 2 ? (x & 0x0F) : (x & 0x07);
                int ok = 1;
                for (int k = 1; k <= need; k++) { if ((p[i + (size_t)k] & 0xC0) != 0x80) { ok = 0; break; } c = (c << 6) | (p[i + (size_t)k] & 0x3F); }
                if (!ok) { c = 0xFFFD; i++; } else i += (size_t)need + 1;
            }
            grav_uni_decomp(&b, c, form & 1);
        }
        /* combining marks into canonical order (stable, by class) */
        for (size_t a = 1; a < b.n; a++) {
            int cc = grav_uni_ccc(b.v[a]);
            if (!cc) continue;
            size_t k = a;
            while (k > 0) {
                int pc = grav_uni_ccc(b.v[k - 1]);
                if (pc <= cc) break;
                uint32_t t = b.v[k]; b.v[k] = b.v[k - 1]; b.v[k - 1] = t; k--;
            }
        }
        if (form & 4) {                                                /* marks dropped (stripAccents) */
            size_t o = 0;
            for (size_t a = 0; a < b.n; a++) if (!grav_uni_ccc(b.v[a])) b.v[o++] = b.v[a];
            b.n = o;
        }
        if ((form & 2) && b.n > 0) {
            size_t starter = 0, o = 1;
            int lastCC = grav_uni_ccc(b.v[0]) ? 256 : 0;
            for (size_t a = 1; a < b.n; a++) {
                uint32_t c = b.v[a];
                int cc = grav_uni_ccc(c);
                uint32_t comp = grav_uni_compose(b.v[starter], c);
                if (comp && (lastCC < cc || lastCC == 0)) { b.v[starter] = comp; continue; }
                if (!cc) starter = o;
                lastCC = cc;
                b.v[o++] = c;
            }
            b.n = o;
        }
        char* out = grav_str_new(b.n * 4);
        size_t on = 0;
        for (size_t a = 0; a < b.n; a++) on += grav_uni_utf8(out + on, b.v[a]);
        out[on] = 0;
        free(b.v);
        return out;
    }
    %}

    class Unicode {
        // Composed (NFC): what most text uses; compare, store and index user text like this.
        static fn nfc(s: string) -> string { return %{ grav_uni_normalize(s, 2) %} as string; }
        // Decomposed (NFD): each letter, then its marks in a fixed order.
        static fn nfd(s: string) -> string { return %{ grav_uni_normalize(s, 0) %} as string; }
        // Compatibility, composed (NFKC): "ﬁ" is "fi", "²" is "2", full-width letters are
        // plain: for usernames, identifiers and search terms.
        static fn nfkc(s: string) -> string { return %{ grav_uni_normalize(s, 3) %} as string; }
        // Compatibility, decomposed (NFKD).
        static fn nfkd(s: string) -> string { return %{ grav_uni_normalize(s, 1) %} as string; }
        // `form` is "NFC", "NFD", "NFKC" or "NFKD".
        static fn normalize(s: string, form: string) -> string {
            let f = Str.upper(form);
            if (f == "NFC") { return Unicode.nfc(s); }
            if (f == "NFD") { return Unicode.nfd(s); }
            if (f == "NFKC") { return Unicode.nfkc(s); }
            if (f == "NFKD") { return Unicode.nfkd(s); }
            throw new ValueError("no normalization form '" + form + "' (NFC, NFD, NFKC, NFKD)");
        }
        // Whether `s` is already in `form`.
        static fn isNormalized(s: string, form: string = "NFC") -> bool { return Unicode.normalize(s, form) == s; }
        // The text without accents and other combining marks ("Crème" -> "Creme"):
        // for slugs and accent-insensitive search.
        static fn stripAccents(s: string) -> string { return %{ grav_uni_normalize(s, 6) %} as string; }
    }
}
