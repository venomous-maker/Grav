// lib/text/string.grav — string utilities as static methods (backed by C string.h).

import "../core/exception.grav"
import "../collections/array.grav"

namespace std.text {

    %{
    #include <string.h>
    #include <stdlib.h>
    #include <ctype.h>
    static const char* grav_str_upper(const char* s) {
        size_t n = grav_str_len(s); char* r = grav_str_alloc(n + 1);
        for (size_t i = 0; i < n; i++) r[i] = (char)toupper((unsigned char)s[i]);
        r[n] = 0; return r;
    }
    static const char* grav_str_lower(const char* s) {
        size_t n = grav_str_len(s); char* r = grav_str_alloc(n + 1);
        for (size_t i = 0; i < n; i++) r[i] = (char)tolower((unsigned char)s[i]);
        r[n] = 0; return r;
    }
    static const char* grav_str_repeat(const char* s, int k) {
        if (k < 0) k = 0;
        size_t n = grav_str_len(s); char* r = grav_str_alloc(n * (size_t)k + 1);
        char* p = r;
        for (int i = 0; i < k; i++) { memcpy(p, s, n); p += n; }
        *p = 0; return r;
    }
    static const char* grav_str_sub(const char* s, int start, int len) {
        int n = (int)grav_str_len(s);
        if (start < 0) start = 0;
        if (start > n) start = n;
        if (len < 0 || start + len > n) len = n - start;
        char* r = grav_str_alloc((size_t)len + 1);
        memcpy(r, s + start, (size_t)len); r[len] = 0; return r;
    }
    static int grav_str_indexof(const char* s, const char* sub, int from) {
        if (from < 0) from = 0;
        if (from > (int)grav_str_len(s)) return -1;
        const char* p = strstr(s + from, sub);
        return p ? (int)(p - s) : -1;
    }
    /* One counted string copied from p[0..n). */
    static const char* grav_str_piece(const char* p, size_t n) {
        char* r = grav_str_alloc(n + 1); memcpy(r, p, n); r[n] = 0; return r;
    }
    /* Byte offsets of the next piece of s at or after *pos: kind 0 split on `delim`,
       1 whitespace words, 2 lines. Returns 0 when there is none; else sets *a, *b. */
    static int grav_str_next_piece(const char* s, long long n, const char* delim, int kind, long long* pos, long long* a, long long* b) {
        long long i = *pos;
        if (i > n) return 0;
        if (kind == 0) {
            size_t dl = strlen(delim);
            const char* hit = dl ? strstr(s + i, delim) : 0;
            *a = i;
            if (!hit) { *b = n; *pos = n + 1; return 1; }
            *b = hit - s; *pos = *b + (long long)dl; return 1;
        }
        if (kind == 1) {
            while (i < n && isspace((unsigned char)s[i])) i++;
            if (i >= n) { *pos = n + 1; return 0; }
            *a = i;
            while (i < n && !isspace((unsigned char)s[i])) i++;
            *b = i; *pos = i; return 1;
        }
        if (i >= n) return 0;
        const char* nl = memchr(s + i, '\n', (size_t)(n - i));
        *a = i;
        long long e = nl ? nl - s : n;
        *pos = e + 1;
        if (e > i && s[e - 1] == '\r') e--;
        *b = e;
        return 1;
    }
    static const char* grav_str_reverse(const char* s) {
        size_t n = grav_str_len(s); char* r = grav_str_alloc(n + 1);
        for (size_t i = 0; i < n; i++) r[i] = s[n - 1 - i];
        r[n] = 0; return r;
    }
    static const char* grav_str_trim(const char* s, int left, int right) {
        const char* a = s; const char* b = s + grav_str_len(s);
        if (left)  while (*a && isspace((unsigned char)*a)) a++;
        if (right) while (b > a && isspace((unsigned char)b[-1])) b--;
        size_t n = (size_t)(b - a); char* r = grav_str_alloc(n + 1);
        memcpy(r, a, n); r[n] = 0; return r;
    }
    static const char* grav_str_pad(const char* s, int len, char c, int left) {
        int n = (int)grav_str_len(s);
        if (n >= len) { char* r = grav_str_alloc((size_t)n + 1); memcpy(r, s, n + 1); return r; }
        char* r = grav_str_alloc((size_t)len + 1);
        int pad = len - n;
        if (left)  { memset(r, c, pad); memcpy(r + pad, s, n); }
        else       { memcpy(r, s, n); memset(r + n, c, pad); }
        r[len] = 0; return r;
    }
    static char* grav_str_dup(const char* s) {
        size_t n = grav_str_len(s); char* r = grav_str_alloc(n + 1); memcpy(r, s, n + 1); return r;
    }
    static const char* grav_str_replace(const char* s, const char* o, const char* n) {
        size_t ol = strlen(o); if (ol == 0) return grav_str_dup(s);
        size_t nl = strlen(n), cnt = 0;
        for (const char* p = s; (p = strstr(p, o)); p += ol) cnt++;
        char* r = grav_str_alloc(grav_str_len(s) + cnt * (nl > ol ? nl - ol : 0) + 1);
        char* w = r; const char* p = s; const char* q;
        while ((q = strstr(p, o))) { memcpy(w, p, q - p); w += q - p; memcpy(w, n, nl); w += nl; p = q + ol; }
        strcpy(w, p); return r;
    }
    static int grav_str_ends(const char* s, const char* suf) {
        size_t n = grav_str_len(s), m = strlen(suf);
        return m <= n && memcmp(s + n - m, suf, m) == 0;
    }
    static int grav_str_lastindexof(const char* s, const char* sub) {
        size_t n = grav_str_len(s), m = grav_str_len(sub);
        if (m > n) return -1;
        for (size_t i = n - m + 1; i-- > 0;) if (memcmp(s + i, sub, m) == 0) return (int)i;
        return -1;
    }
    /* One allocation for the whole result (Str.join). */
    static const char* grav_str_join(const char** parts, int count, const char* delim) {
        size_t dl = strlen(delim), total = 0;
        for (int i = 0; i < count; i++) total += grav_str_len(parts[i]) + (i ? dl : 0);
        char* r = grav_str_alloc(total + 1); char* w = r;
        for (int i = 0; i < count; i++) {
            if (i) { memcpy(w, delim, dl); w += dl; }
            size_t l = grav_str_len(parts[i]); memcpy(w, parts[i], l); w += l;
        }
        *w = 0; return r;
    }
    static const char* grav_str_capitalize(const char* s) {
        size_t n = grav_str_len(s); char* r = grav_str_alloc(n + 1); memcpy(r, s, n + 1);
        if (n) r[0] = (char)toupper((unsigned char)r[0]);
        return r;
    }
    static int grav_str_casecmp(const char* a, const char* b) {
        for (;; a++, b++) {
            int x = tolower((unsigned char)*a), y = tolower((unsigned char)*b);
            if (x != y || !x) return x - y;
        }
    }
    static int grav_str_all(const char* s, int kind) {
        if (!*s) return 0;
        for (; *s; s++) {
            unsigned char c = (unsigned char)*s;
            int ok = kind == 0 ? isdigit(c) : kind == 1 ? isalpha(c) : kind == 2 ? isalnum(c)
                   : kind == 3 ? isspace(c) : kind == 4 ? (isupper(c) || !isalpha(c)) : (islower(c) || !isalpha(c));
            if (!ok) return 0;
        }
        return 1;
    }
    static const char* grav_str_center(const char* s, int width, char c) {
        int n = (int)grav_str_len(s);
        if (n >= width) return grav_str_dup(s);
        int left = (width - n) / 2, right = width - n - left;
        char* r = grav_str_alloc((size_t)width + 1);
        memset(r, c, left); memcpy(r + left, s, n); memset(r + left + n, c, right); r[width] = 0;
        return r;
    }
    static const char* grav_str_from_char(int code) {
        char* r = grav_str_alloc(2); r[0] = (char)code; r[1] = 0; return r;
    }
    static int grav_str_count(const char* s, const char* sub) {
        size_t l = grav_str_len(sub); if (l == 0) return 0;
        int c = 0; for (const char* p = s; (p = strstr(p, sub)); p += l) c++;
        return c;
    }
    %}

    class Str {
        // ── inspecting ─────────────────────────────────────────────────────────
        // The length in bytes (UTF-8: a character may take several).
        static fn length(s: string) -> int { return %{ (int)grav_str_len(s) %} as int; }
        // Whether the string is "".
        static fn isEmpty(s: string) -> bool { return %{ (s[0] == 0) %} as bool; }
        // Empty or only whitespace.
        static fn isBlank(s: string) -> bool { return Str.isEmpty(s) || %{ grav_str_all(s, 3) %} as bool; }
        // Whether the strings have the same contents (same as ==).
        static fn equals(a: string, b: string) -> bool { return a == b; }
        // Whether the strings are equal ignoring ASCII letter case.
        static fn equalsIgnoreCase(a: string, b: string) -> bool { return %{ grav_str_casecmp(a, b) == 0 %} as bool; }
        // <0, 0, >0 like strcmp: `xs.sortBy(fn(a, b) => Str.compare(a, b))` sorts A-Z.
        static fn compare(a: string, b: string) -> int { return %{ strcmp(a, b) %} as int; }
        // Like compare, ignoring ASCII letter case.
        static fn compareIgnoreCase(a: string, b: string) -> int { return %{ grav_str_casecmp(a, b) %} as int; }
        // The byte at index i (bounds-checked).
        static fn charAt(s: string, i: int) -> int {
            if (i < 0 || i >= Str.length(s)) { throw new IndexError("Str.charAt index ${i} out of range"); }
            return %{ (int)(unsigned char)s[i] %} as int;
        }
        // A one-character string from a byte value (65 -> "A").
        static fn fromChar(code: int) -> string { return %{ grav_str_from_char(code) %} as string; }
        // Whether every character is a digit 0-9 (false for "").
        static fn isDigits(s: string) -> bool { return %{ grav_str_all(s, 0) %} as bool; }
        // Whether every character is an ASCII letter (false for "").
        static fn isAlpha(s: string) -> bool { return %{ grav_str_all(s, 1) %} as bool; }
        // Whether every character is an ASCII letter or digit (false for "").
        static fn isAlphanumeric(s: string) -> bool { return %{ grav_str_all(s, 2) %} as bool; }
        // Whether no letter is lowercase (false for "").
        static fn isUpper(s: string) -> bool { return %{ grav_str_all(s, 4) %} as bool; }
        // Whether no letter is uppercase (false for "").
        static fn isLower(s: string) -> bool { return %{ grav_str_all(s, 5) %} as bool; }

        // ── searching ──────────────────────────────────────────────────────────
        // The byte index of the first occurrence of `sub`, or -1.
        static fn indexOf(s: string, sub: string) -> int { return %{ grav_str_indexof(s, sub, 0) %} as int; }
        // The byte index of the first occurrence of `sub` at or after `from`, or -1.
        static fn indexFrom(s: string, sub: string, from: int) -> int { return %{ grav_str_indexof(s, sub, from) %} as int; }
        // The byte index of the last occurrence of `sub`, or -1.
        static fn lastIndexOf(s: string, sub: string) -> int { return %{ grav_str_lastindexof(s, sub) %} as int; }
        // Whether `sub` occurs in the string.
        static fn contains(s: string, sub: string) -> bool { return Str.indexOf(s, sub) >= 0; }
        // How many non-overlapping times `sub` occurs (0 for an empty `sub`).
        static fn count(s: string, sub: string) -> int { return %{ grav_str_count(s, sub) %} as int; }
        // Whether the string begins with `prefix`.
        static fn startsWith(s: string, prefix: string) -> bool {
            return %{ (strncmp(s, prefix, strlen(prefix)) == 0) %} as bool;
        }
        // Whether the string ends with `suffix`.
        static fn endsWith(s: string, suffix: string) -> bool { return %{ grav_str_ends(s, suffix) %} as bool; }

        // ── transforming (each returns a new string) ───────────────────────────
        // The two strings joined (same as a + b).
        static fn concat(a: string, b: string) -> string { return a + b; }
        // ASCII letters made uppercase.
        static fn upper(s: string) -> string { return %{ grav_str_upper(s) %} as string; }
        // ASCII letters made lowercase.
        static fn lower(s: string) -> string { return %{ grav_str_lower(s) %} as string; }
        // The first character made uppercase (ASCII).
        static fn capitalize(s: string) -> string { return %{ grav_str_capitalize(s) %} as string; }
        // The bytes in reverse order.
        static fn reverse(s: string) -> string { return %{ grav_str_reverse(s) %} as string; }
        // The string repeated n times ("" for n <= 0).
        static fn repeat(s: string, n: int) -> string { return %{ grav_str_repeat(s, n) %} as string; }
        // `len` bytes starting at `start` (bounds are clamped).
        static fn substring(s: string, start: int, len: int) -> string {
            return %{ grav_str_sub(s, start, len) %} as string;
        }
        // Characters [start, end) (bounds are clamped).
        static fn slice(s: string, start: int, end: int) -> string {
            return %{ grav_str_sub(s, start, end > start ? end - start : 0) %} as string;
        }
        // The string without the `len` bytes starting at `start`.
        static fn remove(s: string, start: int, len: int) -> string {
            return Str.substring(s, 0, start) + Str.substring(s, start + len, Str.length(s));
        }
        // The string without `prefix` at its start (unchanged when it does not start with it).
        static fn removePrefix(s: string, prefix: string) -> string {
            return Str.startsWith(s, prefix) ? Str.substring(s, Str.length(prefix), Str.length(s)) : Str.substring(s, 0, Str.length(s));
        }
        // The string without `suffix` at its end (unchanged when it does not end with it).
        static fn removeSuffix(s: string, suffix: string) -> string {
            let n = Str.length(s);
            return Str.endsWith(s, suffix) ? Str.substring(s, 0, n - Str.length(suffix)) : Str.substring(s, 0, n);
        }
        // Without whitespace at both ends.
        static fn trim(s: string) -> string { return %{ grav_str_trim(s, 1, 1) %} as string; }
        // Without whitespace at the start.
        static fn trimStart(s: string) -> string { return %{ grav_str_trim(s, 1, 0) %} as string; }
        // Without whitespace at the end.
        static fn trimEnd(s: string) -> string { return %{ grav_str_trim(s, 0, 1) %} as string; }
        // Every occurrence of `old` replaced by `repl`.
        static fn replace(s: string, old: string, repl: string) -> string {
            return %{ grav_str_replace(s, old, repl) %} as string;
        }
        // Pad to `len` characters with the first character of `ch` (a space if `ch` is empty).
        static fn padLeft(s: string, len: int, ch: string) -> string {
            return %{ grav_str_pad(s, len, ch[0] ? ch[0] : ' ', 1) %} as string;
        }
        // Padded on the right to `len` characters with the first character of `ch` (a space if empty).
        static fn padRight(s: string, len: int, ch: string) -> string {
            return %{ grav_str_pad(s, len, ch[0] ? ch[0] : ' ', 0) %} as string;
        }
        // Centered in `width` characters, padded with the first character of `ch` (a space if empty).
        static fn center(s: string, width: int, ch: string) -> string {
            return %{ grav_str_center(s, width, ch[0] ? ch[0] : ' ') %} as string;
        }

        // ── splitting and joining ──────────────────────────────────────────────
        // The parts between occurrences of `delim` ("a,,b" by "," gives "a", "", "b").
        static fn split(s: string, delim: string) -> Array<string> {
            if (delim.length == 0) { let one = new Array<string>(); one.push(s); return one; }
            return Str.pieces(s, delim, 0);
        }
        // Lines of text (handles \n and \r\n; no trailing empty line for a final newline).
        static fn lines(s: string) -> Array<string> { return Str.pieces(s, "", 2); }
        // Whitespace-separated words (no empty entries).
        static fn words(s: string) -> Array<string> { return Str.pieces(s, "", 1); }
        // The pieces of s (one pass; see grav_str_next_piece for the kinds).
        private static fn pieces(s: string, delim: string, kind: int) -> Array<string> {
            let out = new Array<string>();
            let n = s.length;
            let pos: long = 0;
            let a: long = 0;
            let b: long = 0;
            while (%{ grav_str_next_piece(s, n, delim, kind, &pos, &a, &b) %} as bool) {
                out.push(%{ grav_str_piece(s + a, (size_t)(b - a)) %} as string);
            }
            return out;
        }
        // Joins with one allocation (no quadratic copying).
        static fn join(parts: Array<string>, delim: string) -> string {
            let n = parts.size();
            if (n == 0) { return ""; }
            let ptrs = %{ (const char**)malloc(sizeof(const char*) * (size_t)n) %} as string*;
            for (i in 0..n) { ptrs[i] = parts.get(i); }
            let out = %{ grav_str_join(ptrs, n, delim) %} as string;
            free(ptrs);
            return out;
        }

        // ── more ───────────────────────────────────────────────────────────────
        // `s` with only the first occurrence of `old` replaced.
        static fn replaceFirst(s: string, old: string, repl: string) -> string {
            let i = Str.indexOf(s, old);
            if (i < 0 || old.length == 0) { return s; }
            return s[..i] + repl + s[i + old.length..];
        }
        // Split at `delim` into at most `limit` pieces (the last keeps the rest):
        // splitN("a=b=c", "=", 2) == ["a", "b=c"].
        static fn splitN(s: string, delim: string, limit: int) -> Array<string> {
            let out = new Array<string>();
            let start = 0;
            while (delim.length > 0 && (limit <= 0 || out.size() < limit - 1)) {
                let i = Str.indexFrom(s, delim, start);
                if (i < 0) { break; }
                out.push(s[start..i]);
                start = i + delim.length;
            }
            out.push(s[start..]);
            return out;
        }
        // The text before the first `sep`, or all of `s` when it does not contain one.
        static fn before(s: string, sep: string) -> string {
            let i = Str.indexOf(s, sep);
            return i < 0 ? s : s[..i];
        }
        // The text after the first `sep`, or "" when it does not contain one.
        static fn after(s: string, sep: string) -> string {
            let i = Str.indexOf(s, sep);
            return i < 0 ? "" : s[i + sep.length..];
        }
        // At most `max` characters, ending in "…" when it was cut.
        static fn truncate(s: string, max: int) -> string {
            let n = 0;
            for (ch in s) { n += 1; }
            if (n <= max) { return s; }
            if (max <= 0) { return ""; }
            let out = "";
            let k = 0;
            for (ch in s) {
                if (k >= max - 1) { break; }
                out += ch;
                k += 1;
            }
            return out + "…";
        }
        // The words of `s` re-flowed into lines of at most `width` characters
        // (a longer word gets a line of its own).
        static fn wrap(s: string, width: int) -> Array<string> {
            let lines = new Array<string>();
            let line = "";
            for (w in Str.words(s)) {
                if (line == "") { line = w; }
                else if (line.length + 1 + w.length <= width) { line += " " + w; }
                else { lines.push(line); line = w; }
            }
            if (line != "") { lines.push(line); }
            return lines;
        }
        // Each line of `s` prefixed with `prefix`.
        static fn indent(s: string, prefix: string) -> string {
            let lines = Str.lines(s);
            for (i in 0..lines.size()) { lines[i] = prefix + lines[i]; }
            return Str.join(lines, "\n");
        }
        // The words of an identifier or phrase: "parseHTTPRequest", "parse_http request"
        // and "parse-http" all split into lowercase words.
        static fn identifierWords(s: string) -> Array<string> {
            let out = new Array<string>();
            let cur = "";
            let n = s.length;
            for (i in 0..n) {
                let c = s[i];
                let upper = c >= 'A' && c <= 'Z';
                let alnum = upper || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9');
                if (!alnum) { if (cur != "") { out.push(cur); cur = ""; } continue; }
                // a new word starts at an uppercase letter after a lowercase one, or before
                // a lowercase one inside a run of capitals (HTTPRequest -> http, request)
                let prevLower = i > 0 && s[i - 1] >= 'a' && s[i - 1] <= 'z';
                let nextLower = i + 1 < n && s[i + 1] >= 'a' && s[i + 1] <= 'z';
                let prevUpper = i > 0 && s[i - 1] >= 'A' && s[i - 1] <= 'Z';
                if (upper && cur != "" && (prevLower || (prevUpper && nextLower))) { out.push(cur); cur = ""; }
                cur += Str.lower(s[i..i + 1]);
            }
            if (cur != "") { out.push(cur); }
            return out;
        }
        // snake_case: "parseHttpRequest" -> "parse_http_request".
        static fn toSnakeCase(s: string) -> string { return Str.join(Str.identifierWords(s), "_"); }
        // kebab-case: "parseHttpRequest" -> "parse-http-request".
        static fn toKebabCase(s: string) -> string { return Str.join(Str.identifierWords(s), "-"); }
        // camelCase: "parse_http_request" -> "parseHttpRequest".
        static fn toCamelCase(s: string) -> string {
            let out = "";
            for (i, w in Str.identifierWords(s)) { out += i == 0 ? w : Str.capitalize(w); }
            return out;
        }
        // PascalCase: "parse_http_request" -> "ParseHttpRequest".
        static fn toPascalCase(s: string) -> string {
            let out = "";
            for (w in Str.identifierWords(s)) { out += Str.capitalize(w); }
            return out;
        }
        // Every word capitalized: "the grav book" -> "The Grav Book".
        static fn titleCase(s: string) -> string {
            let out = "";
            let start = true;
            for (ch in s) {
                out += start ? Str.upper(ch) : ch;
                start = ch == " " || ch == "\t" || ch == "\n";
            }
            return out;
        }
        // The number of single-character edits (insert, delete, replace) that turn a
        // into b, counted in bytes: levenshtein("kitten", "sitting") == 3.
        static fn levenshtein(a: string, b: string) -> int {
            let m = a.length;
            let n = b.length;
            let prev = new Array<int>(n + 1);
            let cur = new Array<int>(n + 1);
            for (j in 0..=n) { prev.push(j); cur.push(0); }
            for (i in 1..=m) {
                cur[0] = i;
                for (j in 1..=n) {
                    let cost = a[i - 1] == b[j - 1] ? 0 : 1;
                    let best = prev[j] + 1;
                    if (cur[j - 1] + 1 < best) { best = cur[j - 1] + 1; }
                    if (prev[j - 1] + cost < best) { best = prev[j - 1] + cost; }
                    cur[j] = best;
                }
                let t = prev; prev = cur; cur = t;
            }
            return prev[n];
        }
        // The longest start that a and b share.
        static fn commonPrefix(a: string, b: string) -> string {
            let n = a.length < b.length ? a.length : b.length;
            let i = 0;
            while (i < n && a[i] == b[i]) { i += 1; }
            return a[..i];
        }
        // Whether `s` starts with `prefix`, ignoring case.
        static fn startsWithIgnoreCase(s: string, prefix: string) -> bool {
            return Str.startsWith(Str.lower(s), Str.lower(prefix));
        }
        // Whether `s` contains `sub`, ignoring case.
        static fn containsIgnoreCase(s: string, sub: string) -> bool {
            return Str.contains(Str.lower(s), Str.lower(sub));
        }
    }

}
