// lib/text/convert.grav — string -> value conversions, as static methods.
//
//   Format.toInt("42")  -> 42          (string -> value)
//   str(42)             -> "42"        (value  -> string; a builtin)
//
// There's only one class: the reverse direction (value -> string) is already the
// built-in `str(x)`, which works for every printable type, so no second class is
// needed. Numeric casts `int(x)` / `float(x)` / `bool(x)` are also built in.

import "../core/exception.grav"

namespace std.text {

    %{
    #include <stdlib.h>
    #include <string.h>
    #include <stdio.h>
    #include <ctype.h>
    #include <strings.h>
    #include <errno.h>
    /* Does `s` hold exactly one number (surrounding spaces allowed)? */
    static int grav_is_number(const char* s, int integer) {
        char* end = 0;
        if (integer) (void)strtoll(s, &end, 10); else (void)strtod(s, &end);
        if (end == s) return 0;
        while (*end && isspace((unsigned char)*end)) end++;
        return *end == 0;
    }
    static const char* grav_fmt_fixed(double x, int digits) {
        if (digits < 0) digits = 0;
        if (digits > 30) digits = 30;
        char buf[64]; snprintf(buf, sizeof buf, "%.*f", digits, x);
        size_t n = strlen(buf); char* r = grav_str_alloc(n + 1); memcpy(r, buf, n + 1); return r;
    }
    static const char* grav_fmt_grouped(long long v, char sep) {
        char digits[32]; snprintf(digits, sizeof digits, "%lld", v < 0 ? -v : v);
        size_t n = strlen(digits), groups = (n - 1) / 3;
        char* r = grav_str_alloc(n + groups + 2); char* w = r;
        if (v < 0) *w++ = '-';
        for (size_t i = 0; i < n; i++) { if (i && (n - i) % 3 == 0) *w++ = sep; *w++ = digits[i]; }
        *w = 0; return r;
    }
    static const char* grav_fmt_base(unsigned long long v, int base, const char* prefix) {
        char tmp[72]; int i = 70; tmp[71] = 0;
        if (v == 0) tmp[i--] = '0';
        while (v) { int d = (int)(v % (unsigned)base); tmp[i--] = (char)(d < 10 ? '0' + d : 'a' + d - 10); v /= (unsigned)base; }
        size_t pl = strlen(prefix), n = 70 - (size_t)i;
        char* r = grav_str_alloc(pl + n + 1); memcpy(r, prefix, pl); memcpy(r + pl, tmp + i + 1, n + 1); return r;
    }
    /* strtoll, noting (in *range) a value outside the 64-bit range. */
    static long long grav_parse_ll(const char* s, int* range) {
        errno = 0; long long v = strtoll(s, 0, 10);
        *range = errno == ERANGE; return v;
    }
    static long long grav_parse_base(const char* s, int base, int* ok) {
        char* end = 0; long long v = strtoll(s, &end, base);
        *ok = end != s && *end == 0; return v;
    }
    static const char* grav_to_hex(int n) {
        char* b = grav_str_alloc(20); snprintf(b, 20, "0x%x", (unsigned)n); return b;
    }
    %}

    // Parses strings into primitive values.
    class Format {
        // ---- string -> value ----
        // The integer parsers take a whole number (spaces around it are allowed) and
        // throw ValueError for anything else ("12a", "x", "") or a number that does not
        // fit the result type. toIntOr / isInt avoid the exception.
        static fn toInt(s: string) -> int {
            let v = Format.toLong(s)
            if (v < -2147483648 || v > 2147483647) { throw new ValueError("'${s}' is out of range for int") }
            return v
        }
        // Parses a whole number; ValueError when the text is not one or it does not fit in a long.
        static fn toLong(s: string) -> long {
            if (!Format.isInt(s)) { throw new ValueError("'${s}' is not an integer") }
            let range = 0
            let v = %{ grav_parse_ll(s, &range) %} as long
            if (range != 0) { throw new ValueError("'${s}' is out of range for long") }
            return v
        }
        // Parses a whole number into a uint; ValueError when it is negative or too big.
        static fn toUInt(s: string) -> uint {
            let v = Format.toLong(s)
            if (v < 0 || v > 4294967295) { throw new ValueError("'${s}' is out of range for uint") }
            return v
        }
        // Parses a whole number into a byte; ValueError outside 0..255.
        static fn toByte(s: string) -> byte {
            let v = Format.toLong(s)
            if (v < 0 || v > 255) { throw new ValueError("'${s}' is out of range for byte") }
            return v
        }
        // Parses a decimal number; ValueError when the text is not one.
        static fn toFloat(s: string) -> float {
            if (!Format.isNumber(s)) { throw new ValueError("'${s}' is not a number") }
            return %{ atof(s) %} as float;
        }
        // Parses a decimal number; ValueError when the text is not one.
        static fn toDouble(s: string) -> double { return Format.toFloat(s); }
        // true for "true", "1", "yes", "y", "on" (any case); false otherwise.
        static fn toBool(s: string) -> bool {
            return %{ (strcasecmp(s, "true") == 0 || strcmp(s, "1") == 0 || strcasecmp(s, "yes") == 0 ||
                       strcasecmp(s, "y") == 0 || strcasecmp(s, "on") == 0) %} as bool;
        }
        // Whether the text (spaces around allowed) is exactly one integer.
        static fn isInt(s: string) -> bool { return %{ grav_is_number(s, 1) %} as bool; }
        // Whether the text (spaces around allowed) is exactly one number.
        static fn isNumber(s: string) -> bool { return %{ grav_is_number(s, 0) %} as bool; }
        // Parse, or return `fallback` unless the whole text is a valid number.
        static fn toIntOr(s: string, fallback: int) -> int {
            let v = Format.toLongOr(s, -2147483649)
            return v < -2147483648 || v > 2147483647 ? fallback : v;
        }
        // Parses a long, or returns `fallback` unless the text is a valid long.
        static fn toLongOr(s: string, fallback: long) -> long {
            let range = 0
            let v = %{ grav_parse_ll(s, &range) %} as long
            return Format.isInt(s) && range == 0 ? v : fallback;
        }
        // Parses a float, or returns `fallback` unless the text is a valid number.
        static fn toFloatOr(s: string, fallback: float) -> float {
            return Format.isNumber(s) ? %{ atof(s) %} as float : fallback;
        }
        // Parse in another base: Format.parseInt("ff", 16) == 255 (fallback if invalid).
        static fn parseInt(s: string, base: int, fallback: long) -> long {
            let ok = 0;
            let v = %{ grav_parse_base(s, base, &ok) %} as long;
            return ok != 0 ? v : fallback;
        }

        // ---- value -> string ---- (str(x) is the general builtin; these read nicely)
        // The number as text (same as str(n)).
        static fn toStr(n: int) -> string { return str(n); }
        // The number in hexadecimal: 255 -> "0xff".
        static fn hex(n: int) -> string { return %{ grav_to_hex(n) %} as string; }
        // The number in binary: 5 -> "0b101".
        static fn binary(n: long) -> string { return %{ grav_fmt_base((unsigned long long)n, 2, "0b") %} as string; }
        // The number in octal: 8 -> "0o10".
        static fn octal(n: long) -> string { return %{ grav_fmt_base((unsigned long long)n, 8, "0o") %} as string; }
        // A float with exactly `digits` decimals: Format.fixed(3.14159, 2) == "3.14".
        static fn fixed(x: float, digits: int) -> string { return %{ grav_fmt_fixed(x, digits) %} as string; }
        // Thousands separators: Format.grouped(1234567) == "1,234,567".
        static fn grouped(n: long) -> string { return %{ grav_fmt_grouped(n, ',') %} as string; }
        // A ratio as a percentage: Format.percent(0.256, 1) == "25.6%".
        static fn percent(ratio: float, digits: int) -> string { return Format.fixed(ratio * 100.0, digits) + "%"; }
        // Bytes as a human-readable size: Format.bytes(1536) == "1.5 KB".
        static fn bytes(n: long) -> string {
            let units = ["B", "KB", "MB", "GB", "TB"];
            let v = n as float;
            let u = 0;
            while (v >= 1024.0 && u < 4) { v = v / 1024.0; u += 1; }
            return u == 0 ? "${n} B" : Format.fixed(v, 1) + " " + units[u];
        }

        // ---- numeric type conversions ----
        // The int as a float.
        static fn intToFloat(n: int) -> float { return n as float; }
        // The float as an int (the fraction is dropped).
        static fn floatToInt(f: float) -> int { return f as int; }
        // The int as a long.
        static fn intToLong(n: int) -> long { return n as long; }
        // The long as an int (wraps when out of range).
        static fn longToInt(n: long) -> int { return n as int; }
        // The low 8 bits of the int, as a byte.
        static fn intToByte(n: int) -> byte { return n as byte; }
        // The int as a double.
        static fn intToDouble(n: int) -> double { return n as double; }

        // ---- string <-> binary ----
        // The string's bytes as a binary value.
        static fn toBinary(s: string) -> binary { return s as binary; }
        // The bytes as a string (up to the first zero byte).
        static fn fromBinary(b: binary) -> string { return b as string; }
    }

}
