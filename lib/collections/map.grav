// lib/collections/map.grav — a generic Map over parallel key/value arrays (linear lookup,
// insertion-ordered). For large maps prefer HashMap<K,V> (lib/hashmap.grav).
import "../core/exception.grav"
import "array.grav"

namespace std.collections {

    class Map<K, V> {
        private ks: Array<K>
        private vs: Array<V>
        constructor() { self.ks = new Array<K>(); self.vs = new Array<V>(); }
        destructor() { free(self.ks); free(self.vs); }

        public fn put(key: K, value: V) {
            let i = self.ks.indexOf(key);
            if (i >= 0) { self.vs.set(i, value); } else { self.ks.push(key); self.vs.push(value); }
        }
        public fn get(key: K) -> V {
            let i = self.ks.indexOf(key);
            if (i < 0) { throw new NotFound("Map.get: key not found"); }
            return self.vs.get(i);
        }
        fn operator[](key: K) -> V { return self.get(key); }
        fn operator[]=(key: K, value: V) { self.put(key, value); }
        public fn getOr(key: K, fallback: V) -> V {
            let i = self.ks.indexOf(key);
            return i >= 0 ? self.vs.get(i) : fallback;
        }
        public fn containsKey(key: K) -> bool { return self.ks.indexOf(key) >= 0; }
        public fn remove(key: K) -> bool {
            let i = self.ks.indexOf(key);
            if (i < 0) { return false; }
            self.ks.removeAt(i);
            self.vs.removeAt(i);
            return true;
        }
        public fn size() -> int { return self.ks.size(); }
        public fn length() -> int { return self.ks.size(); }
        public fn isEmpty() -> bool { return self.ks.isEmpty(); }
        public fn clear() { self.ks.clear(); self.vs.clear(); }
        // Copies, in insertion order (changing them does not affect the map).
        // As text: {"a": 1, "b": 2} (strings in quotes).
        public fn toString() -> string {
            let ks = self.keys()
            let out = "{"
            for (i in 0..ks.size()) {
                if (i > 0) { out += ", " }
                out += __repr(ks.get(i)) + ": " + __repr(self.get(ks.get(i)))
            }
            return out + "}"
        }
        public fn keys() -> Array<K> { return self.ks.copy(); }
        public fn values() -> Array<V> { return self.vs.copy(); }
        public fn forEach(f: fn(K, V)) { for (i in 0..self.ks.size()) { f(self.ks.get(i), self.vs.get(i)); } }
        // The value for `key`, inserting `fallback` first when absent.
        public fn getOrPut(key: K, fallback: V) -> V {
            let i = self.ks.indexOf(key);
            if (i >= 0) { return self.vs.get(i); }
            self.ks.push(key);
            self.vs.push(fallback);
            return fallback;
        }
    }

}
