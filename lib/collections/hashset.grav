// lib/collections/hashset.grav — HashSet<T>: an unordered set with O(1) average add,
// contains, and remove, for any element type HashMap accepts as a key.
//
//   let seen = new HashSet<string>()
//   if (seen.add(word)) { print("first time: ${word}") }
import "hashmap.grav"

namespace std.collections {

    class HashSet<T> {
        private m: HashMap<T, bool>
        constructor() { self.m = new HashMap<T, bool>(); }
        destructor() { free(self.m); }

        // Adds `item` unless present; reports whether it was added.
        public fn add(item: T) -> bool {
            if (self.m.containsKey(item)) { return false; }
            self.m.put(item, true);
            return true;
        }
        public fn addAll(items: Array<T>) { for (x in items) { self.add(x); } }
        public fn contains(item: T) -> bool { return self.m.containsKey(item); }
        public fn remove(item: T) -> bool { return self.m.remove(item); }
        public fn size() -> int { return self.m.size(); }
        public fn length() -> int { return self.m.size(); }
        public fn isEmpty() -> bool { return self.m.isEmpty(); }
        public fn clear() { self.m.clear(); }
        public fn toArray() -> Array<T> { return self.m.keys(); }
        public fn forEach(f: fn(T)) { self.m.forEach(fn(k, v) => f(k)); }

        public fn union(other: HashSet<T>) -> HashSet<T> {
            let r = new HashSet<T>();
            let mine = self.toArray();
            let theirs = other.toArray();
            for (x in mine) { r.add(x); }
            for (x in theirs) { r.add(x); }
            free(mine);
            free(theirs);
            return r;
        }
        public fn intersect(other: HashSet<T>) -> HashSet<T> {
            let r = new HashSet<T>();
            let mine = self.toArray();
            for (x in mine) { if (other.contains(x)) { r.add(x); } }
            free(mine);
            return r;
        }
        public fn difference(other: HashSet<T>) -> HashSet<T> {
            let r = new HashSet<T>();
            let mine = self.toArray();
            for (x in mine) { if (!other.contains(x)) { r.add(x); } }
            free(mine);
            return r;
        }
        public fn isSubsetOf(other: HashSet<T>) -> bool {
            let mine = self.toArray();
            let ok = mine.all(fn(x) => other.contains(x));
            free(mine);
            return ok;
        }
    }

}
