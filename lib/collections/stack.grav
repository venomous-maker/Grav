// lib/collections/stack.grav — Stack<T> (LIFO, over Array) and Queue<T> (FIFO, over a ring
// buffer — every operation is O(1)).
import "../core/exception.grav"
import "array.grav"
import "deque.grav"

namespace std.collections {

    class Stack<T> {
        private items: Array<T>
        constructor() { self.items = new Array<T>(); }
        destructor() { free(self.items); }
        // Puts an element on top.
        public fn push(item: T) { self.items.push(item); }
        // Removes and returns the top element (StateError when empty).
        public fn pop() -> T {
            if (self.items.isEmpty()) { throw new StateError("Stack.pop on an empty stack"); }
            return self.items.pop();
        }
        // The top element, left in place (StateError when empty).
        public fn peek() -> T {
            if (self.items.isEmpty()) { throw new StateError("Stack.peek on an empty stack"); }
            return self.items.last();
        }
        // The top element, or `fallback` when empty.
        public fn peekOr(fallback: T) -> T { return self.items.isEmpty() ? fallback : self.items.last(); }
        // The number of elements.
        public fn size() -> int { return self.items.size(); }
        // The number of elements (same as size()).
        public fn length() -> int { return self.items.size(); }
        // Whether the stack is empty.
        public fn isEmpty() -> bool { return self.items.isEmpty(); }
        // Removes every element.
        public fn clear() { self.items.clear(); }
        // Whether some element equals `item`.
        public fn contains(item: T) -> bool { return self.items.contains(item); }
        // Index 0 is the bottom of the stack.
        public fn get(i: int) -> T { return self.items.get(i); }
        // Calls f on each element, bottom first.
        public fn forEach(f: fn(T)) { self.items.forEach(f); }
        // As text: [1, 2, 3] (strings in quotes).
        public fn toString() -> string { return self.items.toString() }
        // The elements as a new Array, bottom first.
        public fn toArray() -> Array<T> { return self.items.copy(); }
    }

    class Queue<T> {
        private items: Deque<T>
        constructor() { self.items = new Deque<T>(); }
        destructor() { free(self.items); }
        // Adds an element at the back.
        public fn enqueue(item: T) { self.items.pushBack(item); }
        // Removes and returns the front element (StateError when empty).
        public fn dequeue() -> T {
            if (self.items.isEmpty()) { throw new StateError("Queue.dequeue on an empty queue"); }
            return self.items.popFront();
        }
        // The front element, left in place (StateError when empty).
        public fn peek() -> T {
            if (self.items.isEmpty()) { throw new StateError("Queue.peek on an empty queue"); }
            return self.items.peekFront();
        }
        // The front element, or `fallback` when empty.
        public fn peekOr(fallback: T) -> T { return self.items.isEmpty() ? fallback : self.items.peekFront(); }
        // The number of elements.
        public fn size() -> int { return self.items.size(); }
        // The number of elements (same as size()).
        public fn length() -> int { return self.items.size(); }
        // Whether the queue is empty.
        public fn isEmpty() -> bool { return self.items.isEmpty(); }
        // Removes every element.
        public fn clear() { self.items.clear(); }
        // Whether some element equals `item`.
        public fn contains(item: T) -> bool { return self.items.contains(item); }
        // Index 0 is the front (next to dequeue).
        public fn get(i: int) -> T { return self.items.get(i); }
        // Calls f on each element, front first.
        public fn forEach(f: fn(T)) { self.items.forEach(f); }
        // As text: [1, 2, 3] (strings in quotes).
        public fn toString() -> string { return self.items.toString() }
        // The elements as a new Array, front first.
        public fn toArray() -> Array<T> { return self.items.toArray(); }
    }

}
