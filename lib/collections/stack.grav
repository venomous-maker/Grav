// lib/collections/stack.grav — Stack<T> (LIFO, over Array) and Queue<T> (FIFO, over a ring
// buffer — every operation is O(1)).
import "array.grav"
import "deque.grav"

namespace std.collections {

    class Stack<T> {
        private items: Array<T>
        constructor() { self.items = new Array<T>(); }
        destructor() { free(self.items); }
        public fn push(item: T) { self.items.push(item); }
        public fn pop() -> T {
            if (self.items.isEmpty()) { panic("Stack.pop on an empty stack"); }
            return self.items.pop();
        }
        public fn peek() -> T {
            if (self.items.isEmpty()) { panic("Stack.peek on an empty stack"); }
            return self.items.last();
        }
        public fn peekOr(fallback: T) -> T { return self.items.isEmpty() ? fallback : self.items.last(); }
        public fn size() -> int { return self.items.size(); }
        public fn length() -> int { return self.items.size(); }
        public fn isEmpty() -> bool { return self.items.isEmpty(); }
        public fn clear() { self.items.clear(); }
        public fn contains(item: T) -> bool { return self.items.contains(item); }
        // Index 0 is the bottom of the stack.
        public fn get(i: int) -> T { return self.items.get(i); }
        public fn forEach(f: fn(T)) { self.items.forEach(f); }
        public fn toArray() -> Array<T> { return self.items.copy(); }
    }

    class Queue<T> {
        private items: Deque<T>
        constructor() { self.items = new Deque<T>(); }
        destructor() { free(self.items); }
        public fn enqueue(item: T) { self.items.pushBack(item); }
        public fn dequeue() -> T {
            if (self.items.isEmpty()) { panic("Queue.dequeue on an empty queue"); }
            return self.items.popFront();
        }
        public fn peek() -> T {
            if (self.items.isEmpty()) { panic("Queue.peek on an empty queue"); }
            return self.items.peekFront();
        }
        public fn peekOr(fallback: T) -> T { return self.items.isEmpty() ? fallback : self.items.peekFront(); }
        public fn size() -> int { return self.items.size(); }
        public fn length() -> int { return self.items.size(); }
        public fn isEmpty() -> bool { return self.items.isEmpty(); }
        public fn clear() { self.items.clear(); }
        public fn contains(item: T) -> bool { return self.items.contains(item); }
        // Index 0 is the front (next to dequeue).
        public fn get(i: int) -> T { return self.items.get(i); }
        public fn forEach(f: fn(T)) { self.items.forEach(f); }
        public fn toArray() -> Array<T> { return self.items.toArray(); }
    }

}
