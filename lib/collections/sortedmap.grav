// lib/collections/sortedmap.grav — SortedMap<K,V>: keys kept in order by a comparison
// function (binary search: O(log n) lookup, O(n) insert/remove). Iterate keys()
// in order, ask for the first/last key, or the keys in a range.
//
//   let ages = new SortedMap<string, int>(fn(a, b) => Str.compare(a, b))
import "../core/exception.grav"
import "array.grav"

namespace std.collections {

    class SortedMap<K, V> {
        private ks: Array<K>
        private vs: Array<V>
        private cmp: fn(K, K) -> int

        constructor(cmp: fn(K, K) -> int) { self.ks = new Array<K>(); self.vs = new Array<V>(); self.cmp = cmp; }
        destructor() { free(self.ks); free(self.vs); }

        // Index of `key`, or -(insertion point) - 1 when absent.
        private fn find(key: K) -> int {
            let lo = 0;
            let hi = self.ks.size() - 1;
            while (lo <= hi) {
                let mid = (lo + hi) / 2;
                let c = self.cmp(self.ks[mid], key);
                if (c == 0) { return mid; }
                if (c < 0) { lo = mid + 1; } else { hi = mid - 1; }
            }
            return -(lo + 1);
        }

        // Sets the value for `key` (adding it in order, or replacing its value).
        public fn put(key: K, value: V) {
            let i = self.find(key);
            if (i >= 0) { self.vs[i] = value; return; }
            let at = -(i + 1);
            self.ks.insert(at, key);
            self.vs.insert(at, value);
        }
        // The value for `key` (NotFound when missing).
        public fn get(key: K) -> V {
            let i = self.find(key);
            if (i < 0) { throw new NotFound("SortedMap.get: key not found"); }
            return self.vs[i];
        }
        // The value for `key`, or `fallback` when missing.
        public fn getOr(key: K, fallback: V) -> V {
            let i = self.find(key);
            return i >= 0 ? self.vs[i] : fallback;
        }
        // `m[key]`: the value for key (NotFound when missing).
        fn operator[](key: K) -> V { return self.get(key); }
        // `m[key] = value`: sets the value for key.
        fn operator[]=(key: K, value: V) { self.put(key, value); }
        // Whether the map has `key`.
        public fn containsKey(key: K) -> bool { return self.find(key) >= 0; }
        // Removes `key`; whether it was there.
        public fn remove(key: K) -> bool {
            let i = self.find(key);
            if (i < 0) { return false; }
            self.ks.removeAt(i);
            self.vs.removeAt(i);
            return true;
        }
        // The number of keys.
        public fn size() -> int { return self.ks.size(); }
        // The number of keys (same as size()).
        public fn length() -> int { return self.ks.size(); }
        // Whether the map is empty.
        public fn isEmpty() -> bool { return self.ks.isEmpty(); }
        // Removes every key.
        public fn clear() { self.ks.clear(); self.vs.clear(); }

        // The smallest key (IndexError when empty).
        public fn firstKey() -> K { return self.ks.first(); }
        // The largest key (IndexError when empty).
        public fn lastKey() -> K { return self.ks.last(); }
        // Keys and values in key order (copies).
        // As text: {"a": 1, "b": 2} (strings in quotes).
        public fn toString() -> string {
            let ks = self.keys()
            let out = "{"
            for (i in 0..ks.size()) {
                if (i > 0) { out += ", " }
                out += __repr(ks.get(i)) + ": " + __repr(self.get(ks.get(i)))
            }
            return out + "}"
        }
        // The keys in order (a copy).
        public fn keys() -> Array<K> { return self.ks.copy(); }
        // The values in key order (a copy).
        public fn values() -> Array<V> { return self.vs.copy(); }
        // Keys k with lo <= k < hi, in order.
        public fn keysBetween(lo: K, hi: K) -> Array<K> {
            let out = new Array<K>();
            let i = self.find(lo);
            let start = i >= 0 ? i : -(i + 1);
            for (j in start..self.ks.size()) {
                if (self.cmp(self.ks[j], hi) >= 0) { break; }
                out.push(self.ks[j]);
            }
            return out;
        }
        // Calls f with each key and value, in key order.
        public fn forEach(f: fn(K, V)) { for (i in 0..self.ks.size()) { f(self.ks[i], self.vs[i]); } }
    }

}
