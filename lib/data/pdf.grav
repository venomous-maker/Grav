// pdf.grav — PDF documents written from code: text in the standard fonts or an embedded
// TrueType font (any Unicode), wrapped paragraphs, lines, rectangles and circles, images
// (PNG-style pixels or JPEG files as they are), QR codes as vectors, links, and tables that
// flow onto new pages with their header repeated.
//
//   let doc = new PdfDocument()                    // A4; PdfDocument(612, 792) is US Letter
//   doc.title = "Invoice INV-0042"
//   let page = doc.addPage()
//   page.setFont(doc.font("Helvetica-Bold"), 18).text(50, 50, "Invoice INV-0042")
//   page.setFont(doc.font("Helvetica"), 10).textBox(50, 80, 300, notes)
//   let t = new PdfTable([250, 80, 120]).header(["Item", "Qty", "Amount"]).alignRight(1).alignRight(2)
//   t.row(["Hosting", "12", "KES 14,400.00"])
//   doc.table(t, page, 50, 140)                    // continues on new pages when it must
//   doc.save("invoice.pdf")
//
// Coordinates are points (1/72 inch) from the top-left corner of the page, y downward;
// text is placed by the top of its line. The standard fonts (Helvetica, Times, Courier,
// each with Bold and Oblique/Italic) need nothing embedded and cover Western European text
// (Windows-1252); loadFont("DejaVuSans.ttf") embeds a TrueType font for everything else.
// Content streams, pixel images and fonts are compressed with zlib when it is present.
import "../core/exception.grav"
import "../collections/array.grav"
import "../collections/hashmap.grav"
import "../text/strbuf.grav"
import "../text/string.grav"
import "bytes.grav"
import "compress.grav"
import "image.grav"
import "qrcode.grav"

namespace std.data {
    %{
    #include <stdlib.h>
    #include <string.h>
    #include <stdio.h>
    #include <math.h>

