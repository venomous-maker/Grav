// lib/data/hash.grav — checksums and cryptographic hashes, and UUIDs.
//
//   Hash.sha256("abc")     // "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
//   Hash.crc32("hello")    // 907060870
//   Uuid.v4()              // "3f2b9c1e-8d4a-4f6b-9a2e-7c1d5e8f0a3b" (random)
//
// SHA-256 is the one to use for integrity and fingerprints. MD5 and SHA-1 are
// broken for security and are here for compatibility with existing formats.
// CRC-32 and FNV-1a are fast checksums, not security hashes.
import "../core/exception.grav"
import "bytes.grav"

namespace std.data {

    %{
    #include <stdint.h>
    #include <string.h>
    #include <stdio.h>
    #include <fcntl.h>
    #include <unistd.h>

    static const char* grav_hash_hex(const unsigned char* d, int n) {
        static const char* x = "0123456789abcdef";
        char* r = grav_str_new((size_t)(n * 2));
        for (int i = 0; i < n; i++) { r[2 * i] = x[d[i] >> 4]; r[2 * i + 1] = x[d[i] & 15]; }
        r[2 * n] = 0; return r;
    }

    /* ---- SHA-256 (FIPS 180-4) ---- */
    static const uint32_t grav_h_k256[64] = {
        0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
        0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
        0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
        0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
        0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
        0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
        0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
        0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2};
    #define GRAV_ROR(x, n) (((x) >> (n)) | ((x) << (32 - (n))))
    static void grav_h_sha256_block(uint32_t h[8], const unsigned char* p) {
        uint32_t w[64];
        for (int i = 0; i < 16; i++) w[i] = (uint32_t)p[4*i] << 24 | (uint32_t)p[4*i+1] << 16 | (uint32_t)p[4*i+2] << 8 | p[4*i+3];
        for (int i = 16; i < 64; i++) {
            uint32_t s0 = GRAV_ROR(w[i-15], 7) ^ GRAV_ROR(w[i-15], 18) ^ (w[i-15] >> 3);
            uint32_t s1 = GRAV_ROR(w[i-2], 17) ^ GRAV_ROR(w[i-2], 19) ^ (w[i-2] >> 10);
            w[i] = w[i-16] + s0 + w[i-7] + s1;
        }
        uint32_t a=h[0],b=h[1],c=h[2],d=h[3],e=h[4],f=h[5],g=h[6],k=h[7];
        for (int i = 0; i < 64; i++) {
            uint32_t S1 = GRAV_ROR(e, 6) ^ GRAV_ROR(e, 11) ^ GRAV_ROR(e, 25);
            uint32_t t1 = k + S1 + ((e & f) ^ (~e & g)) + grav_h_k256[i] + w[i];
            uint32_t S0 = GRAV_ROR(a, 2) ^ GRAV_ROR(a, 13) ^ GRAV_ROR(a, 22);
            uint32_t t2 = S0 + ((a & b) ^ (a & c) ^ (b & c));
            k = g; g = f; f = e; e = d + t1; d = c; c = b; b = a; a = t1 + t2;
        }
        h[0]+=a; h[1]+=b; h[2]+=c; h[3]+=d; h[4]+=e; h[5]+=f; h[6]+=g; h[7]+=k;
    }
    /* Merkle–Damgård padding shared by SHA-1 and SHA-256 (big-endian length). */
    static void grav_h_md_pad(const unsigned char* p, size_t n, void (*block)(uint32_t*, const unsigned char*), uint32_t* h) {
        size_t i = 0;
        for (; i + 64 <= n; i += 64) block(h, p + i);
        unsigned char tail[128] = {0};
        size_t r = n - i;
        memcpy(tail, p + i, r);
        tail[r] = 0x80;
        size_t total = r + 1 + 8 <= 64 ? 64 : 128;
        uint64_t bits = (uint64_t)n * 8;
        for (int k = 0; k < 8; k++) tail[total - 1 - k] = (unsigned char)(bits >> (8 * k));
        block(h, tail);
        if (total == 128) block(h, tail + 64);
    }
    static const char* grav_h_sha256(const unsigned char* p, size_t n) {
        uint32_t h[8] = {0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19};
        grav_h_md_pad(p, n, grav_h_sha256_block, h);
        unsigned char d[32];
        for (int i = 0; i < 8; i++) { d[4*i] = h[i] >> 24; d[4*i+1] = h[i] >> 16; d[4*i+2] = h[i] >> 8; d[4*i+3] = h[i]; }
        return grav_hash_hex(d, 32);
    }

    /* ---- SHA-1 (legacy) ---- */
    #define GRAV_ROL(x, n) (((x) << (n)) | ((x) >> (32 - (n))))
    static void grav_h_sha1_block(uint32_t h[5], const unsigned char* p) {
        uint32_t w[80];
        for (int i = 0; i < 16; i++) w[i] = (uint32_t)p[4*i] << 24 | (uint32_t)p[4*i+1] << 16 | (uint32_t)p[4*i+2] << 8 | p[4*i+3];
        for (int i = 16; i < 80; i++) w[i] = GRAV_ROL(w[i-3] ^ w[i-8] ^ w[i-14] ^ w[i-16], 1);
        uint32_t a=h[0],b=h[1],c=h[2],d=h[3],e=h[4];
        for (int i = 0; i < 80; i++) {
            uint32_t f, k;
            if (i < 20) { f = (b & c) | (~b & d); k = 0x5A827999; }
            else if (i < 40) { f = b ^ c ^ d; k = 0x6ED9EBA1; }
            else if (i < 60) { f = (b & c) | (b & d) | (c & d); k = 0x8F1BBCDC; }
            else { f = b ^ c ^ d; k = 0xCA62C1D6; }
            uint32_t t = GRAV_ROL(a, 5) + f + e + k + w[i];
            e = d; d = c; c = GRAV_ROL(b, 30); b = a; a = t;
        }
        h[0]+=a; h[1]+=b; h[2]+=c; h[3]+=d; h[4]+=e;
    }
    static const char* grav_h_sha1(const unsigned char* p, size_t n) {
        uint32_t h[5] = {0x67452301,0xEFCDAB89,0x98BADCFE,0x10325476,0xC3D2E1F0};
        grav_h_md_pad(p, n, grav_h_sha1_block, h);
        unsigned char d[20];
        for (int i = 0; i < 5; i++) { d[4*i] = h[i] >> 24; d[4*i+1] = h[i] >> 16; d[4*i+2] = h[i] >> 8; d[4*i+3] = h[i]; }
        return grav_hash_hex(d, 20);
    }

    /* ---- MD5 (legacy; little-endian) ---- */
    static void grav_h_md5_block(uint32_t h[4], const unsigned char* p) {
        static const uint32_t K[64] = {
            0xd76aa478,0xe8c7b756,0x242070db,0xc1bdceee,0xf57c0faf,0x4787c62a,0xa8304613,0xfd469501,
            0x698098d8,0x8b44f7af,0xffff5bb1,0x895cd7be,0x6b901122,0xfd987193,0xa679438e,0x49b40821,
            0xf61e2562,0xc040b340,0x265e5a51,0xe9b6c7aa,0xd62f105d,0x02441453,0xd8a1e681,0xe7d3fbc8,
            0x21e1cde6,0xc33707d6,0xf4d50d87,0x455a14ed,0xa9e3e905,0xfcefa3f8,0x676f02d9,0x8d2a4c8a,
            0xfffa3942,0x8771f681,0x6d9d6122,0xfde5380c,0xa4beea44,0x4bdecfa9,0xf6bb4b60,0xbebfbc70,
            0x289b7ec6,0xeaa127fa,0xd4ef3085,0x04881d05,0xd9d4d039,0xe6db99e5,0x1fa27cf8,0xc4ac5665,
            0xf4292244,0x432aff97,0xab9423a7,0xfc93a039,0x655b59c3,0x8f0ccc92,0xffeff47d,0x85845dd1,
            0x6fa87e4f,0xfe2ce6e0,0xa3014314,0x4e0811a1,0xf7537e82,0xbd3af235,0x2ad7d2bb,0xeb86d391};
        static const int S[64] = {7,12,17,22,7,12,17,22,7,12,17,22,7,12,17,22,5,9,14,20,5,9,14,20,5,9,14,20,5,9,14,20,
                                  4,11,16,23,4,11,16,23,4,11,16,23,4,11,16,23,6,10,15,21,6,10,15,21,6,10,15,21,6,10,15,21};
        uint32_t m[16];
        for (int i = 0; i < 16; i++) m[i] = (uint32_t)p[4*i] | (uint32_t)p[4*i+1] << 8 | (uint32_t)p[4*i+2] << 16 | (uint32_t)p[4*i+3] << 24;
        uint32_t a=h[0],b=h[1],c=h[2],d=h[3];
        for (int i = 0; i < 64; i++) {
            uint32_t f; int g;
            if (i < 16) { f = (b & c) | (~b & d); g = i; }
            else if (i < 32) { f = (d & b) | (~d & c); g = (5*i + 1) % 16; }
            else if (i < 48) { f = b ^ c ^ d; g = (3*i + 5) % 16; }
            else { f = c ^ (b | ~d); g = (7*i) % 16; }
            uint32_t t = d; d = c; c = b;
            b = b + GRAV_ROL(a + f + K[i] + m[g], S[i]);
            a = t;
        }
        h[0]+=a; h[1]+=b; h[2]+=c; h[3]+=d;
    }
    static const char* grav_h_md5(const unsigned char* p, size_t n) {
        uint32_t h[4] = {0x67452301,0xefcdab89,0x98badcfe,0x10325476};
        size_t i = 0;
        for (; i + 64 <= n; i += 64) grav_h_md5_block(h, p + i);
        unsigned char tail[128] = {0};
        size_t r = n - i;
        memcpy(tail, p + i, r);
        tail[r] = 0x80;
        size_t total = r + 1 + 8 <= 64 ? 64 : 128;
        uint64_t bits = (uint64_t)n * 8;
        for (int k = 0; k < 8; k++) tail[total - 8 + k] = (unsigned char)(bits >> (8 * k));
        grav_h_md5_block(h, tail);
        if (total == 128) grav_h_md5_block(h, tail + 64);
        unsigned char d[16];
        for (int k = 0; k < 4; k++) { d[4*k] = h[k]; d[4*k+1] = h[k] >> 8; d[4*k+2] = h[k] >> 16; d[4*k+3] = h[k] >> 24; }
        return grav_hash_hex(d, 16);
    }

    /* ---- CRC-32 (IEEE, as in zip and PNG) and FNV-1a ---- */
    static long long grav_h_crc32(const unsigned char* p, size_t n) {
        static uint32_t table[256];
        static int ready = 0;                       /* filled once; racing threads write the same values */
        if (!__atomic_load_n(&ready, __ATOMIC_ACQUIRE)) {
            for (uint32_t i = 0; i < 256; i++) {
                uint32_t c = i;
                for (int k = 0; k < 8; k++) c = (c >> 1) ^ (0xEDB88320u & (0u - (c & 1u)));
                table[i] = c;
            }
            __atomic_store_n(&ready, 1, __ATOMIC_RELEASE);
        }
        uint32_t c = 0xFFFFFFFFu;
        for (size_t i = 0; i < n; i++) c = table[(c ^ p[i]) & 0xFF] ^ (c >> 8);
        return (long long)(c ^ 0xFFFFFFFFu);
    }
    static long long grav_h_fnv1a(const unsigned char* p, size_t n) {
        uint64_t h = 1469598103934665603ULL;
        for (size_t i = 0; i < n; i++) { h ^= p[i]; h *= 1099511628211ULL; }
        return (long long)h;
    }

    /* Random bytes from the operating system (for UUIDs and tokens). */
    static void grav_h_os_random(unsigned char* buf, size_t n) {
        int fd = open("/dev/urandom", O_RDONLY);
        size_t got = 0;
        if (fd >= 0) { while (got < n) { ssize_t r = read(fd, buf + got, n - got); if (r <= 0) break; got += (size_t)r; } close(fd); }
        for (; got < n; got++) buf[got] = (unsigned char)(rand() & 0xFF);   /* never happens on Linux */
    }
    static const char* grav_h_uuid4(void) {
        unsigned char b[16];
        grav_h_os_random(b, 16);
        b[6] = (b[6] & 0x0F) | 0x40;      /* version 4 */
        b[8] = (b[8] & 0x3F) | 0x80;      /* RFC 4122 variant */
        char* r = grav_str_new(36);
        snprintf(r, 37, "%02x%02x%02x%02x-%02x%02x-%02x%02x-%02x%02x-%02x%02x%02x%02x%02x%02x",
                 b[0],b[1],b[2],b[3],b[4],b[5],b[6],b[7],b[8],b[9],b[10],b[11],b[12],b[13],b[14],b[15]);
        return r;
    }
    static const char* grav_h_random_token(int n) {
        unsigned char b[256];
        if (n > 256) n = 256;
        if (n < 0) n = 0;
        grav_h_os_random(b, (size_t)n);
        return grav_hash_hex(b, n);
    }
    %}

    // Hashes and checksums of text or bytes. The hash functions return lowercase hex.
    class Hash {
        // SHA-256 of the string's bytes, as 64 hex digits.
        static fn sha256(s: string) -> string { return %{ grav_h_sha256((const unsigned char*)s, strlen(s)) %} as string }
        // SHA-256 of raw bytes, as 64 hex digits.
        static fn sha256Bytes(b: Bytes) -> string {
            let p = b.rawData()
            let n = b.size()
            return %{ grav_h_sha256(p, (size_t)n) %} as string
        }
        // SHA-1 of the string's bytes, as 40 hex digits (legacy: not for security).
        static fn sha1(s: string) -> string { return %{ grav_h_sha1((const unsigned char*)s, strlen(s)) %} as string }
        // MD5 of the string's bytes, as 32 hex digits (legacy: not for security).
        static fn md5(s: string) -> string { return %{ grav_h_md5((const unsigned char*)s, strlen(s)) %} as string }
        // MD5 of raw bytes, as 32 hex digits (legacy: not for security).
        static fn md5Bytes(b: Bytes) -> string {
            let p = b.rawData()
            let n = b.size()
            return %{ grav_h_md5(p, (size_t)n) %} as string
        }
        // CRC-32 checksum (the one zip, gzip and PNG use), from 0 to 4294967295.
        static fn crc32(s: string) -> long { return %{ grav_h_crc32((const unsigned char*)s, strlen(s)) %} as long }
        // CRC-32 checksum of raw bytes.
        static fn crc32Bytes(b: Bytes) -> long {
            let p = b.rawData()
            let n = b.size()
            return %{ grav_h_crc32(p, (size_t)n) %} as long
        }
        // FNV-1a, a fast 64-bit hash for hash tables and fingerprints (not for security).
        static fn fnv1a(s: string) -> long { return %{ grav_h_fnv1a((const unsigned char*)s, strlen(s)) %} as long }
        // `n` random bytes from the operating system, as 2n hex digits: for session ids,
        // tokens and nonces (n is at most 256).
        static fn randomToken(n: int) -> string { return %{ grav_h_random_token(n) %} as string }
    }

    // Universally unique identifiers (RFC 4122).
    class Uuid {
        // A random (version 4) UUID such as "3f2b9c1e-8d4a-4f6b-9a2e-7c1d5e8f0a3b",
        // from the operating system's random source.
        static fn v4() -> string { return %{ grav_h_uuid4() %} as string }
        // The all-zero UUID.
        static fn nil() -> string { return "00000000-0000-0000-0000-000000000000" }
        // Whether `s` has the form xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx (hex digits, any case).
        static fn isValid(s: string) -> bool {
            if (s.length != 36) { return false }
            for (i in 0..36) {
                let c = s[i]
                if (i == 8 || i == 13 || i == 18 || i == 23) {
                    if (c != '-') { return false }
                } else if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F'))) {
                    return false
                }
            }
            return true
        }
    }
}
