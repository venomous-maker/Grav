// lib/data/semver.grav — semantic versions (semver.org 2.0): parsing,
// ordering (prereleases before their release, numeric parts as numbers) and
// ranges in npm's syntax:
//
//   Semver.parse("1.4.0-rc.1") < Semver.parse("1.4.0")     (compare() < 0)
//   Semver.satisfies("1.4.2", "^1.2")                       // true
//   Semver.satisfies("2.0.0", ">=1.0 <2.0 || =3.0.0")       // false
//   Semver.maxSatisfying(["1.2.0", "1.9.9", "2.1.0"], "~1.9")   // "1.9.9"
//
// Ranges: =, >, >=, <, <=, ^ (same leftmost non-zero part), ~ (same minor,
// or major when only that is given), x/X/* wildcards ("1.x"), hyphen ranges
// ("1.2 - 1.4"), space for "and", || for "or". A version with a prerelease
// satisfies a range only if a comparator names the same major.minor.patch
// with a prerelease (as npm does), so "^1.0" does not pick "2.0.0-beta".
import "../core/exception.grav"
import "../text/string.grav"
import "../collections/array.grav"
import "../types/integer.grav"

namespace std.data {

    class Semver {
        public major: long
        public minor: long
        public patch: long
        // "rc.1" in 1.0.0-rc.1, split at dots ([] for a release).
        public prerelease: Array<string> = new Array<string>()
        // "build.5" in 1.0.0+build.5 (ignored when ordering).
        public build: string = ""
        constructor(major: long, minor: long, patch: long) { self.major = major; self.minor = minor; self.patch = patch; }

        // A version ("1.2.3", "v1.2.3", "1.2.3-beta.2+sha.5"); ValueError otherwise.
        static fn parse(text: string) -> Semver {
            let v = Semver.tryParse(text);
            if (v == null) { throw new ValueError("not a semantic version: '${text}'"); }
            return v;
        }
        // The version, or null when `text` is not one.
        static fn tryParse(text: string) -> Semver {
            let t = Str.trim(text);
            if (Str.startsWith(t, "v") || Str.startsWith(t, "=")) { t = t[1..]; }
            let build = "";
            let plus = Str.indexOf(t, "+");
            if (plus >= 0) { build = t[plus + 1..]; t = t[..plus]; if (build == "") { return null; } }
            let pre = "";
            let dash = Str.indexOf(t, "-");
            if (dash >= 0) { pre = t[dash + 1..]; t = t[..dash]; if (pre == "") { return null; } }
            let parts = Str.split(t, ".");
            if (parts.size() != 3) { return null; }
            for (p in parts) { if (!Semver.numeric(p)) { return null; } }
            let v = new Semver(Integer.parseOr(parts[0], 0), Integer.parseOr(parts[1], 0), Integer.parseOr(parts[2], 0));
            if (pre != "") {
                for (id in Str.split(pre, ".")) {
                    if (id == "" || (Semver.digitsOnly(id) && id.length > 1 && id[0] == 48)) { return null; }
                    v.prerelease.push(id);
                }
            }
            v.build = build;
            return v;
        }
        private static fn digitsOnly(s: string) -> bool { return s != "" && Str.isDigits(s); }
        private static fn numeric(s: string) -> bool { return Semver.digitsOnly(s) && (s.length == 1 || s[0] != 48); }

        fn isPrerelease() -> bool { return !self.prerelease.isEmpty(); }
        // <0, 0, >0 by precedence (build metadata ignored).
        fn compare(o: Semver) -> int {
            if (self.major != o.major) { return self.major < o.major ? -1 : 1; }
            if (self.minor != o.minor) { return self.minor < o.minor ? -1 : 1; }
            if (self.patch != o.patch) { return self.patch < o.patch ? -1 : 1; }
            let a = self.prerelease;
            let b = o.prerelease;
            if (a.isEmpty() || b.isEmpty()) { return a.isEmpty() == b.isEmpty() ? 0 : (a.isEmpty() ? 1 : -1); }
            let n = a.size() < b.size() ? a.size() : b.size();
            for (i in 0..n) {
                let x = a[i];
                let y = b[i];
                if (x == y) { continue; }
                let xn = Semver.digitsOnly(x);
                let yn = Semver.digitsOnly(y);
                if (xn && yn) { let p = Integer.parseOr(x, 0); let q = Integer.parseOr(y, 0); return p < q ? -1 : 1; }
                if (xn != yn) { return xn ? -1 : 1; }                    // numbers before words
                return Str.compare(x, y) < 0 ? -1 : 1;
            }
            return a.size() == b.size() ? 0 : (a.size() < b.size() ? -1 : 1);
        }
        fn equals(o: Semver) -> bool { return self.compare(o) == 0; }
        fn toString() -> string {
            let s = "${self.major}.${self.minor}.${self.patch}";
            if (!self.prerelease.isEmpty()) { s = s + "-" + Str.join(self.prerelease, "."); }
            if (self.build != "") { s = s + "+" + self.build; }
            return s;
        }
        // The next major, minor or patch release.
        fn nextMajor() -> Semver { return new Semver(self.major + 1, 0, 0); }
        fn nextMinor() -> Semver { return new Semver(self.major, self.minor + 1, 0); }
        fn nextPatch() -> Semver { return self.isPrerelease() ? new Semver(self.major, self.minor, self.patch) : new Semver(self.major, self.minor, self.patch + 1); }

        // Whether `version` is in `range`; false for text that is not a version.
        static fn satisfies(version: string, range: string) -> bool {
            let v = Semver.tryParse(version);
            if (v == null) { return false; }
            for (alt in Str.split(range, "||")) {
                let cs = SemverRange.comparators(alt);
                if (cs == null) { throw new ValueError("not a version range: '${range}'"); }
                if (SemverRange.all(v, cs)) { return true; }
            }
            return false;
        }
        // The highest of `versions` in `range` ("" when none is).
        static fn maxSatisfying(versions: Array<string>, range: string) -> string {
            let best: Semver = null;
            let bestText = "";
            for (t in versions) {
                if (!Semver.satisfies(t, range)) { continue; }
                let v = Semver.parse(t);
                if (best == null || v.compare(best) > 0) { best = v; bestText = t; }
            }
            return bestText;
        }
        // Versions in ascending order (ones that are not versions are dropped).
        static fn sort(versions: Array<string>) -> Array<string> {
            let vs = new Array<Semver>();
            for (t in versions) { let v = Semver.tryParse(t); if (v != null) { vs.push(v); } }
            vs.sortBy(fn(a: Semver, b: Semver) -> int { return a.compare(b); });
            let out = new Array<string>();
            for (v in vs) { out.push(v.toString()); }
            return out;
        }
    }

    // One comparator of a range: an operator and a version.
    class SemverComparator {
        public op: string
        public v: Semver
        constructor(op: string, v: Semver) { self.op = op; self.v = v; }
        fn test(x: Semver) -> bool {
            let c = x.compare(self.v);
            switch (self.op) {
                case ">": return c > 0
                case ">=": return c >= 0
                case "<": return c < 0
                case "<=": return c <= 0
                default: return c == 0
            }
        }
    }

    // A version as a range writes it: parts may be missing (-1).
    class SemverPartial {
        public major: long
        public minor: long
        public patch: long
        public pre: Array<string>
        constructor(major: long, minor: long, patch: long, pre: Array<string>) { self.major = major; self.minor = minor; self.patch = patch; self.pre = pre; }
    }

    class SemverRange {
        // Whether v passes every comparator (and the prerelease rule).
        static fn all(v: Semver, cs: Array<SemverComparator>) -> bool {
            for (c in cs) { if (!c.test(v)) { return false; } }
            if (!v.isPrerelease()) { return true; }
            for (c in cs) {
                if (c.v.isPrerelease() && c.v.major == v.major && c.v.minor == v.minor && c.v.patch == v.patch) { return true; }
            }
            return false;
        }
        // The comparators of one alternative ("" or "*": any release), or null when malformed.
        static fn comparators(text: string) -> Array<SemverComparator> {
            let out = new Array<SemverComparator>();
            let t = Str.trim(text);
            // a hyphen range: "1.2 - 1.4"
            let hy = Str.indexOf(t, " - ");
            if (hy >= 0) {
                let lo = SemverRange.partial(Str.trim(t[..hy]));
                let hi = SemverRange.partial(Str.trim(t[hy + 3..]));
                if (lo == null || hi == null) { return null; }
                out.push(new SemverComparator(">=", SemverRange.floor(lo)));
                if (hi.minor < 0) { out.push(new SemverComparator("<", new Semver(hi.major + 1, 0, 0))); }
                else if (hi.patch < 0) { out.push(new SemverComparator("<", new Semver(hi.major, hi.minor + 1, 0))); }
                else { out.push(new SemverComparator("<=", SemverRange.floor(hi))); }
                return out;
            }
            // (">= 1.2" with a space, as some write it)
            let tokens = new Array<string>();
            let pending = "";
            for (w in Str.split(t, " ")) {
                if (w == "") { continue; }
                if (w == ">" || w == ">=" || w == "<" || w == "<=" || w == "=" || w == "^" || w == "~") { pending = w; continue; }
                tokens.push(pending + w);
                pending = "";
            }
            if (tokens.isEmpty()) { out.push(new SemverComparator(">=", new Semver(0, 0, 0))); return out; }
            for (tok in tokens) { if (!SemverRange.one(tok, out)) { return null; } }
            return out;
        }
        private static fn one(tok: string, out: Array<SemverComparator>) -> bool {
            let op = "";
            for (o in [">=", "<=", ">", "<", "=", "^", "~"]) { if (Str.startsWith(tok, o)) { op = o; break; } }
            let rest = tok[op.length..];
            if (Str.startsWith(rest, "v")) { rest = rest[1..]; }
            if (rest == "*" || rest == "x" || rest == "X") {
                out.push(new SemverComparator(">=", new Semver(0, 0, 0)));
                return true;
            }
            let p = SemverRange.partial(rest);
            if (p == null) { return false; }
            let lo = SemverRange.floor(p);
            let major = p.major;
            let minor = p.minor;
            let patch = p.patch;
            if (op == "^") {
                out.push(new SemverComparator(">=", lo));
                if (major > 0 || minor < 0) { out.push(new SemverComparator("<", new Semver(major + 1, 0, 0))); }
                else if (minor > 0 || patch < 0) { out.push(new SemverComparator("<", new Semver(0, minor + 1, 0))); }
                else { out.push(new SemverComparator("<", new Semver(0, 0, patch + 1))); }
            } else if (op == "~") {
                out.push(new SemverComparator(">=", lo));
                out.push(new SemverComparator("<", minor < 0 ? new Semver(major + 1, 0, 0) : new Semver(major, minor + 1, 0)));
            } else if (op == "" || op == "=") {
                if (minor < 0) { out.push(new SemverComparator(">=", lo)); out.push(new SemverComparator("<", new Semver(major + 1, 0, 0))); }
                else if (patch < 0) { out.push(new SemverComparator(">=", lo)); out.push(new SemverComparator("<", new Semver(major, minor + 1, 0))); }
                else { out.push(new SemverComparator("=", lo)); }
            } else if (op == ">") {
                if (minor < 0) { out.push(new SemverComparator(">=", new Semver(major + 1, 0, 0))); }
                else if (patch < 0) { out.push(new SemverComparator(">=", new Semver(major, minor + 1, 0))); }
                else { out.push(new SemverComparator(">", lo)); }
            } else if (op == "<=") {
                if (minor < 0) { out.push(new SemverComparator("<", new Semver(major + 1, 0, 0))); }
                else if (patch < 0) { out.push(new SemverComparator("<", new Semver(major, minor + 1, 0))); }
                else { out.push(new SemverComparator("<=", lo)); }
            } else {
                out.push(new SemverComparator(op, lo));
            }
            return true;
        }
        // The parts of "1", "1.2", "1.2.3", "1.x" (-1 for a missing or wildcard
        // part; a full version keeps its prerelease); null when malformed.
        static fn partial(text: string) -> SemverPartial {
            let full = Semver.tryParse(text);
            if (full != null) { return new SemverPartial(full.major, full.minor, full.patch, full.prerelease); }
            let parts = Str.split(text, ".");
            if (parts.isEmpty() || parts.size() > 3) { return null; }
            let nums: Array<long> = [-1 as long, -1 as long, -1 as long];
            for (i in 0..parts.size()) {
                let q = parts[i];
                if (q == "x" || q == "X" || q == "*") { break; }
                if (q == "" || !Str.isDigits(q)) { return null; }
                nums[i] = Integer.parseOr(q, 0);
            }
            if (nums[0] < 0) { return null; }
            return new SemverPartial(nums[0], nums[1], nums[2], new Array<string>());
        }
        static fn floor(p: SemverPartial) -> Semver {
            let v = new Semver(p.major < 0 ? 0 : p.major, p.minor < 0 ? 0 : p.minor, p.patch < 0 ? 0 : p.patch);
            if (p.minor >= 0 && p.patch >= 0) { for (x in p.pre) { v.prerelease.push(x); } }
            return v;
        }
    }
}
