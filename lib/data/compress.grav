// lib/data/compress.grav — gzip, zlib and raw deflate compression (whole, or
// streamed with GzipWriter and GzipReader), using the
// system's zlib.
//
//   let packed = Compress.gzip(Bytes.fromString(Str.repeat("hello ", 1000)))
//   print(packed.size())                          // a few dozen bytes
//   print(Compress.gunzip(packed).size())         // 6000
//
// zlib is loaded the first time compression is used; without it,
// Compress.available() is false and the calls throw StateError. Corrupt input
// throws ValueError. Decompression takes a size limit, so a small malicious
// input cannot expand into gigabytes.
import "../core/exception.grav"
import "../text/string.grav"
import "bytes.grav"

namespace std.data {

    %{
    #include <dlfcn.h>
    #include <pthread.h>
    #include <stdio.h>
    #include <stdlib.h>
    #include <string.h>

    /* zlib's z_stream, as laid out by the library (no header needed). */
    typedef struct {
        const unsigned char* next_in; unsigned int avail_in; unsigned long total_in;
        unsigned char* next_out; unsigned int avail_out; unsigned long total_out;
        const char* msg; void* state;
        void* zalloc; void* zfree; void* opaque;
        int data_type; unsigned long adler; unsigned long reserved;
    } GravZStream;
    static struct {
        const char* (*zlibVersion)(void);
        int (*deflateInit2_)(GravZStream*, int, int, int, int, int, const char*, int);
        int (*deflate)(GravZStream*, int);
        int (*deflateEnd)(GravZStream*);
        int (*inflateInit2_)(GravZStream*, int, const char*, int);
        int (*inflate)(GravZStream*, int);
        int (*inflateEnd)(GravZStream*);
    } grav_z;
    static int grav_z_ok = 0;
    static pthread_once_t grav_z_once = PTHREAD_ONCE_INIT;
    enum { GRAV_Z_OK = 0, GRAV_Z_STREAM_END = 1, GRAV_Z_NEED_DICT = 2, GRAV_Z_BUF_ERROR = -5, GRAV_Z_FINISH = 4 };

    static void grav_z_load(void) {
        static const char* const names[] = { "libz.so.1", "libz.so", "libz.1.dylib", "libz.dylib", 0 };
        void* h = 0;
        for (int i = 0; names[i] && !h; i++) h = dlopen(names[i], RTLD_NOW | RTLD_GLOBAL);
        if (!h) return;
    #define GRAV_Z_FN(name) *(void**)(&grav_z.name) = dlsym(h, #name)
        GRAV_Z_FN(zlibVersion); GRAV_Z_FN(deflateInit2_); GRAV_Z_FN(deflate); GRAV_Z_FN(deflateEnd);
        GRAV_Z_FN(inflateInit2_); GRAV_Z_FN(inflate); GRAV_Z_FN(inflateEnd);
    #undef GRAV_Z_FN
        grav_z_ok = grav_z.zlibVersion && grav_z.deflateInit2_ && grav_z.deflate && grav_z.deflateEnd &&
                    grav_z.inflateInit2_ && grav_z.inflate && grav_z.inflateEnd;
    }
    static int grav_z_ready(void) { pthread_once(&grav_z_once, grav_z_load); return grav_z_ok; }

    /* Compresses n bytes; wbits 31 = gzip, 15 = zlib, -15 = raw deflate. Returns a
       malloc'd buffer with *outLen, or 0 with *err. */
    static unsigned char* grav_z_deflate(const unsigned char* in, long long n, int level, int wbits,
                                         long long* outLen, long long* outCap, const char** err) {
        GravZStream z;
        memset(&z, 0, sizeof z);
        if (grav_z.deflateInit2_(&z, level, 8 /* Z_DEFLATED */, wbits, 8, 0, grav_z.zlibVersion(), (int)sizeof z) != GRAV_Z_OK) {
            *err = "cannot start compressing";
            return 0;
        }
        size_t cap = (size_t)n + (size_t)n / 1000 + 64;          /* zlib's bound, with room for the gzip header */
        unsigned char* out = (unsigned char*)malloc(cap);
        if (!out) abort();
        z.next_in = in;
        z.next_out = out;
        long long left = n;
        int rc;
        do {
            unsigned int chunk = left > (1 << 30) ? (1u << 30) : (unsigned int)left;
            z.avail_in = chunk;
            left -= chunk;
            do {
                if (z.total_out == cap) {
                    cap *= 2;
                    out = (unsigned char*)realloc(out, cap);
                    if (!out) abort();
                    z.next_out = out + z.total_out;
                }
                z.avail_out = (unsigned int)(cap - z.total_out > (1u << 30) ? (1u << 30) : cap - z.total_out);
                rc = grav_z.deflate(&z, left == 0 ? GRAV_Z_FINISH : 0);
            } while (z.avail_out == 0 || (left == 0 && rc == GRAV_Z_OK));
        } while (left > 0);
        grav_z.deflateEnd(&z);
        if (rc != GRAV_Z_STREAM_END) { free(out); *err = "compression failed"; return 0; }
        *outLen = (long long)z.total_out;
        *outCap = (long long)cap;
        return out;
    }
    /* Decompresses; wbits 47 = gzip or zlib (detected), -15 = raw. At most `limit`
       bytes of output. Returns a malloc'd buffer, or 0 with *err. */
    static unsigned char* grav_z_inflate(const unsigned char* in, long long n, int wbits, long long limit,
                                         long long* outLen, long long* outCap, const char** err) {
        GravZStream z;
        memset(&z, 0, sizeof z);
        if (grav_z.inflateInit2_(&z, wbits, grav_z.zlibVersion(), (int)sizeof z) != GRAV_Z_OK) {
            *err = "cannot start decompressing";
            return 0;
        }
        size_t cap = n < 1024 ? 4096 : (size_t)n * 4;
        if (limit > 0 && cap > (size_t)limit + 1) cap = (size_t)limit + 1;
        unsigned char* out = (unsigned char*)malloc(cap);
        if (!out) abort();
        z.next_in = in;
        z.avail_in = n > (1LL << 30) ? (1u << 30) : (unsigned int)n;
        long long fed = z.avail_in;
        int rc;
        for (;;) {
            if (z.total_out == cap) {
                if (limit > 0 && (long long)cap > limit) { rc = -100; break; }
                cap *= 2;
                if (limit > 0 && cap > (size_t)limit + 1) cap = (size_t)limit + 1;
                out = (unsigned char*)realloc(out, cap);
                if (!out) abort();
            }
            z.next_out = out + z.total_out;
            z.avail_out = (unsigned int)(cap - z.total_out > (1u << 30) ? (1u << 30) : cap - z.total_out);
            if (z.avail_in == 0 && fed < n) {
                long long rest = n - fed;
                z.avail_in = rest > (1LL << 30) ? (1u << 30) : (unsigned int)rest;
                fed += z.avail_in;
            }
            rc = grav_z.inflate(&z, 0);
            if (rc == GRAV_Z_STREAM_END) break;
            if (rc == GRAV_Z_BUF_ERROR && z.avail_in == 0 && fed >= n) { rc = -101; break; }
            if (rc != GRAV_Z_OK && rc != GRAV_Z_BUF_ERROR) break;
        }
        grav_z.inflateEnd(&z);
        if (rc != GRAV_Z_STREAM_END) {
            free(out);
            *err = rc == -100 ? "the data decompresses to more than the limit"
                 : rc == -101 ? "the compressed data ends too soon"
                 : rc == GRAV_Z_NEED_DICT ? "the data needs a preset dictionary"
                 : "the data is not valid compressed data";
            return 0;
        }
        *outLen = (long long)z.total_out;
        *outCap = (long long)cap;
        return out;
    }

    /* ── streams: gzip written or read a piece at a time ──────────────────── */
    typedef struct {
        GravZStream z; int inflating, level, wbits, ended, pendingReset;
        FILE* f; unsigned char* in; size_t inCap, inLen, inPos;
    } GravZS;
    static int grav_zs_init(GravZS* s) {
        memset(&s->z, 0, sizeof s->z);
        return s->inflating ? grav_z.inflateInit2_(&s->z, s->wbits, grav_z.zlibVersion(), (int)sizeof s->z) == GRAV_Z_OK
                            : grav_z.deflateInit2_(&s->z, s->level, 8, s->wbits, 8, 0, grav_z.zlibVersion(), (int)sizeof s->z) == GRAV_Z_OK;
    }
    static GravZS* grav_zs_new(int inflating, int level, int wbits) {
        GravZS* s = (GravZS*)calloc(1, sizeof(GravZS));
        if (!s) abort();
        s->inflating = inflating; s->level = level; s->wbits = wbits;
        if (!grav_zs_init(s)) { free(s); return 0; }
        return s;
    }
    static void grav_zs_free(GravZS* s) {
        if (!s) return;
        if (s->inflating) grav_z.inflateEnd(&s->z); else grav_z.deflateEnd(&s->z);
        if (s->f) fclose(s->f);
        free(s->in); free(s);
    }
    /* Compresses n more bytes (and ends the stream when `fin`): the output made,
       malloc'd (0 when none), its length in *outLen. */
    static unsigned char* grav_zs_deflate(GravZS* s, const unsigned char* p, long long n, int fin, long long* outLen, long long* outCap, const char** err) {
        size_t cap = (size_t)(n / 2) + 1024, made = 0;
        unsigned char* out = (unsigned char*)malloc(cap);
        if (!out) abort();
        long long left = n;
        const unsigned char* at = p;
        int rc = GRAV_Z_OK;
        for (;;) {
            if (s->z.avail_in == 0 && left > 0) {
                unsigned int chunk = left > (1 << 30) ? (1u << 30) : (unsigned int)left;
                s->z.next_in = at; s->z.avail_in = chunk; at += chunk; left -= chunk;
            }
            if (made == cap) { cap *= 2; out = (unsigned char*)realloc(out, cap); if (!out) abort(); }
            s->z.next_out = out + made;
            s->z.avail_out = (unsigned int)(cap - made > (1u << 30) ? (1u << 30) : cap - made);
            unsigned int before = s->z.avail_out;
            rc = grav_z.deflate(&s->z, fin && left == 0 ? GRAV_Z_FINISH : 0);
            made += before - s->z.avail_out;
            if (rc != GRAV_Z_OK && rc != GRAV_Z_STREAM_END && rc != GRAV_Z_BUF_ERROR) { free(out); *err = "compression failed"; return 0; }
            if (fin) { if (rc == GRAV_Z_STREAM_END) break; continue; }
            if (s->z.avail_in == 0 && left == 0 && s->z.avail_out != 0) break;
        }
        s->z.next_in = 0;
        if (made == 0) { free(out); out = 0; cap = 0; }
        *outLen = (long long)made; *outCap = (long long)cap;
        return out;
    }
    /* More compressed input, kept until inflated. */
    static void grav_zs_feed(GravZS* s, const unsigned char* p, long long n) {
        if (s->inPos > 0) { memmove(s->in, s->in + s->inPos, s->inLen - s->inPos); s->inLen -= s->inPos; s->inPos = 0; }
        if (s->inLen + (size_t)n > s->inCap) {
            size_t c = s->inCap < 65536 ? 65536 : s->inCap;
            while (c < s->inLen + (size_t)n) c *= 2;
            s->in = (unsigned char*)realloc(s->in, c); if (!s->in) abort();
            s->inCap = c;
        }
        memcpy(s->in + s->inLen, p, (size_t)n); s->inLen += (size_t)n;
    }
    /* Reads up to 64 KB of the stream's file into its input; how many (0 at the end). */
    static long long grav_zs_feed_file(GravZS* s) {
        unsigned char buf[65536];
        size_t n = fread(buf, 1, sizeof buf, s->f);
        if (n > 0) grav_zs_feed(s, buf, (long long)n);
        return (long long)n;
    }
    /* Inflates into out (up to max): bytes made (> 0); 0 when more input is
       needed; -1 at the end (after the last gzip member); -3 on bad data (*err).
       Members written one after another (as `cat a.gz b.gz` makes) read as one. */
    static long long grav_zs_inflate(GravZS* s, unsigned char* out, long long max, int sourceDone, const char** err) {
        for (;;) {
            if (s->ended) return -1;
            size_t have = s->inLen - s->inPos;
            if (s->pendingReset) {
                if (have >= 2) {
                    if (s->in[s->inPos] == 0x1f && s->in[s->inPos + 1] == 0x8b) {
                        grav_z.inflateEnd(&s->z);
                        if (!grav_zs_init(s)) { *err = "cannot start decompressing"; return -3; }
                        s->pendingReset = 0;
                    } else { s->ended = 1; return -1; }
                } else if (sourceDone) { s->ended = 1; return -1; }
                else return 0;
                have = s->inLen - s->inPos;
            }
            s->z.next_in = s->in + s->inPos; s->z.avail_in = (unsigned int)have;
            s->z.next_out = out; s->z.avail_out = (unsigned int)max;
            int rc = grav_z.inflate(&s->z, 0);
            s->inPos = (size_t)(s->z.next_in - s->in);
            long long made = max - (long long)s->z.avail_out;
            if (rc == GRAV_Z_STREAM_END) {
                s->pendingReset = 1;
                if (made > 0) return made;
                continue;
            }
            if (rc == GRAV_Z_OK || rc == GRAV_Z_BUF_ERROR) {
                if (made > 0) return made;
                if (s->inPos == s->inLen) {
                    if (sourceDone) { *err = "the compressed data ends too soon"; return -3; }
                    return 0;
                }
                continue;
            }
            *err = rc == GRAV_Z_NEED_DICT ? "the data needs a preset dictionary" : "the data is not valid gzip data";
            return -3;
        }
    }
    %}

    // gzip, zlib and raw deflate compression.
    class Compress {
        // Whether zlib could be loaded (compression works).
        static fn available() -> bool { return %{ grav_z_ready() %} as bool; }
        // The zlib version in use ("1.3.1"), "" without zlib.
        static fn libraryVersion() -> string {
            if (!Compress.available()) { return ""; }
            return %{ grav_z.zlibVersion() %} as string;
        }

        // gzip-compressed (the .gz and HTTP "gzip" format) at the default level 6.
        static fn gzip(data: Bytes) -> Bytes { return Compress.pack(data, 6, 31); }
        // gzip at a level from 1 (fastest) to 9 (smallest); 0 stores without compressing.
        static fn gzip(data: Bytes, level: int) -> Bytes { return Compress.pack(data, level, 31); }
        // The bytes of gzip (or zlib) data, at most 1 GiB; ValueError when corrupt.
        static fn gunzip(data: Bytes) -> Bytes { return Compress.unpack(data, 47, 1 << 30); }
        // zlib-compressed (the HTTP "deflate" format).
        static fn deflate(data: Bytes) -> Bytes { return Compress.pack(data, 6, 15); }
        // zlib at a level from 0 to 9.
        static fn deflate(data: Bytes, level: int) -> Bytes { return Compress.pack(data, level, 15); }
        // Raw deflate, with no header or checksum (as in zip files).
        static fn deflateRaw(data: Bytes) -> Bytes { return Compress.pack(data, 6, -15); }
        // The bytes of zlib (or gzip) data.
        static fn inflate(data: Bytes) -> Bytes { return Compress.unpack(data, 47, 1 << 30); }
        // The bytes of raw deflate data.
        static fn inflateRaw(data: Bytes) -> Bytes { return Compress.unpack(data, -15, 1 << 30); }
        // Decompresses gzip, zlib or raw deflate data (whichever it is), producing
        // at most `maxBytes` bytes (ValueError beyond that).
        static fn decompress(data: Bytes, maxBytes: int) -> Bytes {
            if (Compress.isGzip(data) || Compress.isZlib(data)) { return Compress.unpack(data, 47, maxBytes); }
            return Compress.unpack(data, -15, maxBytes);
        }
        // Text gzip-compressed.
        static fn gzipText(text: string) -> Bytes { return Compress.gzip(Bytes.fromString(text)); }
        // gzip data decompressed to text.
        static fn gunzipText(data: Bytes) -> string { return Compress.gunzip(data).toString(); }
        // Whether the data starts like gzip (1f 8b).
        static fn isGzip(data: Bytes) -> bool { return data.size() >= 2 && data.get(0) == 0x1f && data.get(1) == 0x8b; }
        // Whether the data starts like a zlib stream.
        static fn isZlib(data: Bytes) -> bool {
            if (data.size() < 2) { return false; }
            let a = data.get(0);
            return (a & 0x0f) == 8 && ((a * 256 + data.get(1)) % 31) == 0;
        }

        private static fn require() {
            if (!Compress.available()) { throw new StateError("compression needs zlib (libz), which could not be loaded"); }
        }
        private static fn pack(data: Bytes, level: int, wbits: int) -> Bytes {
            Compress.require();
            if (level < 0 || level > 9) { throw new ValueError("compression level must be 0..9, not ${level}"); }
            let p = data.rawData();
            let n = data.size();
            let out = new Bytes();
            let err = %{ (const char*)0 %} as byte*;
            let ok = %{ ({ long long grav_n = 0, grav_c = 0; const char* grav_e = 0;
                           unsigned char* grav_b = grav_z_deflate(p, n, level, wbits, &grav_n, &grav_c, &grav_e);
                           if (grav_b) { free(out->data); out->data = grav_b; out->len = (int)grav_n; out->cap = (int)grav_c; }
                           err = (unsigned char*)grav_e; grav_b != 0; }) %} as bool;
            if (!ok) { throw new ValueError(%{ grav_strdup((const char*)err) %} as string); }
            return out;
        }
        private static fn unpack(data: Bytes, wbits: int, limit: int) -> Bytes {
            Compress.require();
            let p = data.rawData();
            let n = data.size();
            let out = new Bytes();
            let err = %{ (const char*)0 %} as byte*;
            let ok = %{ ({ long long grav_n = 0, grav_c = 0; const char* grav_e = 0;
                           unsigned char* grav_b = grav_z_inflate(p, n, wbits, limit, &grav_n, &grav_c, &grav_e);
                           if (grav_b) { free(out->data); out->data = grav_b; out->len = (int)grav_n; out->cap = (int)grav_c; }
                           err = (unsigned char*)grav_e; grav_b != 0; }) %} as bool;
            if (!ok) { throw new ValueError(%{ grav_strdup((const char*)err) %} as string); }
            return out;
        }
    }

    // gzip written a piece at a time: each write hands the compressed output
    // made so far to the sink (or the file), so nothing needs to fit in memory.
    //
    //   let gz = GzipWriter.toFile("backup.tar.gz")
    //   gz.write(chunk); ...; gz.finish()                     // finish() writes the end
    class GzipWriter {
        private zs: byte*
        private sink: fn(Bytes) = null
        private finished: bool = false
        // Bytes given to write, and compressed bytes handed on.
        public bytesIn: long = 0
        public bytesOut: long = 0
        // Compressed output goes to `sink`, in pieces, as it is made.
        constructor(sink: fn(Bytes), level: int = 6) {
            self.sink = sink;
            self.zs = GzipWriter.open(level);
        }
        // Compressed output to the file at `path` (replaced); IOError when it cannot be opened.
        static fn toFile(path: string, level: int = 6) -> GzipWriter {
            let w = new GzipWriter(null, level);
            let ok = %{ ({ FILE* grav_f = fopen(path, "wb"); ((GravZS*)w->zs)->f = grav_f; grav_f != 0; }) %} as bool;
            if (!ok) { throw new IOError("cannot write '" + path + "'"); }
            return w;
        }
        private static fn open(level: int) -> byte* {
            if (!Compress.available()) { throw new StateError("compression needs zlib (libz), which could not be loaded"); }
            if (level < 0 || level > 9) { throw new ValueError("compression level must be 0..9, not ${level}"); }
            let zs = %{ (unsigned char*)grav_zs_new(0, level, 31) %} as byte*;
            if (zs == null) { throw new StateError("cannot start compressing"); }
            return zs;
        }
        destructor() { %{ grav_zs_free((GravZS*)self->zs); self->zs = 0; %}; }
        fn write(data: Bytes) -> GzipWriter { self.push(data, false); return self; }
        fn writeString(text: string) -> GzipWriter { self.push(Bytes.fromString(text), false); return self; }
        // Ends the stream (writing its trailer) and closes the file; once.
        fn finish() {
            if (self.finished) { return; }
            self.push(new Bytes(), true);
            self.finished = true;
            %{ GravZS* grav_s = (GravZS*)self->zs; if (grav_s->f) { fclose(grav_s->f); grav_s->f = 0; } %};
        }
        private fn push(data: Bytes, fin: bool) {
            if (self.finished) { throw new StateError("GzipWriter: already finished"); }
            let p = data.rawData();
            let n = data.size();
            self.bytesIn += n;
            let out = new Bytes();
            let err = %{ (const char*)0 %} as byte*;
            let ok = %{ ({ long long grav_n = 0, grav_c = 0; const char* grav_e = 0;
                           unsigned char* grav_b = grav_zs_deflate((GravZS*)self->zs, p, n, fin, &grav_n, &grav_c, &grav_e);
                           if (grav_b) { free(out->data); out->data = grav_b; out->len = (int)grav_n; out->cap = (int)grav_c; }
                           err = (unsigned char*)grav_e; grav_e == 0; }) %} as bool;
            if (!ok) { throw new ValueError(%{ grav_strdup((const char*)err) %} as string); }
            if (out.size() == 0) { return; }
            self.bytesOut += out.size();
            let toFile = %{ ((GravZS*)self->zs)->f != 0 %} as bool;
            if (toFile) {
                let q = out.rawData();
                let m = out.size();
                let wrote = %{ (long long)fwrite(q, 1, (size_t)m, ((GravZS*)self->zs)->f) %} as long;
                if (wrote != m) { throw new IOError("GzipWriter: the file could not be written"); }
                return;
            }
            let sink = self.sink;
            sink(out);
        }
    }

    // gzip read a piece at a time: compressed input comes from the source (or
    // the file) as needed, and read() gives up to `max` bytes of the original.
    // Members written one after another read as one stream.
    //
    //   let gz = GzipReader.fromFile("backup.tar.gz")
    //   while (true) { let part = gz.read(65536); if (part.isEmpty()) { break }; ... }
    class GzipReader {
        private zs: byte*
        private source: fn(int) -> Bytes = null
        private sourceDone: bool = false
        // Compressed input is asked of `source` (up to the number of bytes given;
        // an empty result means there is no more).
        constructor(source: fn(int) -> Bytes) {
            self.source = source;
            if (!Compress.available()) { throw new StateError("compression needs zlib (libz), which could not be loaded"); }
            self.zs = %{ (unsigned char*)grav_zs_new(1, 0, 47) %} as byte*;
            if (self.zs == null) { throw new StateError("cannot start decompressing"); }
        }
        // Reads the gzip file at `path`; IOError when it cannot be opened.
        static fn fromFile(path: string) -> GzipReader {
            let r = new GzipReader(null);
            let ok = %{ ({ FILE* grav_f = fopen(path, "rb"); ((GravZS*)r->zs)->f = grav_f; grav_f != 0; }) %} as bool;
            if (!ok) { throw new IOError("cannot read '" + path + "'"); }
            return r;
        }
        destructor() { %{ grav_zs_free((GravZS*)self->zs); self->zs = 0; %}; }
        // Up to `max` bytes of the original; empty at the end. ValueError on bad data.
        fn read(max: int = 65536) -> Bytes {
            let out = new Bytes(max);
            while (true) {
                let done = self.sourceDone;
                let err = %{ (const char*)0 %} as byte*;
                let n = %{ ({ const char* grav_e = 0; long long grav_r = grav_zs_inflate((GravZS*)self->zs, out->data, max, done, &grav_e);
                              err = (unsigned char*)grav_e; grav_r; }) %} as long;
                if (n > 0) {
                    %{ out->len = (int)n; %};
                    return out;
                }
                if (n == -1) { return out; }
                if (n == -3) { throw new ValueError(%{ grav_strdup((const char*)err) %} as string); }
                self.more();
            }
            return out;
        }
        // Everything left, at once.
        fn readAll() -> Bytes {
            let all = new Bytes();
            while (true) {
                let part = self.read(65536);
                if (part.isEmpty()) { break; }
                all.append(part);
            }
            return all;
        }
        private fn more() {
            let fromFile = %{ ((GravZS*)self->zs)->f != 0 %} as bool;
            if (fromFile) {
                let n = %{ grav_zs_feed_file((GravZS*)self->zs) %} as long;
                if (n == 0) { self.sourceDone = true; }
                return;
            }
            let src = self.source;
            let b = src(65536);
            if (b.isEmpty()) { self.sourceDone = true; return; }
            let p = b.rawData();
            let n = b.size();
            %{ grav_zs_feed((GravZS*)self->zs, p, n); %};
        }
    }
}
