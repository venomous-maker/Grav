// lib/core/sort.grav — sorting and searching arrays (namespace std.core, next to Math).
//
// Sorting is TimSort (lib/core/timsort.grav): stable (equal elements keep their
// order), O(n log n) in the worst case and close to O(n) on input that is already
// sorted, reversed, or made of a few sorted stretches.
//
//   Sort.sort(nums)                                   // int, long, float, string arrays
//   Sort.sortDescending(nums)
//   Sort.sortBy(people, fn(a, b) => a.age - b.age)    // any type: cmp(a, b) < 0 puts a first
//   Sort.isSorted(nums)
//   Sort.binarySearch(nums, 42)                       // index, or -(insertion point) - 1
//
// `xs.sortBy(cmp)` on an Array is the same sort. Strings compare byte by byte
// (like Str.compare): "B" < "a".
import "../collections/array.grav"
import "timsort.grav"

namespace std.core {

    %{
    #include <string.h>
    #include <stdlib.h>
    /* Numbers need no stable sort, so they skip the comparator closure: a plain C sort
       on the array's buffer. */
    static int grav_cmp_int(const void* a, const void* b) { int x = *(const int*)a, y = *(const int*)b; return (x > y) - (x < y); }
    static int grav_cmp_ll(const void* a, const void* b) { long long x = *(const long long*)a, y = *(const long long*)b; return (x > y) - (x < y); }
    static int grav_cmp_dbl(const void* a, const void* b) { double x = *(const double*)a, y = *(const double*)b; return (x > y) - (x < y); }
    static int grav_rcmp_int(const void* a, const void* b) { return grav_cmp_int(b, a); }
    static int grav_rcmp_ll(const void* a, const void* b) { return grav_cmp_ll(b, a); }
    static int grav_rcmp_dbl(const void* a, const void* b) { return grav_cmp_dbl(b, a); }
    static int grav_cmp_str(const void* a, const void* b) { return strcmp(*(const char* const*)a, *(const char* const*)b); }
    static int grav_rcmp_str(const void* a, const void* b) { return grav_cmp_str(b, a); }
    %}

    class Sort {
        // ── natural order (ascending; Descending reverses it) ──────────────────
        // Sorts in place, smallest first.
        static fn sort(xs: Array<int>) { let p = xs.__buffer(); let n = xs.size(); %{ if (n > 1) qsort(p, (size_t)n, sizeof(int), grav_cmp_int); %}; }
        // Sorts in place, largest first.
        static fn sortDescending(xs: Array<int>) { let p = xs.__buffer(); let n = xs.size(); %{ if (n > 1) qsort(p, (size_t)n, sizeof(int), grav_rcmp_int); %}; }
        // Whether the elements are in ascending order.
        static fn isSorted(xs: Array<int>) -> bool { return Sort.isSortedBy(xs, fn(a: int, b: int) -> int { return a < b ? -1 : (a > b ? 1 : 0); }) }
        // In a sorted array: the index of key, or -(insertion point) - 1.
        static fn binarySearch(xs: Array<int>, key: int) -> int { return Sort.binarySearchBy(xs, key, fn(a: int, b: int) -> int { return a < b ? -1 : (a > b ? 1 : 0); }) }
        // Sorts in place, smallest first.
        static fn sort(xs: Array<long>) { let p = xs.__buffer(); let n = xs.size(); %{ if (n > 1) qsort(p, (size_t)n, sizeof(long long), grav_cmp_ll); %}; }
        // Sorts in place, largest first.
        static fn sortDescending(xs: Array<long>) { let p = xs.__buffer(); let n = xs.size(); %{ if (n > 1) qsort(p, (size_t)n, sizeof(long long), grav_rcmp_ll); %}; }
        // Whether the elements are in ascending order.
        static fn isSorted(xs: Array<long>) -> bool { return Sort.isSortedBy(xs, fn(a: long, b: long) -> int { return a < b ? -1 : (a > b ? 1 : 0); }) }
        // In a sorted array: the index of key, or -(insertion point) - 1.
        static fn binarySearch(xs: Array<long>, key: long) -> int { return Sort.binarySearchBy(xs, key, fn(a: long, b: long) -> int { return a < b ? -1 : (a > b ? 1 : 0); }) }
        // Sorts in place, smallest first.
        static fn sort(xs: Array<float>) { let p = xs.__buffer(); let n = xs.size(); %{ if (n > 1) qsort(p, (size_t)n, sizeof(double), grav_cmp_dbl); %}; }
        // Sorts in place, largest first.
        static fn sortDescending(xs: Array<float>) { let p = xs.__buffer(); let n = xs.size(); %{ if (n > 1) qsort(p, (size_t)n, sizeof(double), grav_rcmp_dbl); %}; }
        // Whether the elements are in ascending order.
        static fn isSorted(xs: Array<float>) -> bool { return Sort.isSortedBy(xs, fn(a: float, b: float) -> int { return a < b ? -1 : (a > b ? 1 : 0); }) }
        // In a sorted array: the index of key, or -(insertion point) - 1.
        static fn binarySearch(xs: Array<float>, key: float) -> int { return Sort.binarySearchBy(xs, key, fn(a: float, b: float) -> int { return a < b ? -1 : (a > b ? 1 : 0); }) }
        // Sorts in place, smallest first (strings byte by byte).
        static fn sort(xs: Array<string>) { let p = xs.__buffer(); let n = xs.size(); %{ if (n > 1) qsort((void*)p, (size_t)n, sizeof(const char*), grav_cmp_str); %}; }
        // Sorts in place, largest first.
        static fn sortDescending(xs: Array<string>) { let p = xs.__buffer(); let n = xs.size(); %{ if (n > 1) qsort((void*)p, (size_t)n, sizeof(const char*), grav_rcmp_str); %}; }
        // Whether the elements are in ascending order.
        static fn isSorted(xs: Array<string>) -> bool { return Sort.isSortedBy(xs, fn(a: string, b: string) -> int { return %{ strcmp(a, b) %} as int; }) }
        // In a sorted array: the index of key, or -(insertion point) - 1.
        static fn binarySearch(xs: Array<string>, key: string) -> int { return Sort.binarySearchBy(xs, key, fn(a: string, b: string) -> int { return %{ strcmp(a, b) %} as int; }) }

        // ── any type, by a comparison: cmp(a, b) < 0 puts a first, > 0 puts b first
        // Sorts in place (stable): cmp(a, b) < 0 puts a first.
        static fn sortBy<T>(xs: Array<T>, cmp: fn(T, T) -> int) { xs.sortBy(cmp) }
        // Whether the elements are in order by cmp (no element sorts before the one ahead of it).
        static fn isSortedBy<T>(xs: Array<T>, cmp: fn(T, T) -> int) -> bool {
            for (i in 1..xs.size()) { if (cmp(xs.get(i - 1), xs.get(i)) > 0) { return false } }
            return true
        }
        // In an array sorted by cmp: the index of an element equal to `key`, or
        // -(where it would go) - 1.
        static fn binarySearchBy<T>(xs: Array<T>, key: T, cmp: fn(T, T) -> int) -> int {
            let lo = 0
            let hi = xs.size() - 1
            while (lo <= hi) {
                let mid = (lo + hi) >> 1
                let c = cmp(xs.get(mid), key)
                if (c < 0) { lo = mid + 1 }
                else if (c > 0) { hi = mid - 1 }
                else { return mid }
            }
            return -(lo + 1)
        }
    }

}
