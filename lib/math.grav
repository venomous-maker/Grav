// lib/math.grav — math functions and constants (C <math.h>; libm is linked
// automatically). Float functions take and return `float` (64-bit); min/max/
// abs/clamp/sign also have integer overloads, so `Math.max(3, 7)` stays an int.

%{ #include <math.h> %}

class Math {
    static readonly PI: float = 3.141592653589793
    static readonly E: float = 2.718281828459045
    static readonly TAU: float = 6.283185307179586
    static fn pi() -> float { return Math.PI; }
    static fn e() -> float { return Math.E; }

    // ── powers and roots ───────────────────────────────────────────────────
    static fn sqrt(x: float) -> float { return %{ sqrt(x) %} as float; }
    static fn cbrt(x: float) -> float { return %{ cbrt(x) %} as float; }
    static fn pow(base: float, exp: float) -> float { return %{ pow(base, exp) %} as float; }
    static fn hypot(x: float, y: float) -> float { return %{ hypot(x, y) %} as float; }
    static fn exp(x: float) -> float { return %{ exp(x) %} as float; }
    static fn log(x: float) -> float { return %{ log(x) %} as float; }
    static fn log2(x: float) -> float { return %{ log2(x) %} as float; }
    static fn log10(x: float) -> float { return %{ log10(x) %} as float; }

    // ── trigonometry ───────────────────────────────────────────────────────
    static fn sin(x: float) -> float { return %{ sin(x) %} as float; }
    static fn cos(x: float) -> float { return %{ cos(x) %} as float; }
    static fn tan(x: float) -> float { return %{ tan(x) %} as float; }
    static fn asin(x: float) -> float { return %{ asin(x) %} as float; }
    static fn acos(x: float) -> float { return %{ acos(x) %} as float; }
    static fn atan(x: float) -> float { return %{ atan(x) %} as float; }
    static fn atan2(y: float, x: float) -> float { return %{ atan2(y, x) %} as float; }
    static fn sinh(x: float) -> float { return %{ sinh(x) %} as float; }
    static fn cosh(x: float) -> float { return %{ cosh(x) %} as float; }
    static fn tanh(x: float) -> float { return %{ tanh(x) %} as float; }
    static fn toRadians(deg: float) -> float { return deg * Math.PI / 180.0; }
    static fn toDegrees(rad: float) -> float { return rad * 180.0 / Math.PI; }

    // ── rounding ───────────────────────────────────────────────────────────
    static fn floor(x: float) -> float { return %{ floor(x) %} as float; }
    static fn ceil(x: float) -> float { return %{ ceil(x) %} as float; }
    static fn round(x: float) -> float { return %{ round(x) %} as float; }
    static fn trunc(x: float) -> float { return %{ trunc(x) %} as float; }
    // Round to `digits` decimal places.
    static fn roundTo(x: float, digits: int) -> float {
        let f = Math.pow(10.0, digits as float);
        return Math.round(x * f) / f;
    }

    // ── comparisons (float and integer overloads) ──────────────────────────
    static fn abs(x: float) -> float { return %{ fabs(x) %} as float; }
    static fn abs(x: int) -> int { return x < 0 ? -x : x; }
    static fn abs(x: long) -> long { return x < 0 ? -x : x; }
    static fn min(a: float, b: float) -> float { return a < b ? a : b; }
    static fn min(a: int, b: int) -> int { return a < b ? a : b; }
    static fn min(a: long, b: long) -> long { return a < b ? a : b; }
    static fn max(a: float, b: float) -> float { return a > b ? a : b; }
    static fn max(a: int, b: int) -> int { return a > b ? a : b; }
    static fn max(a: long, b: long) -> long { return a > b ? a : b; }
    static fn clamp(x: float, lo: float, hi: float) -> float { return x < lo ? lo : (x > hi ? hi : x); }
    static fn clamp(x: int, lo: int, hi: int) -> int { return x < lo ? lo : (x > hi ? hi : x); }
    static fn sign(x: float) -> int { return x > 0.0 ? 1 : (x < 0.0 ? -1 : 0); }
    static fn sign(x: int) -> int { return x > 0 ? 1 : (x < 0 ? -1 : 0); }

    // ── floating-point classification ──────────────────────────────────────
    static fn isNaN(x: float) -> bool { return %{ isnan(x) != 0 %} as bool; }
    static fn isInfinite(x: float) -> bool { return %{ isinf(x) != 0 %} as bool; }
    static fn isFinite(x: float) -> bool { return %{ isfinite(x) != 0 %} as bool; }

    // ── integer math ───────────────────────────────────────────────────────
    static fn gcd(a: long, b: long) -> long {
        let x = a < 0 ? -a : a;
        let y = b < 0 ? -b : b;
        while (y != 0) { let t = x % y; x = y; y = t; }
        return x;
    }
    static fn lcm(a: long, b: long) -> long { return a == 0 || b == 0 ? 0 : Math.abs(a / Math.gcd(a, b) * b); }
    static fn isPrime(n: long) -> bool {
        if (n < 2) { return false; }
        if (n % 2 == 0) { return n == 2; }
        let d: long = 3;
        while (d * d <= n) { if (n % d == 0) { return false; } d += 2; }
        return true;
    }
    static fn factorial(n: int) -> long {
        let r: long = 1;
        for (i in 2..=n) { r *= i; }
        return r;
    }
}
