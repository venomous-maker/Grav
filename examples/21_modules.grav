// 21_modules.grav — imports, namespaces, and `use`.
//
//   grav run examples/21_modules.grav
//
// The standard library is grouped in categories, each a namespace (std.core,
// std.collections, std.text, std.data, std.io, std.sys, std.concurrency, std.net).
// This file shows the three import forms, `use` for your own namespaces, and how
// a program's own names coexist with the library's.

// Only the names you list (and one renamed):
import { HashMap as Dict, Array, Deque } from "std/collections"
// A whole category behind a prefix: text.Str, text.StringBuilder:
import "std/text" as text
// A whole category, unqualified:
import "std/core"

// ── your own namespaces ──────────────────────────────────────────────────────
namespace geometry {
    class Point {
        public x: int
        public y: int
        constructor(x: int, y: int) { self.x = x; self.y = y }
        fn toString() -> string { return "(${self.x}, ${self.y})" }
    }
    fn manhattan(a: Point, b: Point) -> int {
        return Math.abs(a.x - b.x) + Math.abs(a.y - b.y)
    }
    namespace shapes {
        class Rect {
            public w: int
            public h: int
            constructor(w: int, h: int) { self.w = w; self.h = h }
            fn area() -> int { return self.w * self.h }
        }
    }
}

namespace legacy {
    class Point {
        public coords: string
        constructor(c: string) { self.coords = c }
    }
}

use geometry::*                          // Point, manhattan
use geometry.shapes as sh                // a namespace alias: sh.Rect
use legacy.Point as OldPoint             // one name, renamed

// A class named like a library one: it wins in this file, and the library keeps
// using its own `Str` internally.
class Str {
    static fn shout(s: string) -> string { return text.Str.upper(s) + "!" }
}

fn main() {
    print("--- selective import ---")
    let ages = new Dict<string, int>()
    ages.put("ada", 36)
    ages.put("linus", 54)
    print("ada is ${ages.get("ada")}, ${ages.size()} people")
    let queue = new Deque<int>()
    queue.pushBack(1)
    queue.pushFront(0)
    print("deque front ${queue.peekFront()}, size ${queue.size()}")
    let names = new Array<string>()
    names.push("b")
    names.push("a")
    names.sortBy(fn(x: string, y: string) => text.Str.compare(x, y))
    print("sorted: " + text.Str.join(names, ", "))

    print("--- module alias ---")
    let sb = new text.StringBuilder()
    sb.append("built").append(" with ").append("text.StringBuilder")
    print(sb.toString())

    print("--- use ---")
    let a = new Point(1, 2)
    let b = new Point(4, 6)
    print("${a} to ${b}: ${manhattan(a, b)} steps")
    print("rect area ${new sh.Rect(3, 4).area()}")
    print("old point " + new OldPoint("10,20").coords)

    print("--- your names next to the library's ---")
    print(Str.shout("grav"))                     // ours
    print(std.text.Str.length("grav"))           // the library's, fully qualified

    print("--- the rest of std.core ---")
    let r: Result<int, string> = Result.Ok(ages.get("linus"))
    print(r.map(fn(n: int) => n + 1))
}
