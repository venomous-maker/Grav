// 19_enums_match.grav — data enums, pattern matching, Result and Option.
//
//   grav run examples/19_enums_match.grav
//
// A tiny expression calculator: the syntax tree is a data enum, evaluation is a
// recursive `match`, and errors travel as Result values instead of exceptions.
import "std"

// An arithmetic expression tree.
enum Expr {
    Num(value: int),
    Var(name: string),
    Add(left: Expr, right: Expr),
    Mul(left: Expr, right: Expr),
    Div(left: Expr, right: Expr),

    // Source-like rendering (replaces the generated `Add(Num(1), ...)` form).
    fn toString() -> string {
        match (self) {
            case Num(n): return "${n}"
            case Var(name): return name
            case Add(a, b): return "(" + a.toString() + " + " + b.toString() + ")"
            case Mul(a, b): return a.toString() + " * " + b.toString()
            case Div(a, b): return a.toString() + " / " + b.toString()
        }
    }
}

// Evaluate with variables from `env`; unknown names and division by zero are errors.
fn eval(e: Expr, env: HashMap<string, int>) -> Result<int, string> {
    match (e) {
        case Num(n): return Result.Ok(n)
        case Var(name): {
            if (!env.containsKey(name)) { return Result.Err("unknown variable '" + name + "'") }
            return Result.Ok(env.get(name))
        }
        case Add(a, b): return both(a, b, env, fn(x: int, y: int) => x + y)
        case Mul(a, b): return both(a, b, env, fn(x: int, y: int) => x * y)
        case Div(a, b): {
            let d = eval(b, env)
            if (d.isOk() && d.unwrap() == 0) { return Result.Err("division by zero in " + e.toString()) }
            return both(a, b, env, fn(x: int, y: int) => x / y)
        }
    }
}

// Evaluate two sub-expressions and combine them; the first error wins.
fn both(a: Expr, b: Expr, env: HashMap<string, int>, f: fn(int, int) -> int) -> Result<int, string> {
    let x = eval(a, env)
    if (x.isErr()) { return x }
    let y = eval(b, env)
    if (y.isErr()) { return y }
    return Result.Ok(f(x.unwrap(), y.unwrap()))
}

// Constant folding: rebuild the tree with constant sub-expressions computed.
fn simplify(e: Expr) -> Expr {
    match (e) {
        case Add(a, b): {
            let l = simplify(a)
            let r = simplify(b)
            if (l is Expr.Num && r is Expr.Num) {
                return Expr.Num((l as Expr.Num).value + (r as Expr.Num).value)
            }
            return Expr.Add(l, r)
        }
        case Mul(a, b): {
            let l = simplify(a)
            let r = simplify(b)
            if (l == Expr.Num(1)) { return r }
            if (r == Expr.Num(1)) { return l }
            return Expr.Mul(l, r)
        }
        default: return e
    }
}

// Option: look a variable up without failing.
fn lookup(env: HashMap<string, int>, name: string) -> Option<int> {
    if (env.containsKey(name)) { return Option.Some(env.get(name)) }
    return Option.None
}

fn main() {
    let env = new HashMap<string, int>()
    env.put("x", 6)
    env.put("y", 0)

    // (x + 4) * 3
    let e1 = Expr.Mul(Expr.Add(Expr.Var("x"), Expr.Num(4)), Expr.Num(3))
    print("${e1} = ${eval(e1, env)}")

    let e2 = Expr.Div(Expr.Num(10), Expr.Var("y"))
    print("${e2} = ${eval(e2, env)}")

    let e3 = Expr.Add(Expr.Var("z"), Expr.Num(1))
    match (eval(e3, env)) {
        case Ok(v): print("e3 = ${v}")
        case Err(msg): print("e3 failed: " + msg)
    }

    let e4 = Expr.Mul(Expr.Num(1), Expr.Add(Expr.Num(2), Expr.Num(3)))
    print("${e4} simplifies to ${simplify(e4)}")
    print("same tree: ${simplify(e4) == Expr.Num(5)}")

    print("x is ${lookup(env, "x")}, z is ${lookup(env, "z")}")
    print("z or 0: ${lookup(env, "z").unwrapOr(0)}")
    let total = eval(e1, env).map(fn(n: int) => n * 100).unwrapOr(-1)
    print("scaled: ${total}")
}
