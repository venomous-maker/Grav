build
.idea
cmake-build-debug
.claude
__pycache__
*.pyc
# Compiled example binaries / generated C (keep .grav sources)
examples/**/*.c
examples/**/*.s
examples/[0-9][0-9]_*
!examples/[0-9][0-9]_*.grav
examples/apps/*
!examples/apps/*.grav
# multi-file app projects: keep the sources, ignore their binaries and data
!examples/apps/bank_server/
examples/apps/bank_server/src/main
examples/apps/bank_server/*.json
examples/project/main

# tests/docs.sh writes each snippet next to its page while it runs
.snippet_*.grav

# grav-db: its own repository (github.com/venomous-maker/grav-db), kept here while developing
/grav-db/

# grav-orbit: its own repository (github.com/venomous-maker/grav-orbit), kept here while developing
/grav-orbit/
