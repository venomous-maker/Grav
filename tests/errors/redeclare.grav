struct Point { x: int  x: string }
class Base { public id: int }
class Twice extends Base { public name: string  public name: int }
class Shadow extends Base { public id: int }
fn f(n: int) -> int {
    let n = 5
    return n
}
fn main() {
    let y = 1
    let y = 2
    { let y = 3  print(y) }      // an inner block may shadow
