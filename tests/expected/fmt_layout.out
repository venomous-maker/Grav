    if (p.x > 0 && p.y < 5) { println("in") } else { println("out") }
    for (i in 0..3) {
        println(i)
    }
    let xs = [1, 2, 3]
    let s = match (p.x) { case 1: "one" default: "many" }
    xs.forEach(fn(v: int) {
        println(v)
        println(-v)
    })
    while (true) { break }
    let m = {"a": 1,   "b": 2}
    let q = p.step().step()
    let label = xs.size() > 2 ? "many" : "few"
    let total = xs.size() * 2
    + 1
    let text = """
