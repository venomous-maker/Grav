import "std"
#define TWICE(x) ((x)*2)
struct Cfg { port: int?  debug: bool? }
class Point {
    public x: int
    public y: int
    constructor(x: int, y: int) {
        self.x = x
        self.y = y
    }
    fn norm() -> float {
        return float(self.x * self.x + self.y * self.y)
    }
    fn operator==(o: Point) -> bool {
        return self.x == o.x && self.y == o.y;
    }
    fn step() -> Point {
        return self
    }
}
fn pick<T: Named>(xs: Array<Map<string, int>>, n: int) -> Pair<T, int>? {
    return null
}
fn main() {
