    if (q.x == 1) { return; }
    let n = TWICE(3)

    let t = "a,b  c"   // keep   this
    for (k in 0..2) {
        if (k == 1) { continue; }
        println("${k}")
        println(t)
    }
}
// declared functions' one-line bodies become blocks (their `;` kept); empty ones and lambdas' stay
class Verbs {
    fn get(url: string) -> string {
        return self.send("GET", url);
    }
    constructor() {}
    fn make() -> fn(int) -> int {
        return fn(v: int) -> int { return v * 2 };
    }
}
