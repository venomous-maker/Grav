// Default parameter values, named arguments, labeled break/continue, and
// literals passed to overloaded methods.
import "std"

namespace net { const PORT: int = 8080  fn address(host: string, port: int = PORT, tls: bool = false) -> string {
    return "${tls ? "https" : "http"}://${host}:${port}"
} }

class Counter { static calls: int = 0 }
fn next() -> int { Counter.calls += 1; return Counter.calls }
fn stamp(label: string, n: int = next()) -> string { return "${label}${n}" }

interface Logger { fn log(msg: string, level: int = 1) -> string }
class Console implements Logger {
    fn log(msg: string, level: int = 1) -> string { return "[${level}] ${msg}" }
}
class Size {
    public w: int
    public h: int
    constructor(w: int = 1, h: int = 2) { self.w = w; self.h = h }
    fn area(scale: int = 1) -> int { return self.w * self.h * scale }
    static fn square(side: int = 3) -> Size { return new Size(side, side) }
}
class Tall extends Size { }
fn label<T>(x: T, prefix: string = "item") -> string { return "${prefix}=${x}" }
// Overloads of different arities, told apart with the help of defaults.
class Conn {
    static fn open(a: int, name: string = "d") -> string { return "one ${a} " + name }
    static fn open(a: int, b: int, name: string = "d") -> string { return "two ${a} ${b} " + name }
    fn bind(a: int, name: string = "d") -> string { return "m1 ${a} " + name }
    fn bind(a: int, b: int, name: string = "d") -> string { return "m2 ${a} ${b} " + name }
}
class Pt {
    public s: string
    constructor(a: int, name: string = "d") { self.s = "c1 ${a} " + name }
    constructor(a: int, b: int, name: string = "d") { self.s = "c2 ${a} ${b} " + name }
}
fn kind(a: int, x: int = 1) -> string { return "int ${a} ${x}" }
fn kind(a: string, y: string = "y") -> string { return "str " + a + " " + y }
fn widen(a: long) -> string { return "long ${a}" }
fn widen(a: int, b: int = 0) -> string { return "int ${a} ${b}" }
fn many(xs: Array<int>, tag: string = "t") -> string { return "list ${xs.size()} " + tag }
fn many(n: int) -> string { return "one ${n}" }
class Sub { public n: int = 7 }
class Finder {
    fn whereIn(name: string, values: Array<any>) -> string { return name + " in ${values.size()}" }
    fn whereIn(name: string, sub: Sub) -> string { return name + " in sub ${sub.n}" }
    fn apply(f: fn(int) -> int) -> int { return f(2) }
    fn apply(f: fn(string) -> string, s: string) -> string { return f(s) }
}

test "defaults fill the arguments a call leaves out" {
    assertEq(net.address("example.org"), "http://example.org:8080")
    assertEq(net.address("h", 99), "http://h:99")
    assertEq(new Size().area(), 2)
    assertEq(Size.square().area(), 9)
    assertEq(new Tall().h, 2)
    assertEq(label(5), "item=5")
}

test "named arguments go to their parameter" {
    assertEq(net.address("h", tls: true), "https://h:8080")
    assertEq(net.address(port: 1, host: "x"), "http://x:1")
    assertEq(new Size(h: 5).area(scale: 2), 10)
    assertEq(label("s", prefix: "name"), "name=s")
    let l: Logger = new Console()
    assertEq(l.log("hi"), "[1] hi")
    assertEq(l.log("hi", level: 3), "[3] hi")
}

test "a default is evaluated at each call that needs it" {
    Counter.calls = 0
    assertEq(stamp("a"), "a1")
    assertEq(stamp("b"), "b2")
    assertEq(stamp("c", 10), "c10")
    assertEq(Counter.calls, 2)
}

test "labeled break and continue" {
    let seen = ""
    outer: for (i in 0..3) {
        for (j in 0..3) {
            if (j == 1) { continue outer }
            if (i == 2) { break outer }
            seen += "${i}${j} "
        }
    }
    assertEq(seen, "00 10 ")
    let words = new Array<string>()
    for (w in ["a", "bb", "ccc"]) { words.push(w) }
    let found = ""
    rows: for (w in words) {
        for (c in w) {
            if (c == "b") { continue rows }
            if (c == "c") { found = w; break rows }
        }
    }
    assertEq(found, "ccc")
    let n = 0
    spin: while (true) {
        n++
        do { if (n > 3) { break spin } } while (false)
    }
    assertEq(n, 4)
}

test "a literal argument takes the type of the one overload it fits" {
    let q = new Finder()
    assertEq(q.whereIn("a", ["x", "y"]), "a in 2")
    assertEq(q.whereIn("a", new Sub()), "a in sub 7")
    assertEq(q.apply(fn(x) => x * 10), 20)
    assertEq(q.apply(fn(x) => x + "!", "hi"), "hi!")
}

test "defaults let a call pick an overload of another arity" {
    assertEq(Conn.open(1), "one 1 d")
    assertEq(Conn.open(1, "x"), "one 1 x")
    assertEq(Conn.open(1, 2), "two 1 2 d")
    assertEq(Conn.open(1, 2, "y"), "two 1 2 y")
    let c = new Conn()
    assertEq(c.bind(1, 2), "m2 1 2 d")
    assertEq(c.bind(1, 2, name: "n"), "m2 1 2 n")
    assertEq(new Pt(1, 2).s, "c2 1 2 d")
    assertEq(new Pt(1, "z").s, "c1 1 z")
    // Types tell apart overloads that both fit by count.
    assertEq(kind(1), "int 1 1")
    assertEq(kind("s"), "str s y")
    // One that takes the arguments as they are wins over one that needs defaults.
    assertEq(widen(1), "long 1")
    assertEq(widen(1, 2), "int 1 2")
    // A literal takes its type from the overload it can go to.
    assertEq(many([1, 2]), "list 2 t")
    assertEq(many(3), "one 3")
}
