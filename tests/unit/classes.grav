// Constructors through a class hierarchy, the initial values of fields, async methods
// and private constructors.
import "std"

class Log { static text: string = "" }

class Base {
    public name: string
    constructor(name: string) { self.name = name; Log.text += "Base(${name}) " }
    constructor() { self.name = "anon"; Log.text += "Base() " }
}
class Inherits extends Base { }
class Grandchild extends Inherits { }
class Implicit extends Base {
    public tag: string
    constructor(tag: string) { self.tag = tag; Log.text += "Implicit(${tag}) " }
}
class Explicit extends Base {
    constructor(flag: bool) {
        if (flag) { super("yes") } else { super("no") }
    }
}

struct Inner { label: string  n: int }
class Defaults {
    public s: string
    public n: int
    public names: string[2]
    public inner: Inner
}
class MoreDefaults extends Defaults { public t: string }

test "a class without a constructor inherits its parent's" {
    Log.text = ""
    assertEq(new Inherits("a").name, "a")
    assertEq(new Inherits().name, "anon")
    assertEq(new Grandchild("g").name, "g")
    assertEq(Log.text, "Base(a) Base() Base(g) ")
}

test "a constructor without super(...) runs the parent's parameterless one first" {
    Log.text = ""
    let x = new Implicit("t")
    assertEq(x.name, "anon")
    assertEq(Log.text, "Base() Implicit(t) ")
}

test "super(...) inside a branch counts as the parent call" {
    Log.text = ""
    assertEq(new Explicit(false).name, "no")
    assertEq(Log.text, "Base(no) ")
}

test "string fields start empty" {
    let d = new MoreDefaults()
    assertEq(d.s, "")
    assertEq(d.t, "")
    assertEq(d.n, 0)
    assertEq(d.names[1], "")
    assertEq(d.inner.label, "")
    assertEq(d.s + "!", "!")
}

class Notes {
    public lines: Array<string> = new Array<string>()
}

class Fetcher {
    private base: int
    constructor(base: int) { self.base = base }
    async fn fetch(n: int) -> int {
        Async.sleepMs(5)
        return self.base + n
    }
    async fn note(log: Notes) { log.lines.push("noted") }
    static async fn twice(n: int) -> int { return n * 2 }
}

class Config {
    public name: string
    private constructor(name: string) { self.name = name }
    static fn defaults() -> Config { return new Config("default") }
}

test "async methods run on the worker pool" {
    let f = new Fetcher(100)
    let a = f.fetch(1)
    let b = f.fetch(2)
    assertEq(await a + await b, 203)
    let log = new Notes()
    await f.note(log)
    assertEq("${Str.join(log.lines, "")} ${await Fetcher.twice(21)}", "noted 42")
}

test "a private constructor is used through the class's own methods" {
    assertEq(Config.defaults().name, "default")
}
