// lib/json, bytes, thread, command, and net (TCP, HTTP, WebSocket over localhost).
import "std"
import "std/net"

test "number literals" {
    assertEq(0xff, 255)
    assertEq(0b1010, 10)
    assertEq(1_000_000, 1000000)
    assertEq(1e3, 1000.0)
}

test "json parse and query" {
    let doc = Json.parse("{\"a\": [1, 2.5, \"x\", true, null], \"b\": {\"c\": 9007199254740993}}")
    assertEq(doc["a"][0].asInt(), 1)
    assertEq(doc["a"][1].asFloat(), 2.5)
    assertEq(doc["a"][2].asString(), "x")
    assert(doc["a"][3].asBool())
    assert(doc["a"][4].isNull())
    assertEq(doc.path("b.c").asLong(), 9007199254740993)
    assert(doc["zzz"]["deeper"].isNull())
    assertEq(doc["a"].size(), 5)
}

test "json build, print, round trip" {
    let v = Json.object().set("name", "grav").set("n", 3 as long).set("ok", false)
    v["list"] = Json.array().push(1.5).push("s")
    assertEq(v.toJson(), "{\"name\":\"grav\",\"n\":3,\"ok\":false,\"list\":[1.5,\"s\"]}")
    assert(Json.parse(v.pretty()) == v)
    assertEq(Json.quote("a\"b\n"), "\"a\\\"b\\n\"")
    assertEq(Json.parse("\"\\u00e9\\ud83d\\ude00\"").asString(), "é😀")
}

test "json errors" {
    let msg = ""
    try { Json.parse("{\"a\": }") } catch (e: ValueError) { msg = e.message() }
    assertEq(msg, "JSON parse error at line 1, column 7: unexpected character")
    assert(Json.tryParse("[1,") == null)
}

test "bytes" {
    let b = new Bytes()
    b.appendByte(0x81).appendString("hi").appendUint(258, 2)
    assertEq(b.toHex(), "8168690102")
    assertEq(b.readUint(3, 2), 258)
    assertEq(b.slice(1, 3).toString(), "hi")
    assert(Bytes.fromHex("00ff") == Bytes.fromHex("00FF"))
}

test "threads and wait groups" {
    let total = new AtomicInt(0)
    let wg = new WaitGroup()
    for (i in 0..4) {
        wg.add(1)
        Thread.spawn(fn() { for (k in 0..500) { total.increment() }; wg.done() }).detach()
    }
    wg.wait()
    assertEq(total.get(), 2000)
    let t = Thread.spawn("failing", fn() { throw new ValueError("boom") })
    assertEq(t.joinResult(), "ValueError: boom")
}

test "command" {
    let r = new Command("sh").arg("-c").arg("echo out; echo err >&2; exit 3").run()
    assertEq(r.stdout, "out\n")
    assertEq(r.stderr, "err\n")
    assertEq(r.code, 3)
    assertEq(new Command("tr").arg("a-z").arg("A-Z").stdin("grav").output(), "GRAV")
    assert(new Command("sleep").arg("5").timeoutMs(50).run().timedOut)
    let failed = false
    try { new Command("no-such-program-xyz").run() } catch (e: IOError) { failed = true }
    assert(failed)
}

test "tcp echo" {
    let listener = TcpListener.bind("127.0.0.1", 0)
    let server = Thread.spawn(fn() {
        let c = listener.accept()
        c.lines(fn(line: string) { c.writeLine("<" + line + ">") })
        c.close()
    })
    let s = TcpStream.connect("127.0.0.1", listener.port())
    s.writeLine("one")
    s.writeLine("")
    assertEq(s.readLine(), "<one>")
    assertEq(s.readLine(), "<>")
    s.shutdownWrite()
    assertEq(s.readLine(), "")
    assert(s.eof())
    server.join()
    listener.close()
}

test "http server and client" {
    let app = new HttpServer()
    app.get("/users/:id", fn(req: HttpRequest) => HttpResponse.json(Json.object().set("id", req.param("id")).set("q", req.query("q"))))
    app.post("/echo", fn(req: HttpRequest) => HttpResponse.text(req.body()).withStatus(201))
    app.get("/fail", fn(req: HttpRequest) -> HttpResponse { throw new StateError("nope") })
    app.start(0)
    let base = "http://127.0.0.1:${app.port()}"
    let c = new HttpClient()
    assertEq(c.get(base + "/users/7?q=a%20b").body(), "{\"id\":\"7\",\"q\":\"a b\"}")
    let e = c.post(base + "/echo", "ping", "text/plain")
    assertEq(e.status, 201)
    assertEq(e.body(), "ping")
    assertEq(c.get(base + "/fail").status, 500)
    assertEq(c.get(base + "/missing").status, 404)
    assertEq(c.delete(base + "/echo").status, 405)
    app.stop()
}

test "websocket echo" {
    let app = new HttpServer()
    WebSocket.route(app, "/ws", fn(ws: WebSocket) {
        ws.messages(fn(m: WsMessage) { if (m.isText()) { ws.send(Str.upper(m.text())) } else { ws.sendBytes(m.data) } })
    })
    app.start(0)
    let ws = WebSocket.connect("ws://127.0.0.1:${app.port()}/ws")
    ws.send("hello")
    assertEq(ws.receive().text(), "HELLO")
    ws.sendBytes(Bytes.fromHex("0001ff"))
    assertEq(ws.receive().data.toHex(), "0001ff")
    let long = Str.repeat("ab", 40000)
    ws.send(long)
    assertEq(Str.length(ws.receive().text()), 80000)
    ws.close()
    assert(!ws.isOpen())
    app.stop()
}

test "url helpers" {
    let u = Url.parse("http://example.com:8080/a/b?x=1")
    assertEq(u.host, "example.com")
    assertEq(u.port, 8080)
    assertEq(u.path, "/a/b?x=1")
    assertEq(Url.encode("a b/é"), "a%20b%2F%C3%A9")
    assertEq(Url.parseQuery("a=1&b=x%20y").get("b"), "x y")
}
