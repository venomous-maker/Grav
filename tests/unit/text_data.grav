// Regular expressions, the newer Str helpers, encodings, hashes, UUIDs and CSV.
import "std"

test "regex: find, groups, replace, split" {
    let date = new Regex("([0-9]{4})-([0-9]{2})-([0-9]{2})")
    let m = date.find("due 2024-03-15!")
    assertEq(m.group(1), "2024")
    assertEq("${m.start} ${m.end} ${m.groupCount()}", "4 14 3")
    assertEq(date.replaceAll("2024-03-15 and 1999-12-31", "$3/$2/$1"), "15/03/2024 and 31/12/1999")
    assertEq(date.test("nope"), false)
    assertEq(str(new Regex("[0-9]+").findAllText("a1 b22 c333")), "[\"1\", \"22\", \"333\"]")
    assertEq(str(new Regex("\\s*,\\s*").split("a , b,c ,d")), "[\"a\", \"b\", \"c\", \"d\"]")
    assertEq(new Regex("^hello$", true).matches("HeLLo"), true)
    assertEq(new Regex("o").replace("foo", "0"), "f0o")
    assertEq(new Regex("[aeiou]").replaceAllWith("banana", fn(x: RegexMatch) => Str.upper(x.text)), "bAnAnA")
    assertEq(new Regex(Regex.escape("1+1")).test("is 1+1 two"), true)
    assertEq(new Regex("x*").findAll("ab").size(), 3)
    assertEq(new Regex("[0-9]").count("a1b2c3"), 3)
    assertEq(new Regex("(a)|(b)").find("b").group(1), "")
    let msg = ""
    try { new Regex("(unclosed") } catch (e: ValueError) { msg = e.message() }
    assertEq(Str.startsWith(msg, "bad regular expression '(unclosed'"), true)
}

test "Str: splitting, cases, wrapping, distance" {
    assertEq(Str.replaceFirst("a-b-c", "-", "+"), "a+b-c")
    assertEq(str(Str.splitN("a=b=c", "=", 2)), "[\"a\", \"b=c\"]")
    assertEq("${Str.before("user@host", "@")} ${Str.after("user@host", "@")}", "user host")
    assertEq(Str.truncate("héllo world", 6), "héllo…")
    assertEq(str(Str.wrap("the quick brown fox jumps over the lazy dog", 12)),
             "[\"the quick\", \"brown fox\", \"jumps over\", \"the lazy dog\"]")
    assertEq(Str.indent("a\nb", "> "), "> a\n> b")
    assertEq(Str.toSnakeCase("parseHTTPRequest"), "parse_http_request")
    assertEq(Str.toKebabCase("Parse HTTP request"), "parse-http-request")
    assertEq(Str.toCamelCase("parse_http_request"), "parseHttpRequest")
    assertEq(Str.toPascalCase("user-id"), "UserId")
    assertEq(Str.titleCase("the grav book"), "The Grav Book")
    assertEq(Str.levenshtein("kitten", "sitting"), 3)
    assertEq(Str.commonPrefix("interstellar", "internet"), "inter")
    assertEq(Str.containsIgnoreCase("Hello", "ELL"), true)
}

test "string literals survive C trigraphs" {
    let s = "??>> ??= ???! what??("
    assertEq(s.length, 21)
    assertEq(s, "??" + ">> ??" + "= ???! what??" + "(")
    assertEq(s[2], '>')
}

test "Base64, hex and UTF-8" {
    assertEq(Base64.encode("hello"), "aGVsbG8=")
    assertEq(Base64.decode("aGVsbG8"), "hello")
    assertEq(Base64.encodeUrl("??>>"), "Pz8-Pg")
    assertEq(Base64.decode(Base64.encodeUrl("??>>")), "??>>")
    assertEq(Base64.isValid("@@"), false)
    assertEq(Base64.decodeBytes("AAEC").toHex(), "000102")
    assertEq(Hex.encode("Hi"), "4869")
    assertEq(Hex.decode("4869"), "Hi")
    let failed = false
    try { Hex.decode("abc") } catch (e: ValueError) { failed = true }
    assertEq(failed, true)
    assertEq(Utf8.count("héllo"), 5)
    assertEq(str(Utf8.codePoints("a€")), "[97, 8364]")
    assertEq(Utf8.fromCodePoints([72, 233, 128512]), "Hé😀")
    assertEq(Utf8.reverse("añb"), "bña")
    assertEq(Utf8.slice("héllo", 1, 3), "él")
    assertEq(Utf8.isValid("\xff"), false)
}

test "hashes and UUIDs" {
    assertEq(Hash.sha256("abc"), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    assertEq(Hash.sha256(Str.repeat("b", 56)), Hash.sha256Bytes(Bytes.fromString(Str.repeat("b", 56))))
    assertEq(Hash.sha256(Str.repeat("a", 1000)), "41edece42d63e8d9bf515a9ba6932e1c20cbc9f5a5d134645adb5db1b9737ea3")
    assertEq(Hash.sha1("abc"), "a9993e364706816aba3e25717850c26c9cd0d89d")
    assertEq(Hash.md5("abc"), "900150983cd24fb0d6963f7d28e17f72")
    assertEq(Hash.md5(Str.repeat("x", 100)), "aed563ecafb4bcc5654c597a421547b2")
    assertEq(Hash.crc32("123456789"), 3421780262)
    assertEq(Hash.randomToken(16).length, 32)
    let u = Uuid.v4()
    assertEq(Uuid.isValid(u), true)
    assertEq(u[14], '4')
    assertEq(Uuid.v4() != u, true)
    assertEq(Uuid.isValid("not-a-uuid"), false)
}

test "CSV" {
    let text = "name,age,note\r\nada,36,\"likes \"\"math\"\", tea\"\nbob,,\"two\nlines\"\n"
    let rows = Csv.parse(text)
    assertEq(rows.size(), 3)
    assertEq(rows[1][2], "likes \"math\", tea")
    assertEq(rows[2][2], "two\nlines")
    let recs = Csv.parseRecords(text)
    assertEq(recs[1]["name"], "bob")
    assertEq(Csv.format(rows), "name,age,note\nada,36,\"likes \"\"math\"\", tea\"\nbob,,\"two\nlines\"\n")
    assertEq(str(Csv.parseWith("a\tb\n1\t2", "\t")), "[[\"a\", \"b\"], [\"1\", \"2\"]]")
    assertEq(str(Csv.parse("a,,b")), "[[\"a\", \"\", \"b\"]]")
    assertEq(Csv.formatRow(["plain", "a,b", "q\"t"]), "plain,\"a,b\",\"q\"\"t\"")
    let failed = false
    try { Csv.parse("\"open") } catch (e: ValueError) { failed = true }
    assertEq(failed, true)
}

test "big strings keep the string allocator working" {
    let sb = new StringBuilder()
    for (i in 0..1000000) { sb.append("word ") }
    let text = sb.toString()
    let back = Base64.decode(Base64.encode(text))
    let fresh = text[0..100]
    assertEq(%{ grav_shdr(back) != 0 && grav_shdr(fresh) != 0 %} as bool, true)
    assertEq(back.length, 5000000)
}

test "string length and indexing stay correct" {
    let s = "héllo" + " world"
    assertEq(s.length, 12)
    assertEq(s[11], 'd')
    let msg = ""
    try { print(s[12]) } catch (e: IndexError) { msg = e.message() }
    assertEq(msg, "string index 12 out of range (length 12)")
    let chars = new Array<string>()
    for (ch in "a\xffé") { chars.push(ch) }
    assertEq(chars.size(), 3)
    assertEq(chars[2], "é")
}

test "large inputs stay linear" {
    let sb = new StringBuilder()
    for (i in 0..300000) { sb.append("w").appendInt(i % 10).append(i % 7 == 0 ? "\n" : " ") }
    let text = sb.toString()
    let sw = new Stopwatch()
    assertEq(Str.split(text, " ").size() > 250000, true)
    assertEq(Str.words(text).size(), 300000)
    assertEq(Str.lines(text).size(), 42858)
    assertEq(new Regex("w[0-9]").count(text), 300000)
    assertEq(Utf8.count(text), text.length)
    let n = 0
    for (i in 0..text.length) { if (text[i] == '\n') { n += 1 } }
    assertEq(n, 42858)
    assertEq(Csv.parse(Str.repeat("a,\"b, c\",d\n", 30000)).size(), 30000)
    assertEq(sw.elapsedMs() < 5000, true, "took ${sw.elapsedMs()} ms")
}

test "sorting numbers and strings" {
    let xs: Array<int> = [5, -1, 3, 3, 0]
    Sort.sort(xs)
    assertEq(str(xs), "[-1, 0, 3, 3, 5]")
    Sort.sortDescending(xs)
    assertEq(str(xs), "[5, 3, 3, 0, -1]")
    let fs: Array<float> = [2.5, -1.0, 0.5]
    Sort.sort(fs)
    assertEq(str(fs), "[-1, 0.5, 2.5]")
    let ss: Array<string> = ["pear", "Apple", "fig"]
    Sort.sort(ss)
    assertEq(str(ss), "[\"Apple\", \"fig\", \"pear\"]")
    Sort.sortDescending(ss)
    assertEq(ss.first(), "pear")
}

test "JSON storage: replace, remove, large objects, shared children" {
    let doc = Json.parse("{\"n\": 42, \"f\": 2.5, \"big\": 9007199254740993, \"z\": null, \"arr\": [1, [2, {\"k\": \"v\"}], false, -0.5e2]}")
    assertEq(doc.toJson(), "{\"n\":42,\"f\":2.5,\"big\":9007199254740993,\"z\":null,\"arr\":[1,[2,{\"k\":\"v\"}],false,-50]}")
    assertEq(doc.getLong("big", 0), 9007199254740993)
    assertEq(doc.getFloat("n", 0.0), 42.0)
    assertEq(doc.path("arr.1.1.k").asString(), "v")
    doc.set("n", "replaced")
    assertEq(doc.remove("f"), true)
    assertEq(doc.remove("missing"), false)
    assertEq(str(doc.keys()), "[\"n\", \"big\", \"z\", \"arr\"]")
    let big = Json.object()
    for (i in 0..20) { big.set("k${i}", i as long) }
    big.set("k3", "three")
    big.remove("k0")
    assertEq("${big.size()} ${big["k3"].asString()} ${big["k19"].asInt()} ${big.has("k0")}", "19 three 19 false")
    let o = Json.object()
    o["x"] = Json.object().set("y", 1 as long)
    o["x"].set("y", 2 as long)
    assertEq(o.toJson(), "{\"x\":{\"y\":2}}")
    assertEq(Json.parse("{\"a\":1,\"b\":[true]}") == Json.parse("{\"b\":[true],\"a\":1}"), true)
    let loop = Json.array()
    loop.push(loop)
    assertEq(loop.size(), 1)
    assertEq(Json.parse("\"top\"").asString(), "top")
    let a = doc["arr"].asArray()
    a.push(Json.of(9 as long))
    assertEq(doc["arr"].size(), 4)
}

test "compression: gzip, zlib and raw deflate round trips and limits" {
    if (!Compress.available()) { return }
    let text = Str.repeat("compressible text ", 2000)
    let g = Compress.gzipText(text)
    assert(Compress.isGzip(g))
    assert(g.size() < text.length / 20)
    assertEq(Compress.gunzipText(g), text)
    let z = Compress.deflate(Bytes.fromString(text), 9)
    assert(Compress.isZlib(z))
    assertEq(Compress.inflate(z).size(), text.length)
    let r = Compress.deflateRaw(Bytes.fromString(text))
    assertEq(Compress.inflateRaw(r).toString(), text)
    for (packed in [g, z, r]) { assertEq(Compress.decompress(packed, 1000000).size(), text.length) }
    let all = new Bytes()
    for (i in 0..70000) { all.appendByte(i % 256) }        // every byte value, more than one buffer
    assertEq(Compress.gunzip(Compress.gzip(all, 0)).toHex(), all.toHex())
    assertEq(Compress.gunzip(Compress.gzip(new Bytes())).size(), 0)
    let bomb = false
    try { Compress.decompress(Compress.gzipText(Str.repeat("a", 500000)), 1000) } catch (e: ValueError) { bomb = true }
    assert(bomb)
    let corrupt = false
    try { Compress.gunzip(Bytes.fromString("definitely not gzip")) } catch (e: ValueError) { corrupt = true }
    assert(corrupt)
    let short = false
    try { Compress.gunzip(g.slice(0, g.size() / 2)) } catch (e: ValueError) { short = true }
    assert(short)
    let badLevel = false
    try { Compress.gzip(all, 12) } catch (e: ValueError) { badLevel = true }
    assert(badLevel)
}

test "interpolation formats numbers and long pieces exactly" {
    let min: long = -9223372036854775807 - 1
    let big: ulong = (9223372036854775807 as ulong) * 2 + 1   // the largest ulong
    assertEq("a${min}b", "a-9223372036854775808b")
    assertEq("${big}", "18446744073709551615")
    assertEq("${0}|${-7}|100%|${3}%", "0|-7|100%|3%")
    let long1 = Str.repeat("x", 700)
    let s = "[${long1}:${long1.length}:${long1}]"
    assertEq(s.length, 700 * 2 + 3 + 3 + 1)
    assert(Str.startsWith(s, "[xxx") && Str.endsWith(s, "xxx]"))
    assertEq(str(-12345), "-12345")
}

test "hash maps: equal strings find each other, removals keep probes intact" {
    let m = new HashMap<string, int>()
    for (i in 0..20000) { m.put("k${i}", i) }
    let probe = "k" + "123"                                // same text, a different string
    assertEq(m.get(probe), 123)
    for (i in 0..20000) { if (i % 3 == 0) { m.remove("k${i}") } }
    let found = 0
    for (i in 0..20000) { if (m.containsKey("k${i}")) { found += 1; assertEq(m.get("k${i}"), i) } }
    assertEq(found, 20000 - 6667)
    assertEq(m.size(), found)
    m.put("k0", -1)
    assertEq(m.get("k0"), -1)
    let ints = new HashMap<long, string>()
    for (i in 0..5000) { ints.put((i as long) * 1000003, "v${i}") }
    assertEq(ints.get((4999 as long) * 1000003), "v4999")
}

test "JSON: repeated record keys, escaped keys and prefixes parse exactly" {
    let text = "[{\"id\":1,\"name\":\"a\"},{\"idx\":2,\"nam\":\"b\"},{\"id\":3,\"name\":\"c\"},{\"i\\\"d\":4},{\"i\\\"d\":5},{\"id\":9223372036854775807,\"n\":-0,\"f\":2.5e1}]"
    let v = Json.parse(text)
    assertEq(v.toJson(), "[{\"id\":1,\"name\":\"a\"},{\"idx\":2,\"nam\":\"b\"},{\"id\":3,\"name\":\"c\"},{\"i\\\"d\":4},{\"i\\\"d\":5},{\"id\":9223372036854775807,\"n\":0,\"f\":25}]")
    assertEq(v[1]["idx"].asInt(), 2)
    assertEq(v[4]["i\"d"].asInt(), 5)
    assertEq(Json.object().set("q", "a\"b\n").set("n", -5 as long).toJson(), "{\"q\":\"a\\\"b\\n\",\"n\":-5}")
}
