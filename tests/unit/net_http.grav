// HTTP: methods, OPTIONS and CORS, conditional and range requests, streaming,
// uploads, cookies, auth, redirects, limits, keep-alive and HTTPS (local only).
import "std"
import "std/net"

fn app() -> HttpServer {
    let s = new HttpServer()
    s.get("/hello", fn(req: HttpRequest) => HttpResponse.text("hello " + req.query("name")))
    s.post("/echo", fn(req: HttpRequest) => HttpResponse.text(req.body()).header("X-Method", req.method))
    s.put("/echo", fn(req: HttpRequest) => HttpResponse.text("put " + req.body()))
    s.patch("/echo", fn(req: HttpRequest) => HttpResponse.text("patch " + req.body()))
    s.delete("/items/:id", fn(req: HttpRequest) => HttpResponse.text("deleted ${req.paramInt("id", -1)}"))
    s.get("/doc", fn(req: HttpRequest) => HttpResponse.text("0123456789").etag("v1"))
    s.get("/events", fn(req: HttpRequest) => HttpResponse.eventStream(fn(ev: EventStream) {
        for (i in 0..3) { ev.send("tick", "n=${i}") }
    }))
    s.get("/stream", fn(req: HttpRequest) => HttpResponse.stream("text/plain", fn(w: ResponseWriter) {
        for (i in 0..1000) { w.write("line ${i}\n") }
    }))
    s.post("/upload", fn(req: HttpRequest) -> HttpResponse {
        let f = req.file("doc")
        return HttpResponse.json(Json.object()
            .set("title", req.formValue("title"))
            .set("file", f == null ? "" : f.filename)
            .set("size", (f == null ? 0 : f.size()) as long)
            .set("type", f == null ? "" : f.contentType))
    })
    s.post("/login", fn(req: HttpRequest) => HttpResponse.text("ok").setCookie(new Cookie("sid", "s3cret").maxAge(60)))
    s.get("/whoami", fn(req: HttpRequest) => HttpResponse.text("sid=" + req.cookie("sid")))
    s.get("/private", fn(req: HttpRequest) -> HttpResponse {
        let cred = req.basicAuth()
        if (cred == null || cred.get(0) != "ada" || cred.get(1) != "pw") { return HttpResponse.unauthorized("test") }
        return HttpResponse.text("welcome " + cred.get(0))
    })
    s.get("/token", fn(req: HttpRequest) => HttpResponse.text("token=" + req.bearerToken()))
    s.post("/moved", fn(req: HttpRequest) => HttpResponse.redirect("/echo", 307))
    s.get("/old", fn(req: HttpRequest) => HttpResponse.redirect("/hello?name=redirected", 301))
    s.get("/info", fn(req: HttpRequest) => HttpResponse.json(Json.object()
        .set("secure", req.isSecure()).set("ip", req.ip()).set("tags", Str.join(req.queryAll("tag"), ","))
        .set("json", req.accepts("application/json")).set("agent", Str.startsWith(req.userAgent(), "grav-http"))))
    s.get("/boom", fn(req: HttpRequest) -> HttpResponse { throw new StateError("kaput") })
    s.onError(fn(req: HttpRequest, why: string) => HttpResponse.error(500, "custom: " + why))
    s.onNotFound(fn(req: HttpRequest) => HttpResponse.error(404, "nothing at " + req.path))
    return s
}

test "every method, and OPTIONS answered from the routes" {
    let s = app().start(0)
    let c = new HttpClient()
    let base = s.baseUrl()
    assertEq(c.get(base + "/hello?name=ada").body(), "hello ada")
    let posted = c.post(base + "/echo", "data", "text/plain")
    assertEq(posted.body(), "data")
    assertEq(posted.getHeader("X-Method"), "POST")
    assertEq(c.put(base + "/echo", "x", "text/plain").body(), "put x")
    assertEq(c.patch(base + "/echo", "y", "text/plain").body(), "patch y")
    assertEq(c.delete(base + "/items/7").body(), "deleted 7")
    let head = c.head(base + "/hello")
    assertEq(head.status, 200)
    assertEq(head.body(), "")
    assertEq(head.getHeader("Content-Length"), "6")
    let opts = c.options(base + "/echo")
    assertEq(opts.status, 204)
    assertEq(opts.getHeader("Allow"), "POST, PUT, PATCH, OPTIONS")
    let wrong = c.get(base + "/echo")
    assertEq(wrong.status, 405)
    assertEq(wrong.getHeader("Allow"), "POST, PUT, PATCH, OPTIONS")
    assertEq(c.get(base + "/nope").json()["error"].asString(), "nothing at /nope")
    assertEq(c.get(base + "/boom").json()["error"].asString(), "custom: StateError: kaput")
    assert(c.get(base + "/hello").getHeader("Date") != "")
    c.close()
    s.stop()
}

test "CORS: preflight and response headers" {
    let s = app()
    s.cors(Cors.allowOrigins(["https://app.example"]).allowCredentials(true).exposeHeaderNames("X-Method"))
    s.start(0)
    let c = new HttpClient()
    let pre = new Headers()
    pre.set("Origin", "https://app.example").set("Access-Control-Request-Method", "PUT")
       .set("Access-Control-Request-Headers", "Content-Type, X-Token")
    let p = c.send("OPTIONS", s.baseUrl() + "/echo", null, "", pre)
    assertEq(p.status, 204)
    assertEq(p.getHeader("Access-Control-Allow-Origin"), "https://app.example")
    assertEq(p.getHeader("Access-Control-Allow-Headers"), "Content-Type, X-Token")
    assertEq(p.getHeader("Access-Control-Allow-Credentials"), "true")
    assert(Str.contains(p.getHeader("Access-Control-Allow-Methods"), "PUT"))
    let simple = new Headers()
    simple.set("Origin", "https://app.example")
    let r = c.send("POST", s.baseUrl() + "/echo", Bytes.fromString("hi"), "text/plain", simple)
    assertEq(r.getHeader("Access-Control-Allow-Origin"), "https://app.example")
    assertEq(r.getHeader("Access-Control-Expose-Headers"), "X-Method")
    assertEq(r.getHeader("Vary"), "Origin")
    let other = new Headers()
    other.set("Origin", "https://evil.example")
    assertEq(c.send("GET", s.baseUrl() + "/hello", null, "", other).getHeader("Access-Control-Allow-Origin"), "")
    c.close()
    s.stop()
}

test "ETags answer 304, and byte ranges 206 or 416" {
    let s = app().start(0)
    let c = new HttpClient()
    let first = c.get(s.baseUrl() + "/doc")
    assertEq(first.getHeader("ETag"), "\"v1\"")
    let h = new Headers()
    h.set("If-None-Match", "\"v1\"")
    let again = c.send("GET", s.baseUrl() + "/doc", null, "", h)
    assertEq(again.status, 304)
    assertEq(again.body(), "")
    let r = new Headers()
    r.set("Range", "bytes=2-5")
    let part = c.send("GET", s.baseUrl() + "/doc", null, "", r)
    assertEq(part.status, 206)
    assertEq(part.body(), "2345")
    assertEq(part.getHeader("Content-Range"), "bytes 2-5/10")
    r.set("Range", "bytes=-3")
    assertEq(c.send("GET", s.baseUrl() + "/doc", null, "", r).body(), "789")
    r.set("Range", "bytes=50-")
    assertEq(c.send("GET", s.baseUrl() + "/doc", null, "", r).status, 416)
    c.close()
    s.stop()
}

test "streamed bodies and server-sent events" {
    let s = app().start(0)
    let c = new HttpClient()
    let ev = c.get(s.baseUrl() + "/events")
    assertEq(ev.mediaType(), "text/event-stream")
    assertEq(ev.getHeader("Transfer-Encoding"), "chunked")
    assertEq(ev.body(), "event: tick\ndata: n=0\n\nevent: tick\ndata: n=1\n\nevent: tick\ndata: n=2\n\n")
    let big = c.get(s.baseUrl() + "/stream")
    assertEq(Str.split(Str.trim(big.body()), "\n").size(), 1000)
    assertEq(c.get(s.baseUrl() + "/hello?name=after").body(), "hello after")   // the connection stays usable
    c.close()
    s.stop()
}

test "multipart uploads and form fields" {
    let s = app().start(0)
    let c = new HttpClient()
    let data = new Bytes()
    for (i in 0..256) { data.appendByte(i) }               // every byte value, including CR and LF
    let form = new FormData().add("title", "a report").addFile("doc", "data.bin", "application/octet-stream", data)
    let r = c.postForm(s.baseUrl() + "/upload", form).json()
    assertEq(r["title"].asString(), "a report")
    assertEq(r["file"].asString(), "data.bin")
    assertEq(r["size"].asInt(), 256)
    assertEq(r["type"].asString(), "application/octet-stream")
    let parts = FormData.parse(form.contentType(), form.body())
    assertEq(parts.size(), 2)
    assertEq(parts.get(1).data.get(13), 13)
    let fields = new HashMap<string, string>()
    fields["title"] = "plain form"
    assertEq(c.postForm(s.baseUrl() + "/upload", fields).json()["title"].asString(), "plain form")
    c.close()
    s.stop()
}

test "cookies, credentials, redirects and request details" {
    let s = app().start(0)
    let c = new HttpClient().useCookies(true)
    let login = c.post(s.baseUrl() + "/login", "", "")
    assertEq(login.cookies().get(0).maxAgeSeconds, 60)
    assertEq(c.get(s.baseUrl() + "/whoami").body(), "sid=s3cret")
    assertEq(c.get(s.baseUrl() + "/private").status, 401)
    let withUrl = Url.parse(s.baseUrl()); withUrl.user = "ada"; withUrl.password = "pw"
    assertEq(c.get(withUrl.toString() + "private").body(), "welcome ada")
    assertEq(new HttpClient().setBasicAuth("ada", "pw").get(s.baseUrl() + "/private").body(), "welcome ada")
    assertEq(new HttpClient().setBearerToken("t0k").get(s.baseUrl() + "/token").body(), "token=t0k")
    let moved = c.post(s.baseUrl() + "/moved", "kept", "text/plain")
    assertEq(moved.body(), "kept")                         // 307 repeats the POST with its body
    assertEq(c.get(s.baseUrl() + "/old").body(), "hello redirected")
    let info = c.get(s.baseUrl() + "/info?tag=a&tag=b").json()
    assertEq(info["secure"].asBool(), false)
    assertEq(info["ip"].asString(), "127.0.0.1")
    assertEq(info["tags"].asString(), "a,b")
    assert(info["json"].asBool())
    assert(info["agent"].asBool())
    c.close()
    s.stop()
}

test "keep-alive reuses connections across requests and threads" {
    let s = app().start(0)
    let c = new HttpClient()
    for (i in 0..50) { assertEq(c.get(s.baseUrl() + "/hello?name=${i}").body(), "hello ${i}") }
    assertEq(c.idleConnections(), 1)
    let done = new AtomicInt(0)
    let workers = new Array<Thread>()
    for (t in 0..4) {
        workers.push(Thread.spawn(fn() {
            for (i in 0..25) { if (c.get(s.baseUrl() + "/hello?name=t").ok()) { done.increment() } }
        }))
    }
    for (w in workers) { w.join() }
    assertEq(done.get(), 100)
    assert(c.idleConnections() <= 4)
    assert(s.requestsServed() >= 150)
    c.close()
    assertEq(c.idleConnections(), 0)
    s.stop()
}

test "connections: idle ones, pipelining, idle timeouts, streams and upgrades" {
    let s = app()
    s.workers = 2
    WebSocket.route(s, "/ws", fn(ws: WebSocket) { ws.messages(fn(m: WsMessage) { ws.send("echo " + m.text()) }) })
    s.start(0)
    // Idle connections cost no thread: 200 of them, and requests still go through.
    let idle = new Array<TcpStream>()
    for (i in 0..200) { idle.push(TcpStream.connect("127.0.0.1", s.port())) }
    let waited = 0
    while (s.activeConnections() < 200 && waited < 2000) { Time.sleepMs(10); waited += 10 }
    assertEq(s.activeConnections(), 200)
    let c = new HttpClient()
    for (i in 0..20) { assertEq(c.get(s.baseUrl() + "/hello?name=${i}").body(), "hello ${i}") }
    for (t in idle) { t.close() }
    waited = 0
    while (s.activeConnections() > 1 && waited < 2000) { Time.sleepMs(10); waited += 10 }
    assertEq(s.activeConnections(), 1)                    // the client's kept-alive one
    // Pipelined requests in one write are all answered, in order.
    let raw = TcpStream.connect("127.0.0.1", s.port())
    raw.write("GET /hello?name=a HTTP/1.1\r\nHost: x\r\n\r\nGET /hello?name=b HTTP/1.1\r\nHost: x\r\n\r\n" +
              "GET /hello?name=c HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")
    let all = raw.readAll()
    raw.close()
    assertEq(Str.count(all, "HTTP/1.1 200"), 3)
    assert(Str.indexOf(all, "hello a") < Str.indexOf(all, "hello b") && Str.indexOf(all, "hello b") < Str.indexOf(all, "hello c"))
    // A request pipelined behind a streamed response is answered after it.
    let behind = TcpStream.connect("127.0.0.1", s.port())
    behind.write("GET /stream HTTP/1.1\r\nHost: x\r\n\r\nGET /hello?name=next HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")
    let streamed = behind.readAll()
    behind.close()
    assert(Str.contains(streamed, "line 999\n") && Str.endsWith(streamed, "hello next"))
    // A streamed response runs off the loops, and the connection is kept after it.
    assertEq(Str.count(c.get(s.baseUrl() + "/stream").body(), "\n"), 1000)
    assertEq(c.get(s.baseUrl() + "/hello?name=after").body(), "hello after")
    assertEq(c.idleConnections(), 1)
    // Upgraded connections get their own threads: more WebSockets than loops.
    let sockets = new Array<WebSocket>()
    for (i in 0..4) { sockets.push(WebSocket.connect("ws://127.0.0.1:${s.port()}/ws", 5000)) }
    for (i in 0..4) { sockets[i].send("m${i}") }
    for (i in 0..4) { assertEq(sockets[i].receive().text(), "echo m${i}") }
    assertEq(c.get(s.baseUrl() + "/hello?name=ws").body(), "hello ws")
    for (ws in sockets) { ws.close() }
    c.close()
    s.stop()
    // Connections left idle past idleTimeoutMs are closed by the server.
    let quick = app()
    quick.idleTimeoutMs = 300
    quick.start(0)
    let sleeper = TcpStream.connect("127.0.0.1", quick.port())
    Time.sleepMs(900)
    assertEq(sleeper.read(100), "")
    assert(sleeper.eof())
    assertEq(quick.activeConnections(), 0)
    sleeper.close()
    quick.stop()
    // A handler may stop its own server.
    let own = app()
    own.post("/quit", fn(req: HttpRequest) -> HttpResponse { own.stop(); return HttpResponse.text("bye") })
    own.start(0)
    assertEq(new HttpClient().post(own.baseUrl() + "/quit", "", "text/plain").body(), "bye")
    own.stop()
    assertEq(own.activeConnections(), 0)
}

test "slow clients never hold up a loop" {
    let s = app()
    s.workers = 2
    s.headerTimeoutMs = 400
    s.start(0)
    let c = new HttpClient()
    // Half-sent requests hold up no loop: with more of them than loops, others are still served.
    let slow = new Array<TcpStream>()
    for (i in 0..6) {
        let t = TcpStream.connect("127.0.0.1", s.port())
        t.write("GET /hello?name=slow${i} HTTP/1.1\r\nHo")
        slow.push(t)
    }
    Time.sleepMs(50)
    let t0 = Time.monotonicMs()
    for (i in 0..10) { assertEq(c.get(s.baseUrl() + "/hello?name=${i}").body(), "hello ${i}") }
    assert(Time.monotonicMs() - t0 < 300)
    // One finishes its request and is answered.
    slow[0].write("st: x\r\nConnection: close\r\n\r\n")
    assert(Str.contains(slow[0].readAll(), "hello slow0"))
    // The rest run out of time: 408, then closed.
    let late = slow[1].readAll()
    assert(Str.startsWith(late, "HTTP/1.1 408"))
    for (t in slow) { t.close() }
    // A head sent a few bytes at a time, within the limit, is served.
    let trickle = TcpStream.connect("127.0.0.1", s.port())
    let head = "GET /hello?name=drip HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n"
    let i = 0
    while (i < head.length) {
        trickle.write(head[i..Math.min(i + 8, head.length)])
        Time.sleepMs(15)
        i += 8
    }
    assert(Str.contains(trickle.readAll(), "hello drip"))
    trickle.close()
    // Bodies arriving in pieces: Content-Length, chunked, and Expect: 100-continue.
    let piece = TcpStream.connect("127.0.0.1", s.port())
    piece.write("POST /echo HTTP/1.1\r\nHost: x\r\nContent-Length: 11\r\n\r\nhello")
    Time.sleepMs(50)
    piece.write(" world")
    assertEq(piece.readLine(), "HTTP/1.1 200 OK")
    piece.write("POST /echo HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n5\r\nchu")
    Time.sleepMs(50)
    piece.write("nk\r\n6\r\ned!!!!\r\n0\r\n\r\n")
    let both = piece.readAll()
    assert(Str.contains(both, "hello world") && Str.contains(both, "chunked!!!!"))
    piece.close()
    let ask = TcpStream.connect("127.0.0.1", s.port())
    ask.write("POST /echo HTTP/1.1\r\nHost: x\r\nExpect: 100-continue\r\nContent-Length: 4\r\nConnection: close\r\n\r\n")
    assertEq(ask.readLine(), "HTTP/1.1 100 Continue")
    assertEq(ask.readLine(), "")
    ask.write("ping")
    let answer = ask.readAll()
    assert(Str.startsWith(answer, "HTTP/1.1 200") && Str.endsWith(answer, "ping"))
    assertEq(Str.count(answer, "100 Continue"), 0)        // sent once
    ask.close()
    // A big body (many reads) still arrives whole.
    let big = Str.repeat("0123456789", 50000)
    assertEq(c.post(s.baseUrl() + "/echo", big, "text/plain").body().length, 500000)
    c.close()
    s.stop()
    // https: a client that stalls in the handshake holds up no loop either.
    if (!Tls.available()) { return }
    let ctx = TlsContext.selfSigned("localhost")
    let secure = app()
    secure.workers = 2
    secure.headerTimeoutMs = 400
    secure.startTls(0, ctx)
    let stalled = new Array<TcpStream>()
    for (k in 0..4) {
        let t = TcpStream.connect("127.0.0.1", secure.port())
        t.write("\u{16}\u{3}\u{1}")                          // the start of a ClientHello, then nothing
        stalled.push(t)
    }
    Time.sleepMs(50)
    let tc = new HttpClient().withTls(TlsContext.client().trustPem(ctx.certificatePem()))
    for (k in 0..5) { assertEq(tc.get("https://localhost:${secure.port()}/hello?name=k${k}").body(), "hello k${k}") }
    assertEq(stalled[0].read(100), "")                     // closed once headerTimeoutMs passed
    for (t in stalled) { t.close() }
    tc.close()
    secure.stop()
}

test "event loops: long handlers, slow readers and floods of pipelined requests" {
    let s = new HttpServer()
    s.workers = 2
    s.get("/hello", fn(req: HttpRequest) => HttpResponse.text("hello"))
    s.get("/sleep", fn(req: HttpRequest) -> HttpResponse { Time.sleepMs(600); return HttpResponse.text("slept") })
    s.get("/big", fn(req: HttpRequest) => HttpResponse.text(Str.repeat("x", 2000000)))
    s.get("/mid", fn(req: HttpRequest) => HttpResponse.text(Str.repeat("y", 60000)))
    s.start(0)
    let url = s.baseUrl()
    let quick = fn() -> long {                            // ms for 5 requests on new connections
        let t0 = Time.monotonicMs()
        for (i in 0..5) {
            let c = new HttpClient()
            assertEq(c.get(url + "/hello").body(), "hello")
            c.close()
        }
        return Time.monotonicMs() - t0
    }
    // A handler that blocks holds up its own loop only: new connections go to the other.
    let slept = new Array<string>()
    let sleeper = Thread.spawn(fn() { slept.push(new HttpClient().get(url + "/sleep").body()) })
    Time.sleepMs(150)
    assert(quick() < 300)
    sleeper.join()
    assertEq(slept[0], "slept")
    // A big response to a client that reads slowly is written off the loop; the
    // connection is kept for its next request.
    let slow = TcpStream.connect("127.0.0.1", s.port())
    slow.write("GET /big HTTP/1.1\r\nHost: x\r\n\r\n")
    Time.sleepMs(100)
    assert(quick() < 300)
    assertEq(slow.readLine(), "HTTP/1.1 200 OK")
    let length = 0
    let line = slow.readLine()
    while (line != "") {
        if (Str.startsWith(Str.lower(line), "content-length:")) { length = Format.toIntOr(Str.trim(line[15..]), -1) }
        line = slow.readLine()
    }
    assertEq(length, 2000000)
    assertEq(slow.readExactly(length).size(), 2000000)
    slow.write("GET /hello HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")
    assert(Str.endsWith(slow.readAll(), "hello"))
    slow.close()
    // 100 pipelined requests whose answers fill the socket before the client reads:
    // the rest are written from another thread, then the loop answers the others.
    let flood = TcpStream.connect("127.0.0.1", s.port())
    flood.write(Str.repeat("GET /mid HTTP/1.1\r\nHost: x\r\n\r\n", 100) + "GET /hello HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")
    Time.sleepMs(100)
    assert(quick() < 300)
    let all = flood.readAll()
    flood.close()
    assertEq(Str.count(all, "HTTP/1.1 200 OK"), 101)
    assert(Str.endsWith(all, "hello"))
    assert(s.requestsServed() >= 117)
    s.stop()
    assertEq(s.activeConnections(), 0)
}

test "unusual requests: case, spacing, folding and bad lines" {
    let s = new HttpServer()
    s.any("/show/*", fn(req: HttpRequest) -> HttpResponse {
        let sb = new StringBuilder()
        sb.append(req.method + " " + req.path)
        for (i in 0..req.headers.size()) { sb.append(" [" + req.headers.nameAt(i) + "]=[" + req.headers.valueAt(i) + "]") }
        sb.append(" keep=${req.keepAlive()}")
        return HttpResponse.text(sb.toString())
    })
    s.start(0)
    let ask = fn(raw: string) -> string {                   // the status line and body
        let t = TcpStream.connect("127.0.0.1", s.port())
        t.write(raw)
        t.shutdownWrite()
        let all = t.readAll()
        t.close()
        let cut = Str.indexOf(all, "\r\n\r\n")
        return all[..Str.indexOf(all, "\r\n")] + " | " + all[cut + 4..]
    }
    assertEq(ask("get /show/%41%2Fb HTTP/1.1\r\nHost: x\r\n\r\n"), "HTTP/1.1 200 OK | GET /show/A/b [Host]=[x] keep=true")
    assertEq(ask("GET /show/a HTTP/1.1\r\nHost: x\r\nX-A :  spaced value \r\nX-T:\ttabbed\t\r\n\r\n"),
             "HTTP/1.1 200 OK | GET /show/a [Host]=[x] [X-A]=[spaced value] [X-T]=[tabbed] keep=true")
    assertEq(ask("\r\n\nGET /show/a HTTP/1.1\nHost: x\n\n"), "HTTP/1.1 200 OK | GET /show/a [Host]=[x] keep=true")
    assertEq(ask("GET /show/a HTTP/1.1\r\nHost: x\r\nConnection: foo,  CLOSE \r\n\r\n"),
             "HTTP/1.1 200 OK | GET /show/a [Host]=[x] [Connection]=[foo,  CLOSE] keep=false")
    assertEq(ask("GET /show/a HTTP/1.1\r\nHost: x\r\nX-Fold: a\r\n  continued\r\n\r\n"), "HTTP/1.1 400 Bad Request | malformed header line:   continued")
    assertEq(ask("GET /show/a HTTP/1.1\r\nHost: x\r\nBad Name: v\r\n\r\n"), "HTTP/1.1 400 Bad Request | not a valid header name: 'Bad Name'")
    assertEq(ask("GET  /show/a HTTP/1.1\r\nHost: x\r\n\r\n"), "HTTP/1.1 400 Bad Request | malformed request line: GET  /show/a HTTP/1.1")
    assertEq(ask("GET /show/a HTTP/2.0\r\nHost: x\r\n\r\n"), "HTTP/1.1 400 Bad Request | malformed request line: GET /show/a HTTP/2.0")
    assertEq(ask("GET /show/a HTTP/1.1\r\n\r\n"), "HTTP/1.1 400 Bad Request | an HTTP/1.1 request needs a Host header")
    assertEq(ask("GET /show/a HTTP/1.1\r\nHost: x\r\n" + Str.repeat("X-Many: 1\r\n", 201) + "\r\n"), "HTTP/1.1 400 Bad Request | too many headers")
    s.stop()
}

test "limits: big bodies, long headers, too many connections" {
    let s = app()
    s.maxBodyBytes = 1000
    s.start(0)
    let c = new HttpClient()
    assertEq(c.post(s.baseUrl() + "/echo", Str.repeat("x", 5000), "text/plain").status, 413)
    let h = new Headers()
    h.set("X-Huge", Str.repeat("y", 40000))
    assertEq(c.send("GET", s.baseUrl() + "/hello", null, "", h).status, 431)
    let bad = false
    try { h.set("X-Bad", "a\r\nInjected: yes") } catch (e: ValueError) { bad = true }
    assert(bad)                                            // no header smuggling
    c.close()
    s.stop()
    let tiny = app()
    tiny.maxConnections = 1
    tiny.start(0)
    let hold = TcpStream.connect("127.0.0.1", tiny.port())   // occupies the only slot
    Time.sleepMs(50)
    let refused = new HttpClient().get(tiny.baseUrl() + "/hello")
    assertEq(refused.status, 503)
    hold.close()
    tiny.stop()
}

test "HTTPS and wss with a self-signed certificate" {
    if (!Tls.available()) { return }
    let ctx = TlsContext.selfSigned("localhost")
    let s = app()
    WebSocket.route(s, "/ws", fn(ws: WebSocket) { ws.messages(fn(m: WsMessage) { ws.send("echo " + m.text()) }) })
    s.startTls(0, ctx)
    assert(s.isTls())
    let trust = TlsContext.client().trustPem(ctx.certificatePem())
    let c = new HttpClient().withTls(trust)
    let url = "https://localhost:${s.port()}"
    assertEq(c.get(url + "/hello?name=tls").body(), "hello tls")
    assertEq(c.get(url + "/info").json()["secure"].asBool(), true)
    for (i in 0..20) { assertEq(c.post(url + "/echo", "n${i}", "text/plain").body(), "n${i}") }
    assertEq(c.idleConnections(), 1)
    let refused = false
    try { new HttpClient().get(url + "/hello") } catch (e: NetError) { refused = Str.contains(e.message(), "self-signed") }
    assert(refused)                                        // the default client checks certificates
    let ws = WebSocket.connect("wss://localhost:${s.port()}/ws", 5000, trust)
    ws.send("over tls")
    assertEq(ws.receive().text(), "echo over tls")
    ws.close()
    c.close()
    s.stop()
}

test "gzip responses for clients that ask, decoded by the client" {
    if (!Compress.available()) { return }
    let s = new HttpServer()
    let doc = Str.repeat("a fairly repetitive document ", 400)
    s.get("/doc", fn(req: HttpRequest) => HttpResponse.text(doc).etag("v7"))
    s.get("/small", fn(req: HttpRequest) => HttpResponse.text("tiny"))
    s.get("/image", fn(req: HttpRequest) => HttpResponse.bytes("image/png", Bytes.fromString(doc)))
    s.compress(true).start(0)
    let c = new HttpClient()
    let r = c.get(s.baseUrl() + "/doc")
    assert(r.wasCompressed)
    assertEq(r.body(), doc)
    assertEq(r.getHeader("Content-Encoding"), "")            // decoded: the header is gone
    assertEq(r.getHeader("ETag"), "W/\"v7\"")
    assertEq(r.getHeader("Vary"), "Accept-Encoding")
    assert(!c.get(s.baseUrl() + "/small").wasCompressed)     // below the size threshold
    assert(!c.get(s.baseUrl() + "/image").wasCompressed)     // already compressed formats are left alone
    let raw = new HttpClient()
    raw.decompress = false
    assertEq(raw.get(s.baseUrl() + "/doc").bodyBytes.size(), doc.length)   // no Accept-Encoding: plain
    let h = new Headers()
    h.set("Accept-Encoding", "gzip")
    let packed = raw.send("GET", s.baseUrl() + "/doc", null, "", h)
    assertEq(packed.getHeader("Content-Encoding"), "gzip")
    assert(packed.bodyBytes.size() * 10 < doc.length)
    assertEq(Compress.gunzipText(packed.bodyBytes), doc)
    h.set("Accept-Encoding", "gzip;q=0, identity")
    assertEq(raw.send("GET", s.baseUrl() + "/doc", null, "", h).getHeader("Content-Encoding"), "")
    h.set("Accept-Encoding", "gzip")
    h.set("If-None-Match", "W/\"v7\"")
    assertEq(raw.send("GET", s.baseUrl() + "/doc", null, "", h).status, 304)
    let rg = new Headers()
    rg.set("Accept-Encoding", "gzip")
    rg.set("Range", "bytes=2-6")
    let part = raw.send("GET", s.baseUrl() + "/doc", null, "", rg)
    assertEq(part.status, 206)
    assertEq(part.body(), "fairl")                           // ranges count the plain bytes
    c.close()
    raw.close()
    s.stop()
}

test "URLs: parts, building and resolving links" {
    let u = Url.parse("https://ada:p%40ss@Example.com:8443/docs/guide/intro.html?q=a+b&n=1#top")
    assertEq(u.scheme, "https")
    assertEq(u.host, "example.com")
    assertEq(u.port, 8443)
    assertEq(u.user, "ada")
    assertEq(u.password, "p@ss")
    assertEq(u.pathOnly(), "/docs/guide/intro.html")
    assertEq(u.query(), "q=a+b&n=1")
    assertEq(u.queryValue("q"), "a b")
    assertEq(u.fragment, "top")
    assertEq(u.origin(), "https://example.com:8443")
    assertEq(u.resolve("../img/logo.png").toString(), "https://ada:p%40ss@example.com:8443/docs/img/logo.png")
    assertEq(u.resolve("/abs").path, "/abs")
    assertEq(u.resolve("?page=2").path, "/docs/guide/intro.html?page=2")
    assertEq(u.resolve("//cdn.example.com/x.js").toString(), "https://cdn.example.com/x.js")
    assertEq(u.resolve("http://other.example/").host, "other.example")
    assertEq(Url.parse("http://[::1]:8080/x").hostHeader(), "[::1]:8080")
    assertEq(Url.parse("http://h/a").withParam("k", "v w").path, "/a?k=v%20w")
    assertEq(Url.encodePath("/a b/c+d"), "/a%20b/c%2Bd")
    assertEq(Url.decodePath("/a%20b+c"), "/a b+c")
    assert(Url.isValid("ws://x/y"))
    assert(!Url.isValid("not a url"))
    assertEq(Url.parseQueryAll("t=1&t=2&u=3").get("t").size(), 2)
}
