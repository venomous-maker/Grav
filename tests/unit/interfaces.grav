// Interfaces at run time (is / as in every direction) and the element type
// of array literals and `?:` taken from context.
import "std"

interface Shape { fn area() -> float }
interface Named { fn name() -> string }
class Square implements Shape, Named {
    fn area() -> float { return 4.0 }
    fn name() -> string { return "square" }
}
class Circle implements Shape { fn area() -> float { return 3.0 } }
class Animal { fn speak() -> string { return "..." } }
class Dog extends Animal implements Named {
    fn speak() -> string { return "woof" }
    fn name() -> string { return "dog" }
}
class Cat extends Animal { fn speak() -> string { return "meow" } }

fn total(xs: Shape[3]) -> float { let t = 0.0  for (x in xs) { t += x.area() } return t }
fn pick(square: bool) -> Shape { return square ? new Square() : new Circle() }

test "an interface value converts to another interface its object implements" {
    let s: Shape = new Square()
    assertEq(s is Named, true)
    assertEq((s as Named).name(), "square")
    let c: Shape = new Circle()
    assertEq(c is Named, false)
    let msg = ""
    try { print((c as Named).name()) } catch (e: TypeError) { msg = e.message() }
    assertEq(msg, "a Circle does not implement Named")
}

test "an interface value converts to its object's class" {
    let s: Shape = new Square()
    assertEq(s is Square, true)
    assertEq(s is Circle, false)
    assertEq((s as Square).name(), "square")
    let msg = ""
    try { print((s as Circle).area()) } catch (e: TypeError) { msg = e.message() }
    assertEq(msg, "cannot cast a Square to Circle")
}

test "a class value converts to an interface a subclass implements" {
    let pet: Animal = new Dog()
    assertEq(pet is Named, true)
    assertEq((pet as Named).name(), "dog")
    let cat: Animal = new Cat()
    assertEq(cat is Named, false)
}

test "any values convert to interfaces" {
    let box: any = new Square()
    assertEq(box is Named, true)
    assertEq((box as Named).name(), "square")
    let none: Shape = null
    assertEq(none is Named, false)
    assertEq((none as Named) == null, true)
}

test "array literals and ?: take their type from context" {
    let shapes: Shape[3] = [new Square(), new Circle(), new Square()]
    assertEq(total(shapes), 11.0)
    assertEq(total([new Circle(), new Circle(), new Square()]), 10.0)
    assertEq(pick(false).area(), 3.0)
    let grid: Shape[2][2] = [[new Square(), new Circle()], [new Circle(), new Square()]]
    assertEq(grid[1][0].area(), 3.0)
}

test "sibling classes unify to their common base" {
    let pets = [new Dog(), new Cat()]
    assertEq(pets[0].speak() + pets[1].speak(), "woofmeow")
    let one = pets.length > 1 ? new Cat() : new Dog()
    assertEq(one.speak(), "meow")
}

// Generic instances in an interface's own signatures and default bodies.
interface Store {
    fn get(key: string) -> string?
    fn keys() -> Array<string>
    fn getMany(keys: Array<string>) -> Array<string?> {
        let out = new Array<string?>()
        for (k in keys) { out.push(self.get(k)) }
        return out
    }
    fn dump(into: HashMap<string, string>) { for (k in self.keys()) { into.put(k, self.get(k) ?? "") } }
    fn boxed() -> Pair<string, int> { return new Pair<string, int>("store", self.keys().size()) }
}
class MapStore implements Store {
    private m: HashMap<string, string> = new HashMap<string, string>()
    constructor() { self.m.put("a", "1"); self.m.put("b", "2") }
    fn get(key: string) -> string? { return self.m.containsKey(key) ? self.m[key] : null }
    fn keys() -> Array<string> { return self.m.keys() }
}
class BatchStore implements Store {
    fn get(key: string) -> string? { return "one:" + key }
    fn keys() -> Array<string> { return ["x"] }
    fn getMany(keys: Array<string>) -> Array<string?> {
        let out = new Array<string?>()
        for (k in keys) { out.push("batch:" + k) }
        return out
    }
}

test "interface signatures and default bodies can name generic instances" {
    let s: Store = new MapStore()
    let got = s.getMany(["a", "zz", "b"])
    assertEq("${got.size()} ${got[0]} ${got[1] == null} ${got[2]}", "3 1 true 2")
    let into = new HashMap<string, string>()
    s.dump(into)
    assertEq("${into.size()} ${into["b"]}", "2 2")
    assertEq("${s.boxed().first} ${s.boxed().second}", "store 2")
    let b: Store = new BatchStore()
    assertEq("${b.getMany(["q"])[0]} ${b.boxed().second}", "batch:q 1")
}

interface Made { fn label() -> string }
interface Maker { fn make(n: int) -> Made }
class Widget implements Made {
    public n: int
    constructor(n: int) { self.n = n }
    fn label() -> string { return "widget ${self.n}" }
}
class WidgetMaker implements Maker {
    fn make(n: int) -> Widget { return new Widget(n) }   // narrower than Made
}
class Base { fn name() -> string { return "base" } }
class Derived extends Base { fn name() -> string { return "derived" } }
interface BaseSource { fn get() -> Base }
class DerivedSource implements BaseSource { fn get() -> Derived { return new Derived() } }

test "an implementation may give a narrower type than its interface" {
    let maker: Maker = new WidgetMaker()
    assertEq(maker.make(2).label(), "widget 2")
    assertEq(new WidgetMaker().make(3).n, 3)                // the class's own type, with its fields
    let src: BaseSource = new DerivedSource()
    assertEq(src.get().name(), "derived")
}

interface KVStore {
    fn put<T>(key: string, value: T) -> string
    fn first<T>(xs: Array<T>) -> T
}
class MemoryStore implements KVStore {
    fn put<T>(key: string, value: T) -> string { return "${key}=${value}" }
    fn first<T>(xs: Array<T>) -> T { return xs[0] }
}
class LoudStore implements KVStore {
    fn put<T>(key: string, value: T) -> string { return Str.upper("${key}=${value}") }
    fn first<T>(xs: Array<T>) -> T { return xs[xs.size() - 1] }
}
interface Naming { fn name() -> string }
class Kitten implements Naming { fn name() -> string { return "cat" } }
trait Welcomer {
    fn prefix() -> string
    fn greet<T: Naming>(x: T) -> string { return self.prefix() + " " + x.name() }
}
class Gentle implements Welcomer { fn prefix() -> string { return "hello" } }
class Blunt implements Welcomer {
    fn prefix() -> string { return "oi" }
    fn greet<T: Naming>(x: T) -> string { return "OI " + Str.upper(x.name()) }
}
interface Wrapping { fn wrap<T>(x: T) -> string }
class BaseWrapper { fn wrap<T>(x: T) -> string { return "[${x}]" } }
class SubWrapper extends BaseWrapper implements Wrapping { }
class FancyWrapper extends BaseWrapper implements Wrapping { fn wrap<T>(x: T) -> string { return "<${x}>" } }
fn wrapAny<T>(w: Wrapping, x: T) -> string { return w.wrap(x) }
interface ListMapper<A> { fn mapAll<B>(xs: Array<A>, f: fn(A) -> B) -> Array<B> }
class IntMapper implements ListMapper<int> {
    fn mapAll<B>(xs: Array<int>, f: fn(int) -> B) -> Array<B> {
        let out = new Array<B>()
        for (x in xs) { out.push(f(x)) }
        return out
    }
}

test "generic methods called through an interface reach each class's own copy" {
    let stores: Array<KVStore> = [new MemoryStore(), new LoudStore()]
    let got = new Array<string>()
    let names: Array<string> = ["a", "b"]
    for (s in stores) {
        got.push("${s.put("n", 1)} ${s.put::<string>("w", "x")} ${s.put("f", 2.5)} ${s.first(names)} ${s.first::<int>([7, 8])}")
    }
    assertEq(Str.join(got, " | "), "n=1 w=x f=2.5 a 7 | N=1 W=X F=2.5 b 8")
}

test "trait defaults, inherited and overridden implementations, generic callers, generic interfaces" {
    let gs: Array<Welcomer> = [new Gentle(), new Blunt()]
    assertEq("${gs[0].greet(new Kitten())} / ${gs[1].greet(new Kitten())}", "hello cat / OI CAT")
    let ws: Array<Wrapping> = [new SubWrapper(), new FancyWrapper()]
    assertEq("${ws[0].wrap(1)} ${ws[1].wrap("s")} ${wrapAny(ws[0], 2.5)} ${wrapAny(ws[1], true)}", "[1] <s> [2.5] <true>")
    let base: BaseWrapper = new FancyWrapper()
    assertEq(base.wrap(9), "<9>")
    let m: ListMapper<int> = new IntMapper()
    let xs: Array<int> = [1, 2, 3]
    assertEq("${m.mapAll(xs, fn(x: int) -> string { return "#${x}" })} ${m.mapAll(xs, fn(x: int) -> int { return x * x })}",
             "[\"#1\", \"#2\", \"#3\"] [1, 4, 9]")
}
