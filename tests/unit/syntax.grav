// Literal and declaration syntax: raw and multi-line strings, character
// literals, collection literals, local functions, lambdas that call themselves, case bodies, if and try as values, generic local functions, constant array lengths, tuples of four.
import "std"

class Bag {
    public items: Array<int>
    constructor() { self.items = new Array<int>() }
    fn add(x: int) { self.items.push(x * 10) }
}

test "raw strings keep backslashes and dollar signs" {
    assertEq(r"C:\temp\new", "C:\\temp\\new")
    assertEq(r"${x}", "\${x}")
    assertEq(r"a\nb".length, 4)
}

test "multi-line strings drop the shared indentation" {
    let name = "grav"
    let text = """
        hello ${name}
          indented
        "quotes" stay
        """
    assertEq(text, "hello grav\n  indented\n\"quotes\" stay")
    let one = """inline "q" ok"""
    assertEq(one, "inline \"q\" ok")
    let raw = r"""
        \d+ ${not}
        """
    assertEq(raw, "\\d+ \${not}")
}

test "character literals are their code points" {
    assertEq('a', 97)
    assertEq('\n', 10)
    assertEq('\'', 39)
    assertEq('é', 233)
    assertEq('\u{1F600}', 128512)
    let s = "cab"
    assertEq(s[0] == 'c', true)
    let n = 0
    for (i in 0..s.length) { if (s[i] >= 'a' && s[i] <= 'b') { n += 1 } }
    assertEq(n, 2)
}

test "collection literals build the expected type" {
    let xs: Array<int> = [3, 1, 2]
    assertEq(str(xs), "[3, 1, 2]")
    let names: HashSet<string> = ["a", "b", "a"]
    assertEq(names.size(), 2)
    let bag: Bag = [1, 2]
    assertEq(str(bag.items), "[10, 20]")
    let ages = {"ann": 31, "bob": 27}
    assertEq(ages.get("bob"), 27)
    assertEq(ages.size(), 2)
}

test "functions declared inside a block" {
    let base = 100
    fn add(a: int, b: int) -> int { return a + b + base }
    assertEq(add(1, 2), 103)
    fn fib(n: int) -> int { return n < 2 ? n : fib(n - 1) + fib(n - 2) }
    assertEq(fib(20), 6765)
    fn shout(s: string) { print(s + "!") }
    shout("local")
}

test "lambdas that call themselves" {
    let fact = fn(n: int) -> long { return n <= 1 ? 1 as long : n * fact(n - 1) }
    assertEq(fact(20), 2432902008176640000 as long)
    let walk: fn(int) -> int = null
    walk = fn(n: int) -> int { return n == 0 ? 0 : 1 + walk(n - 1) }
    assertEq(walk(5), 5)
}

interface KwMatcher { fn match(s: string) -> bool }
class KwRule implements KwMatcher {
    public type: string = "rule"
    public float: double = 1.5
    public static default: string = "d"
    fn match(s: string) -> bool { return s == self.type }
    static fn in(values: Array<string>) -> string { return "in:" + Str.join(values, ",") }
    static fn fn(x: int) -> int { return x * 2 }
    fn string(key: string) -> string { return key + "!" }
    fn is(other: string) -> bool { return other == self.type }
    fn for<T>(x: T) -> string { return "for " + str(x) }
    fn return() -> int { return 7 }
}

test "keywords as member names: methods, fields, static members, after . and ?." {
    let r = new KwRule()
    assertEq("${r.type} ${r.float} ${KwRule.default}", "rule 1.5 d")
    assertEq(r.match("rule"), true)
    assertEq(KwRule.in(["a", "b"]), "in:a,b")
    assertEq(KwRule.fn(21), 42)
    assertEq(r.string("k") + r.for::<int>(3) + "${r.return()}", "k!for 37")
    assertEq(r.is("rule"), true)
    let m: KwMatcher = r
    r.type = "changed"
    assertEq("${m.match("changed")} ${r?.type}", "true changed")
}

fn caseBodies(x: int) -> string {
    let out = ""
    switch (x) {
        case 1: out += "a"; out += "b"
        case 2:
            out += "c"
            out += "d"
        case 3: { out += "e" } out += "f"
        default: out = "z"; return out + "?"
    }
    return out
}

test "a case runs the statements up to the next case, without braces" {
    assertEq("${caseBodies(1)} ${caseBodies(2)} ${caseBodies(3)} ${caseBodies(4)}", "ab cd ef z?")
    let n = 0
    for (i in 0..10) {
        switch (i % 3) {
            case 0: continue
            case 1: n += 1; if (i > 6) { break }
            default: n += 10
        }
    }
    assertEq(n, 23)
}

fn sign(n: int) -> string { return if (n < 0) "minus" else if (n == 0) "zero" else "plus" }

test "if and try give values" {
    let big = 7
    let label = if (big > 5) {
        let t = big * 2
        "big ${t}"
    } else "small"
    assertEq("${label} ${sign(-3)} ${sign(0)} ${sign(4)}", "big 14 minus zero plus")
    let n = try Format.toInt("12") catch 0
    let m = try Format.toInt("q") catch -1
    let why = try "${Format.toInt("q")}" catch (e: ValueError) { "bad: " + e.message() }
    assertEq("${n} ${m} ${why}", "12 -1 bad: 'q' is not an integer")
    let tries = 0
    let v = try { tries += 1; Format.toInt("z") } catch { tries += 10; 5 }
    assertEq("${v} ${tries}", "5 11")
}

fn describe(type: string, match: int) -> string { return "${type}:${match}" }

test "type, match, trait, export and uses name variables" {
    let type = "user"
    let match = 3
    type = type + "s"
    match += 1
    let uses: Array<string> = [type, "x"]
    let seen = ""
    for (i, export in uses) { seen += "${i}${export} " }
    let trait = fn(type: string) => Str.upper(type)
    let r = match (match) { case 4: "four" default: "other" }
    assertEq(seen + describe(type, match) + " " + trait("t") + " " + r, "0users 1x users:4 T four")
}

test "generic local functions" {
    fn twice<T>(x: T) -> Array<T> { return [x, x] }
    fn depth<T>(x: T, n: int) -> int { return n == 0 ? 0 : 1 + depth(x, n - 1) }
    let words = ""
    if (true) {
        fn wrap<T>(x: T) -> string { return "[${x}]" }
        words = wrap(1) + wrap("b")
    }
    assertEq("${twice(3).size()} ${twice("a")[1]} ${depth(1.5, 4)} ${words}", "2 a 4 [1][b]")
    let twice = 9
    assertEq(twice, 9)
}

const CELLS: int = 4
class Board { public cells: int[CELLS * 2] }

test "fixed array lengths may be constant expressions" {
    const HALF = CELLS / 2
    let a: int[HALF + 1] = [1, 2, 3]
    let b = new Board()
    assertEq("${a[2]} ${b.cells.length}", "3 8")
}

fn stats(xs: Array<int>) -> (int, int, int, float) {
    let lo = xs[0]
    let hi = xs[0]
    let sum = 0
    for (x in xs) { lo = Math.min(lo, x); hi = Math.max(hi, x); sum += x }
    return (lo, hi, sum, double(sum) / xs.size())
}

test "tuples of four" {
    let s = stats([3, 1, 4, 1, 5])
    let (lo, hi, sum, mean) = s
    assertEq("${lo} ${hi} ${sum} ${mean} ${s.fourth}", "1 5 14 2.8 2.8")
    assertEq(s.toString(), "(1, 5, 14, 2.8)")
    assert(s == (1, 5, 14, 2.8))
}
