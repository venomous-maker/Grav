// Automatic reference counting: objects are freed with their last reference.
import "std"

class Tracked {
    public n: int
    public next: Tracked
    constructor(n: int) { self.n = n; self.next = null; Live.count += 1 }
    destructor() { Live.count -= 1 }
}
class Live { static count: int = 0 }

fn build(n: int) -> Tracked {
    let head: Tracked = null
    for (i in 0..n) { let t = new Tracked(i); t.next = head; head = t }
    return head
}

test "locals and temporaries are freed at once" {
    if (true) {
        let a = new Tracked(1)
        let b = new Tracked(2)
        a.next = b
    }
    new Tracked(3)
    assertEq(Live.count, 0)
}

test "reassignment frees the old object" {
    let x = new Tracked(1)
    x = new Tracked(2)
    assertEq(Live.count, 1)
}

test "a long chain is freed without deep recursion" {
    if (true) { let head = build(200000); assertEq(head.n, 199999) }
    assertEq(Live.count, 0)
}

test "containers hold their elements" {
    if (true) {
        let xs = new Array<Tracked>()
        for (i in 0..100) { xs.push(new Tracked(i)) }
        xs.removeAt(0)
        xs.pop()
        assertEq(Live.count, 98)
        let m = new HashMap<int, Tracked>()
        m.put(1, new Tracked(1))
        m.put(1, new Tracked(2))
        assertEq(Live.count, 99)
    }
    assertEq(Live.count, 0)
}

test "closures keep what they capture" {
    let f: fn() -> int = null
    if (true) {
        let t = new Tracked(7)
        f = fn() -> int { return t.n }
    }
    assertEq(Live.count, 1)
    assertEq(f(), 7)
    f = null
    assertEq(Live.count, 0)
}

test "free runs the destructor now, other references stay safe" {
    let a = new Tracked(5)
    let alias = a
    free(a)
    assertEq(Live.count, 0)
    assertEq(alias.n, 5)
}

class TreeNode {
    public name: string
    public children: Array<TreeNode>
    public weak parent: TreeNode           // back-reference: does not keep the parent alive
    constructor(name: string) {
        self.name = name; self.children = new Array<TreeNode>(); self.parent = null; Live.count += 1
    }
    destructor() { Live.count -= 1 }
    fn add(c: TreeNode) -> TreeNode { c.parent = self; self.children.push(c); return c }
}

test "weak back-references let a parent and its children go" {
    if (true) {
        let root = new TreeNode("root")
        let kid = root.add(new TreeNode("kid"))
        kid.add(new TreeNode("grandkid"))
        assertEq(kid.parent.name, "root")
        assertEq(Live.count, 3)
    }
    assertEq(Live.count, 0)
}

test "a weak reference reads null once its object is gone" {
    let kid = new TreeNode("kid")
    if (true) {
        let root = new TreeNode("root")
        root.add(kid)
        assert(kid.parent != null)
    }
    assert(kid.parent == null)
    assertEq(Live.count, 1)
    let other = new TreeNode("other")
    kid.parent = other
    free(other)                            // disposed: weak references see null too
    assert(kid.parent == null)
}

test "string += keeps building correctly" {
    let s = ""
    for (i in 0..1000) { s += "${i % 10}" }
    assertEq(Str.length(s), 1000)
    let n = new TreeNode("a")
    for (i in 0..3) { n.name += "!" }
    assertEq(n.name, "a!!!")
}

class Oops extends Exception {
    constructor(m: string) { super(m); Live.count += 1 }
    destructor() { Live.count -= 1 }
}

test "thrown exceptions are freed once handled" {
    for (i in 0..100) {
        try { throw new Oops("boom") } catch (e: Oops) {}
        try { try { throw new Oops("inner") } catch (e: Oops) { throw e } } catch (e: Oops) {}
    }
    assertEq(Live.count, 0)
}

test "finally keeps the pending exception" {
    let seen = ""
    try {
        try { throw new Oops("first") } finally { try { throw new Oops("second") } catch (x: Oops) {} }
    } catch (e: Oops) { seen = e.message() }
    assertEq(seen, "first")
    assertEq(Live.count, 0)
}

struct Slot { item: Tracked  label: string }

test "value structs and fixed arrays own their references" {
    if (true) {
        let a = Slot { item: new Tracked(1), label: "one" }
        let b = a
        b.item = new Tracked(2)
        let pair: Tracked[2] = [new Tracked(3), new Tracked(4)]
        pair[0] = new Tracked(5)
        let xs = new Array<Slot>()
        for (i in 0..10) { xs.push(Slot { item: new Tracked(i), label: "s${i}" }) }
        assertEq(Live.count, 14)
        assertEq(a.item.n + b.item.n + pair[0].n, 8)
    }
    assertEq(Live.count, 0)
}

test "the cycle collector frees unreachable cycles" {
    GC.collect()
    if (true) {
        let a = new Tracked(1)
        let b = new Tracked(2)
        a.next = b
        b.next = a                         // a cycle, no weak side
        let c = new Tracked(3)
        c.next = c                         // a self-reference
    }
    assertEq(Live.count, 3)
    let keep = new Tracked(4)
    keep.next = new Tracked(5)
    keep.next.next = keep                  // a cycle still in use
    assert(GC.collect() >= 3)
    assertEq(Live.count, 2)
    assertEq(keep.next.n, 5)
}

// Exceptions free the locals of every frame they leave, not only the frame
// with the `try`. unwindDepth is the runtime's count of registered locals.
fn unwindDepth() -> int { return %{ grav_uw_top %} as int }

fn descend(n: int) -> int {
    let mine = new Tracked(n)
    let label = "frame ${n}"
    if (n == 0) { throw new Oops("bottom") }
    return descend(n - 1) + mine.n + label.length
}

fn scan(items: Array<Tracked>, stop: int) -> int {
    let total = 0
    for (it in items) {
        let extra = new Tracked(-1)
        if (it.n == stop) { throw new Oops("stop") }
        if (it.n % 2 == 0) { continue }
        total += it.n + extra.n
    }
    return total
}

class HalfBuilt {
    public part: Tracked
    constructor(fail: bool) {
        self.part = new Tracked(0)
        if (fail) { throw new Oops("half") }
    }
    destructor() { HalfBuilt.destroyed += 1 }
    static destroyed: int = 0
}

test "an exception frees the locals of every frame it leaves" {
    let base = Live.count
    let depth = unwindDepth()
    for (i in 0..50) {
        try { descend(6) } catch (e: Oops) {}
    }
    assertEq(Live.count, base)
    assertEq(unwindDepth(), depth)
}

test "loop variables and early exits keep unwinding balanced" {
    let base = Live.count
    let items = new Array<Tracked>()
    for (i in 0..6) { items.push(new Tracked(i)) }
    let depth = unwindDepth()             // items itself is registered
    for (round in 0..20) {
        try { scan(items, 4) } catch (e: Oops) {}
        assertEq(scan(items, 99), 1 + 3 + 5 - 3)
        for (it in items) {
            let probe = new Tracked(it.n)
            if (probe.n == 1) { continue }
            try {
                if (it.n == 3) { throw new Oops("caught in loop") }
            } catch (e: Oops) { continue }
            if (it.n == 5) { break }
        }
    }
    assertEq(Live.count, base + 6)
    assertEq(unwindDepth(), depth)
}

test "a constructor that throws frees its half-built object" {
    let base = Live.count
    for (i in 0..10) {
        try { let h = new HalfBuilt(true); print(h.part.n) } catch (e: Oops) {}
    }
    assertEq(Live.count, base)
    assertEq(HalfBuilt.destroyed, 0)      // the destructor of an unbuilt object never runs
    if (true) { let ok = new HalfBuilt(false); assertEq(ok.part.n, 0) }
    assertEq(HalfBuilt.destroyed, 1)
}

test "finally and rethrow free the frames they leave" {
    let base = Live.count
    let depth = unwindDepth()
    for (i in 0..20) {
        try {
            let outer = new Tracked(1)
            try { descend(3) } finally { let during = new Tracked(2); assertEq(during.n, 2) }
            print(outer.n)
        } catch (e: Oops) {}
    }
    if (true) {
        let failure = Panic.recover(fn() { let held = new Tracked(7); descend(held.n - 5) })
        assert(Str.contains(failure, "bottom"))
    }
    assertEq(Live.count, base)
    assertEq(unwindDepth(), depth)
}

// Faults raise too: a scope with no calls left but an index, a division or a
// field read through a reference still frees its locals when they fire.
fn pick(i: int) -> int {
    let held = new Tracked(1)
    let label = "pick ${i}"
    let xs: int[3] = [1, 2, 3]
    return xs[i] + held.n + label.length
}
fn share(total: int, parts: int) -> int {
    let held = new Tracked(2)
    return total / parts + held.n
}
fn second(t: Tracked) -> int {
    let held = new Tracked(3)
    return t.next.n + held.n
}
fn viaClosure(i: int) -> int {
    let k = new Tracked(4)
    let add = fn(x: int) -> int { return x + k.n }
    let xs: int[2] = [add(1), 2]
    return xs[i]
}

test "faults free the locals of the frames they leave" {
    let base = Live.count
    let depth = unwindDepth()
    for (i in 0..20) {
        try { pick(9) } catch (e: IndexError) {}
        try { share(10, 0) } catch (e: ArithmeticError) {}
        try { viaClosure(3) } catch (e: IndexError) {}
    }
    assertEq(pick(1), 2 + 1 + 6)
    assertEq(Live.count, base)
    assertEq(unwindDepth(), depth)
}

test "a recovered panic frees the locals of the frames it leaves" {
    let base = Live.count
    let depth = unwindDepth()
    for (i in 0..20) {
        let failure = Panic.recover(fn() { print(second(new Tracked(0))) })
        assert(Str.contains(failure, "null reference"))
    }
    assertEq(Live.count, base)
    assertEq(unwindDepth(), depth)
}

fn residentKb() -> long {
    return %{ ({ long grav_p = 0, grav_r = 0; FILE* grav_f = fopen("/proc/self/statm", "r");
                 if (grav_f) { if (fscanf(grav_f, "%ld %ld", &grav_p, &grav_r) != 2) grav_r = 0; fclose(grav_f); }
                 (long long)grav_r * 4; }) %} as long
}
fn churn(n: int) {
    for (i in 0..n) {
        Thread.spawn(fn() {
            let held = new Tracked(i)
            try { descend(1) } catch (e: Oops) {}                 // unwinds through registered locals
            assertEq(held.n, i)
        }).join()
    }
}

test "threads that end give their unwind registry back" {
    churn(200)                                             // warm up allocator caches
    let before = residentKb()
    churn(2000)                                            // each thread registered locals
    let grew = residentKb() - before
    assert(grew < 2048)                                    // was 4 KiB per thread
}
